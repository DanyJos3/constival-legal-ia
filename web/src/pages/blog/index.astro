---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

// Lógica para obtener posts y ordenarlos por fecha de publicación descendente
const allPosts = await getCollection("blog");

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog y Recursos Societarios | Constival Legal"
  description="Aprende sobre estructuras empresariales, creación de SAS, registro de marcas y cómo blindar jurídicamente tu startup en Ecuador."
  canonicalUrl="https://constival.com/blog"
>
  <Navbar />

  <main class="min-h-screen bg-white dark:bg-constival-navy pt-24 pb-16 sm:pt-32 sm:pb-24 transition-colors duration-300">
    <div class="w-full mx-auto px-6 sm:px-8 md:px-12 lg:px-16 max-w-7xl relative z-10">
      
      <!-- Encabezado del Hub de Contenidos -->
      <div class="text-center md:text-left mb-16 md:mb-20 max-w-3xl">
        <span class="inline-block py-1.5 px-3 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-xs sm:text-sm mb-4 border-l-4 border-constival-teal dark:border-constival-mint">
          Centro de Recursos
        </span>
        <h1 class="font-sans text-4xl sm:text-5xl lg:text-6xl font-extrabold text-constival-navy dark:text-white tracking-tighter leading-tight mb-6">
          Inteligencia Legal para <span class="text-constival-mint">Emprendedores y CEOs.</span>
        </h1>
        <p class="font-sans text-base sm:text-lg lg:text-xl text-constival-navy/70 dark:text-slate-400 leading-relaxed max-w-2xl">
          Descubre guías, análisis corporativos y alertas operativas para que tu empresa en Ecuador nazca blindada y crezca sin trabas tributarias u operativas.
        </p>
      </div>

      <!-- Cuadrícula de Artículos -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
        {sortedPosts.map((post) => (
          <article class="bg-white dark:bg-constival-deep/50 border border-constival-navy/5 dark:border-white/5 overflow-hidden group hover:border-constival-mint/30 dark:hover:border-constival-mint/30 transition-all duration-300 flex flex-col h-full shadow-sm hover:shadow-xl">
            <div class="h-48 sm:h-64 w-full overflow-hidden shrink-0 relative bg-constival-navy flex items-center justify-center p-6 text-center">
              <img 
                src={post.data.image || '/images/default-blog-bg.png'} 
                alt=""
                class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 opacity-60 mix-blend-luminosity" 
              />
              <div class="absolute inset-0 bg-gradient-to-tr from-constival-navy/95 via-constival-navy/80 to-constival-teal/40 mix-blend-multiply transition-opacity group-hover:opacity-90"></div>
              
              <h2 class="relative z-10 font-sans text-xl sm:text-2xl font-black text-white leading-tight drop-shadow-md group-hover:text-constival-mint transition-colors">
                <a href={`/blog/${post.id}`} class="focus:outline-none">
                  <span class="absolute inset-0" aria-hidden="true"></span>
                  {post.data.title}
                </a>
              </h2>
            </div>
            
            <div class="p-6 md:p-8 flex flex-col flex-grow">
              <div class="flex items-center gap-3 mb-4 flex-wrap">
                <span class="font-sans text-xs font-bold uppercase tracking-wider text-constival-teal dark:text-slate-500">
                  {post.data.pubDate.toLocaleDateString("es-EC", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </span>
                {post.data.tags && post.data.tags.length > 0 && (
                  <>
                    <span class="w-1 h-1 rounded-full bg-constival-mint/50"></span>
                    <span class="font-sans text-[10px] sm:text-xs font-bold uppercase tracking-widest text-constival-blue dark:text-constival-mint bg-constival-blue/5 dark:bg-constival-mint/10 px-2 py-1">
                      {post.data.tags[0]}
                    </span>
                  </>
                )}
              </div>
              
              <p class="font-sans text-sm sm:text-base text-constival-navy/60 dark:text-slate-400 leading-relaxed mb-6 flex-grow line-clamp-3">
                {post.data.description}
              </p>
              
              <div class="pt-4 mt-auto border-t border-constival-navy/10 dark:border-white/10 flex items-center justify-between">
                <span class="font-sans text-sm font-bold text-constival-navy dark:text-white">
                  {post.data.author}
                </span>
                <span class="flex items-center text-constival-teal dark:text-constival-mint text-sm font-bold uppercase tracking-widest group-hover:translate-x-1 transition-transform duration-300">
                  Leer →
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
      
    </div>
  </main>

  <Footer />
</Layout>
