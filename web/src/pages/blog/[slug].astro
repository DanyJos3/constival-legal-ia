---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

// Generar rutas estáticas en build-time para cada archivo Markdown
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const hasSidebar = post.data.relatedService !== "none";

// Schema para Google SEO (Para que la IA lo detecte como respuesta estructurada)
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://constival.com/blog/${post.id}`
  },
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.image ? `https://constival.com${post.data.image}` : "https://constival.com/images/og-image.png",
  "author": {
    "@type": "Organization",
    "name": post.data.author,
    "url": "https://constival.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Constival Legal",
    "logo": {
      "@type": "ImageObject",
      "url": "https://constival.com/isotipo-2.svg"
    }
  },
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString()
};
---

<Layout
  title={`${post.data.title} | Blog Constival Legal`}
  description={post.data.description}
  canonicalUrl={`https://constival.com/blog/${post.id}`}
  ogImage={post.data.image || "https://constival.com/images/og-image.png"}
>
  <Navbar />

  <main class="bg-gray-50 dark:bg-[#0a0f1a] pt-24 pb-16 sm:pt-32 sm:pb-24 transition-colors duration-300">
    <!-- Encabezado del Artículo -->
    <header class="container mx-auto px-6 sm:px-8 max-w-4xl relative z-10 text-center mb-12 sm:mb-16">
      <div class="flex items-center justify-center gap-3 mb-6 flex-wrap">
        <span class="font-sans text-badge font-bold uppercase tracking-wider text-constival-teal dark:text-slate-400">
          {post.data.pubDate.toLocaleDateString("es-EC", {
            year: "numeric", month: "long", day: "numeric",
          })}
        </span>
        {post.data.tags && post.data.tags.map((tag) => (
          <>
            <span class="hidden sm:block w-1.5 h-1.5 rounded-full bg-constival-mint/50"></span>
            <span class="font-sans text-fine font-bold uppercase tracking-widest text-constival-blue dark:text-constival-mint bg-constival-blue/5 dark:bg-constival-mint/10 px-3 py-1.5">
              {tag}
            </span>
          </>
        ))}
      </div>
      
      <h1 class="font-sans text-blog-title font-extrabold text-constival-navy dark:text-white tracking-tight leading-[1.1] mb-6">
        {post.data.title}
      </h1>
      
      <p class="font-serif italic text-body-lead text-constival-teal dark:text-slate-400 leading-relaxed max-w-3xl mx-auto">
        {post.data.description}
      </p>
    </header>

    <!-- Wrapper de Artículo + Sidebar -->
    <div class={`container mx-auto px-6 sm:px-8 relative z-10 flex flex-col items-start ${hasSidebar ? 'max-w-6xl lg:flex-row gap-10' : 'max-w-4xl'}`}>
      
      <!-- Contenido Principal -->
      <article class={`w-full bg-white dark:bg-constival-deep border border-constival-navy/5 dark:border-white/5 py-8 sm:py-12 px-6 sm:px-12 shadow-2xl dark:shadow-none prose prose-lg sm:prose-xl dark:prose-invert prose-headings:font-sans prose-headings:font-extrabold prose-headings:tracking-tight prose-a:text-constival-teal dark:prose-a:text-constival-mint hover:prose-a:text-constival-blue prose-p:leading-relaxed prose-blockquote:border-l-4 prose-blockquote:border-constival-mint prose-blockquote:bg-constival-teal/5 dark:prose-blockquote:bg-constival-mint/5 prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:not-italic prose-blockquote:text-constival-navy dark:prose-blockquote:text-slate-300 ${hasSidebar ? 'lg:w-8/12' : ''}`}>
        
      <Content />
      
      <!-- Footer del Autor -->
      <footer class="mt-16 pt-8 border-t border-constival-navy/10 dark:border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-constival-navy dark:bg-white flex items-center justify-center rounded-sm">
            <span class="text-white dark:text-constival-navy font-bold text-lg leading-none">C</span>
          </div>
          <div>
            <p class="font-sans font-bold text-constival-navy dark:text-white leading-tight">Escrito por {post.data.author}</p>
            <p class="font-sans text-fine text-constival-navy/60 dark:text-slate-400">Arquitectura Societaria Preventiva</p>
          </div>
        </div>
        
        <!-- Social Share Simple -->
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=https://constival.com/blog/${post.id}`} target="_blank" rel="noopener noreferrer" class="text-constival-navy/50 hover:text-constival-blue dark:text-slate-500 dark:hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
        </a>
      </footer>
      </article>

      <!-- Sidebar Pegajoso (CRO) - DINÁMICO -->
      {hasSidebar && (
        <aside class="w-full lg:w-4/12 sticky top-32 mb-12 lg:mb-0 hidden lg:block">
          
          {post.data.relatedService === "sas" && (
            <div class="bg-gradient-to-br from-constival-teal/10 to-transparent dark:from-white/5 dark:to-transparent border-t-4 border-constival-mint p-8 shadow-sm">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 flex items-center justify-center bg-constival-mint text-constival-navy rounded-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
                </div>
                <span class="font-sans text-fine font-bold uppercase tracking-widest text-constival-teal dark:text-slate-400">Protege tu Inversión</span>
              </div>
              
              <h3 class="font-sans text-card-title font-black text-constival-navy dark:text-white mb-4 leading-tight">
                Constituye tu S.A.S. en Modo <span class="text-constival-teal dark:text-constival-mint">Automático</span>.
              </h3>
              
              <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mb-8 leading-relaxed">
                No uses plantillas genéricas. Nuestros arquitectos societarios redactan estatutos blindados para inversión extranjera y resolución de conflictos. En menos de 3 días.
              </p>
              
              <a href="/servicios/crear-sas-ecuador#cotizador-interactivo" class="font-sans bg-constival-mint text-constival-navy font-bold py-3 px-6 w-full inline-flex justify-center items-center gap-2 group hover:bg-constival-teal hover:text-white transition-colors duration-300">
                EMPIEZA AHORA 
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          )}

          {post.data.relatedService === "marcas" && (
            <div class="bg-gradient-to-br from-constival-blue/10 to-transparent dark:from-white/5 dark:to-transparent border-t-4 border-constival-blue p-8 shadow-sm">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 flex items-center justify-center bg-constival-blue text-white rounded-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <span class="font-sans text-fine font-bold uppercase tracking-widest text-constival-blue dark:text-slate-400">Propiedad Intelectual</span>
              </div>
              <h3 class="font-sans text-card-title font-black text-constival-navy dark:text-white mb-4 leading-tight">
                Registra tu <span class="text-constival-blue dark:text-constival-mint">Marca</span> antes de que la copien.
              </h3>
              <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mb-8 leading-relaxed">
                Asegura los derechos legales sobre el nombre y logo de tu empresa en todo el territorio ecuatoriano (SENADI).
              </p>
              <a href="#contacto" class="font-sans bg-constival-navy dark:bg-white text-white dark:text-constival-navy font-bold py-3 px-6 w-full inline-flex justify-center items-center gap-2 group hover:bg-constival-blue transition-colors duration-300">
                PROTEGER MARCA 
              </a>
            </div>
          )}

        </aside>
      )}
      
    </div>

  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)}></script>
</Layout>
