---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import PainSection from "../components/PainSection.astro";
import RiskGrader from "../components/RiskGrader.astro";
// import ValueProposition from "../components/ValueProposition.astro";
import WhyUs from "../components/WhyUs.astro";
import Calculator from "../components/Calculator.astro";
// import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import CtaSection from "../components/CtaSection.astro";
import Footer from "../components/Footer.astro";
import PopupManager from "../components/popups/PopupManager.astro";
// import ThemeOverride from "../components/ThemeOverride.astro";
import { CONSTIVAL_DATA } from "../constants/company";
---

<Layout
  title="Constival — Arquitectura Societaria Blindada para Ecuador"
  description="Estructuras societarias blindadas para escalar tu empresa en Ecuador. Constitución S.A.S., reformas, registro de marcas y blindaje corporativo 100% digital. Arquitectos Legales."
  contact={CONSTIVAL_DATA.info.contact}
>
  <Navbar />
  <main>
    <Hero />
    <PainSection />
    <RiskGrader />
    <!-- <ValueProposition /> -->
    <WhyUs />
    <Calculator />
    <!-- <Services /> -->
    <Testimonials />
    <Pricing />
    <Faq />
    <CtaSection />
  </main>

  <Footer />
  <PopupManager />
</Layout>
