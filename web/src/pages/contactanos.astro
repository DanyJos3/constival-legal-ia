---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import LeafletMap from "../components/ui/LeafletMap.astro";
import { CONSTIVAL_DATA } from "../constants/company";

const { contact } = CONSTIVAL_DATA.info;
const title = "Contáctanos | CONSTIVAL — Quito, Ecuador";
const description =
  "Escríbenos por WhatsApp, email o llámanos. Oficinas en Quito. Respuesta en menos de 24 horas. Consulta inicial gratuita para tu empresa.";

// La URL se lee de la variable de entorno — nunca queda hardcodeada en el repo
const sheetsEndpoint = import.meta.env.SHEETS_KEY ?? "";
---

<Layout
  title={title}
  description={description}
  canonicalUrl="https://constival.com/contactanos"
>
  <Navbar />
  <main>
    <!-- HERO -->
    <section
      class="relative pt-28 pb-16 bg-white dark:bg-constival-navy overflow-hidden transition-colors duration-300"
    >
      <div
        class="absolute top-0 right-0 w-[400px] h-[400px] bg-constival-teal/20 blur-[120px] rounded-full pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-constival-blue/10 blur-[100px] rounded-full pointer-events-none"
      >
      </div>

      <div
        class="container mx-auto px-6 md:px-12 max-w-4xl text-center relative z-10"
      >
        <span
          class="inline-block py-1.5 px-3 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-xs border-l-4 border-constival-teal dark:border-constival-mint mb-6"
        >
          Estamos para servirte
        </span>
        <h1
          class="font-sans text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-constival-navy dark:text-white mb-5 leading-tight"
        >
          Hablemos de tu <span class="text-constival-mint">empresa.</span>
        </h1>
        <p
          class="font-sans text-lg text-constival-navy/60 dark:text-slate-400 max-w-xl mx-auto leading-relaxed"
        >
          Consulta inicial gratuita. Te respondemos en menos de 24 horas hábiles
          por el canal que prefieras.
        </p>
      </div>
    </section>

    <!-- CONTACT CHANNELS + FORM -->
    <section
      class="py-14 bg-gray-50 dark:bg-[#090e1a] transition-colors duration-300"
    >
      <div class="container mx-auto px-6 md:px-12 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">
          <!-- LEFT: Channels -->
          <div class="lg:col-span-2 space-y-4">
            <h2
              class="font-sans text-2xl font-extrabold text-constival-navy dark:text-white mb-6 tracking-tight"
            >
              Canales de contacto
            </h2>

            <!-- WhatsApp -->
            <a
              href={`https://wa.me/593${contact.phone}?text=Hola%20CONSTIVAL,%20tengo%20una%20consulta`}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 p-5 bg-white dark:bg-constival-deep/60 border border-constival-navy/5 dark:border-white/5 hover:border-[#25D366]/40 hover:shadow-lg transition-all duration-300"
            >
              <div
                class="w-12 h-12 flex items-center justify-center bg-[#25D366]/10 text-[#25D366] shrink-0"
              >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"
                  ><path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path></svg
                >
              </div>
              <div class="flex-1">
                <div
                  class="font-sans font-bold text-constival-navy dark:text-white text-sm uppercase tracking-wider mb-0.5"
                >
                  WhatsApp
                </div>
                <div
                  class="font-sans text-constival-navy/70 dark:text-slate-400 text-base"
                >
                  +593 {contact.phone}
                </div>
              </div>
              <svg
                class="w-4 h-4 text-constival-navy/20 dark:text-white/20 group-hover:text-[#25D366] transition-colors"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </a>

            <!-- Email -->
            <a
              href={`mailto:${contact.email}`}
              class="group flex items-center gap-4 p-5 bg-white dark:bg-constival-deep/60 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/40 hover:shadow-lg transition-all duration-300"
            >
              <div
                class="w-12 h-12 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint shrink-0"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path></svg
                >
              </div>
              <div class="flex-1">
                <div
                  class="font-sans font-bold text-constival-navy dark:text-white text-sm uppercase tracking-wider mb-0.5"
                >
                  Correo Electrónico
                </div>
                <div
                  class="font-sans text-constival-navy/70 dark:text-slate-400 text-base"
                >
                  {contact.email}
                </div>
              </div>
              <svg
                class="w-4 h-4 text-constival-navy/20 dark:text-white/20 group-hover:text-constival-mint transition-colors"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </a>

            <!-- Phone -->
            <a
              href={`tel:+593${contact.phone}`}
              class="group flex items-center gap-4 p-5 bg-white dark:bg-constival-deep/60 border border-constival-navy/5 dark:border-white/5 hover:border-constival-blue/40 hover:shadow-lg transition-all duration-300"
            >
              <div
                class="w-12 h-12 flex items-center justify-center bg-constival-blue/10 text-constival-blue dark:text-constival-mint shrink-0"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path></svg
                >
              </div>
              <div class="flex-1">
                <div
                  class="font-sans font-bold text-constival-navy dark:text-white text-sm uppercase tracking-wider mb-0.5"
                >
                  Teléfono
                </div>
                <div
                  class="font-sans text-constival-navy/70 dark:text-slate-400 text-base"
                >
                  +593 {contact.phone}
                </div>
              </div>
              <svg
                class="w-4 h-4 text-constival-navy/20 dark:text-white/20 group-hover:text-constival-blue dark:group-hover:text-constival-mint transition-colors"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </a>

            <!-- Address -->
            <div
              class="flex items-start gap-4 p-5 bg-white dark:bg-constival-deep/60 border border-constival-navy/5 dark:border-white/5"
            >
              <div
                class="w-12 h-12 flex items-center justify-center bg-constival-navy/5 dark:bg-white/5 text-constival-navy dark:text-slate-400 shrink-0"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
                >
              </div>
              <div>
                <div
                  class="font-sans font-bold text-constival-navy dark:text-white text-sm uppercase tracking-wider mb-0.5"
                >
                  Oficina
                </div>
                <div
                  class="font-sans text-constival-navy/70 dark:text-slate-400 text-base leading-relaxed"
                >
                  {contact.address}<br />{contact.city}, {contact.country}
                </div>
              </div>
            </div>

            <!-- Hours -->
            <div
              class="p-5 bg-constival-mint/5 dark:bg-constival-mint/10 border border-constival-mint/20"
            >
              <div class="flex items-center gap-2 mb-2">
                <svg
                  class="w-4 h-4 text-constival-mint"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
                >
                <span
                  class="font-sans font-bold text-sm text-constival-navy dark:text-white uppercase tracking-wider"
                  >Horario de atención</span
                >
              </div>
              <p
                class="font-sans text-sm text-constival-navy/70 dark:text-slate-400"
              >
                Lunes a Viernes: <strong
                  class="text-constival-navy dark:text-white"
                  >9:00 – 18:00</strong
                ><br />WhatsApp: <strong
                  class="text-constival-navy dark:text-white"
                  >Respuesta en 24h</strong
                >
              </p>
            </div>
          </div>

          <!-- RIGHT: Form -->
          <div class="lg:col-span-3">
            <h2
              class="font-sans text-2xl font-extrabold text-constival-navy dark:text-white mb-6 tracking-tight"
            >
              Envíanos un mensaje
            </h2>

            <div
              id="contact-form-wrap"
              class="bg-white dark:bg-constival-deep/60 border border-constival-navy/5 dark:border-white/5 p-6 sm:p-8"
            >
              <!-- SUCCESS STATE (hidden initially) -->
              <div
                id="form-success"
                class="hidden flex-col items-center justify-center text-center py-12"
              >
                <div
                  class="w-16 h-16 flex items-center justify-center bg-constival-mint/20 text-constival-mint mb-4"
                >
                  <svg
                    class="w-8 h-8"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"></path></svg
                  >
                </div>
                <h3
                  class="font-sans text-xl font-extrabold text-constival-navy dark:text-white mb-2"
                >
                  ¡Mensaje recibido!
                </h3>
                <p
                  class="font-sans text-constival-navy/60 dark:text-slate-400 leading-relaxed max-w-sm"
                >
                  Te respondemos en menos de 24 horas hábiles. También puedes
                  escribirnos directamente por WhatsApp.
                </p>
              </div>

              <!-- FORM -->
              <form
                id="contact-form"
                data-endpoint={sheetsEndpoint}
                novalidate
                class="space-y-5"
              >
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label
                      for="cf-nombre"
                      class="block font-sans text-sm font-bold text-constival-navy dark:text-white mb-1.5 uppercase tracking-wider"
                      >Nombre completo *</label
                    >
                    <input
                      id="cf-nombre"
                      name="nombre"
                      type="text"
                      required
                      placeholder="Juan Pérez"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-constival-navy/50 border border-constival-navy/10 dark:border-white/10 text-constival-navy dark:text-white placeholder:text-constival-navy/30 dark:placeholder:text-slate-600 font-sans text-base focus:outline-none focus:border-constival-mint transition-colors duration-200"
                    />
                  </div>
                  <div>
                    <label
                      for="cf-email"
                      class="block font-sans text-sm font-bold text-constival-navy dark:text-white mb-1.5 uppercase tracking-wider"
                      >Correo electrónico</label
                    >
                    <input
                      id="cf-email"
                      name="email"
                      type="email"
                      placeholder="juan@empresa.com"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-constival-navy/50 border border-constival-navy/10 dark:border-white/10 text-constival-navy dark:text-white placeholder:text-constival-navy/30 dark:placeholder:text-slate-600 font-sans text-base focus:outline-none focus:border-constival-mint transition-colors duration-200"
                    />
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label
                      for="cf-telefono"
                      class="block font-sans text-sm font-bold text-constival-navy dark:text-white mb-1.5 uppercase tracking-wider"
                      >Teléfono / WhatsApp *</label
                    >
                    <input
                      id="cf-telefono"
                      name="telefono"
                      type="tel"
                      required
                      placeholder="+593 99 123 4567"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-constival-navy/50 border border-constival-navy/10 dark:border-white/10 text-constival-navy dark:text-white placeholder:text-constival-navy/30 dark:placeholder:text-slate-600 font-sans text-base focus:outline-none focus:border-constival-mint transition-colors duration-200"
                    />
                  </div>
                  <div>
                    <label
                      for="cf-servicio"
                      class="block font-sans text-sm font-bold text-constival-navy dark:text-white mb-1.5 uppercase tracking-wider"
                      >Servicio de interés</label
                    >
                    <select
                      id="cf-servicio"
                      name="servicio"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-constival-navy/50 border border-constival-navy/10 dark:border-white/10 text-constival-navy dark:text-white font-sans text-base focus:outline-none focus:border-constival-mint transition-colors duration-200 appearance-none"
                    >
                      <option value="">Selecciona un servicio</option>
                      <option value="Constitución SAS">Constitución SAS</option>
                      <option value="Registro de Marca"
                        >Registro de Marca</option
                      >
                      <option value="Disolución de Sociedad"
                        >Disolución de Sociedad</option
                      >
                      <option value="Cesión de Acciones"
                        >Cesión de Acciones</option
                      >
                      <option value="Reforma de Estatutos"
                        >Reforma de Estatutos</option
                      >
                      <option value="Nombramientos">Nombramientos</option>
                      <option value="Otro">Otro / Consulta general</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label
                    for="cf-mensaje"
                    class="block font-sans text-sm font-bold text-constival-navy dark:text-white mb-1.5 uppercase tracking-wider"
                    >Mensaje</label
                  >
                  <textarea
                    id="cf-mensaje"
                    name="mensaje"
                    rows="4"
                    placeholder="Cuéntanos brevemente en qué podemos ayudarte..."
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-constival-navy/50 border border-constival-navy/10 dark:border-white/10 text-constival-navy dark:text-white placeholder:text-constival-navy/30 dark:placeholder:text-slate-600 font-sans text-base focus:outline-none focus:border-constival-mint transition-colors duration-200 resize-none"
                  ></textarea>
                </div>

                <!-- Error message -->
                <p
                  id="form-error"
                  class="hidden font-sans text-sm text-red-500 font-bold"
                >
                </p>

                <button
                  type="submit"
                  id="cf-submit"
                  class="w-full flex items-center justify-center gap-3 px-6 py-4 bg-constival-mint hover:bg-constival-mint/90 text-constival-navy font-sans font-black text-sm uppercase tracking-widest transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed disabled:scale-100"
                >
                  <svg
                    id="cf-icon-send"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg
                  >
                  <svg
                    id="cf-icon-spin"
                    class="hidden w-5 h-5 animate-spin"
                    viewBox="0 0 24 24"
                    fill="none"
                    ><circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"></circle><path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                    ></path></svg
                  >
                  <span id="cf-btn-text">Enviar mensaje</span>
                </button>

                <p
                  class="font-sans text-xs text-constival-navy/40 dark:text-slate-600 text-center leading-relaxed"
                >
                  🔒 Tus datos son confidenciales y nunca serán compartidos con
                  terceros.
                </p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GOOGLE MAPS -->
    <section
      class="bg-white dark:bg-constival-navy transition-colors duration-300"
    >
      <div class="container mx-auto px-6 md:px-12 max-w-6xl py-14">
        <div class="text-center mb-8">
          <span
            class="inline-block py-1.5 px-3 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-xs border-l-4 border-constival-teal dark:border-constival-mint mb-4"
          >
            Ubicación
          </span>
          <h2
            class="font-sans text-3xl font-extrabold text-constival-navy dark:text-white tracking-tight"
          >
            Visítanos en <span class="text-constival-mint">Quito.</span>
          </h2>
          <p
            class="font-sans text-base text-constival-navy/60 dark:text-slate-400 mt-2"
          >
            {contact.address} — {contact.city}
          </p>
        </div>
        <div
          class="relative w-full h-[400px] md:h-[500px] overflow-hidden border border-constival-navy/10 dark:border-white/10 shadow-xl rounded-2xl"
        >
          <LeafletMap
            lat={-0.180436}
            lng={-78.47959}
            title="CONSTIVAL (Space Cowork)"
            address="Av. Republica de El Salvador 170135, Ed. Prisma Norte"
          />
        </div>
        <div class="mt-4 flex justify-center">
          <a
            href="https://maps.app.goo.gl/54QG1QWieCNf77AX6"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-sans text-sm font-bold text-constival-teal dark:text-constival-mint hover:underline"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path></svg
            >
            Abrir en Google Maps
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // La URL viene del data-endpoint del form — inyectada desde import.meta.env en el frontmatter
  const SHEETS_ENDPOINT =
    (document.getElementById("contact-form") as HTMLFormElement)?.dataset
      .endpoint ?? "";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const successEl = document.getElementById("form-success") as HTMLElement;
  const errorEl = document.getElementById("form-error") as HTMLElement;
  const submitBtn = document.getElementById("cf-submit") as HTMLButtonElement;
  const btnText = document.getElementById("cf-btn-text") as HTMLElement;
  const iconSend = document.getElementById("cf-icon-send") as HTMLElement;
  const iconSpin = document.getElementById("cf-icon-spin") as HTMLElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    errorEl.textContent = "";

    // Basic validation
    const nombre = (
      document.getElementById("cf-nombre") as HTMLInputElement
    ).value.trim();
    // const email = (
    //   document.getElementById("cf-email") as HTMLInputElement
    // ).value.trim();
    // const mensaje = (
    //   document.getElementById("cf-mensaje") as HTMLTextAreaElement
    // ).value.trim();
    const telefono = (
      document.getElementById("cf-telefono") as HTMLInputElement
    ).value.trim();

    if (!nombre || !telefono) {
      errorEl.textContent = "Por favor completa los campos obligatorios (*)";
      errorEl.classList.remove("hidden");
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    btnText.textContent = "Enviando...";
    iconSend.classList.add("hidden");
    iconSpin.classList.remove("hidden");

    try {
      const formData = new FormData(form);
      const searchParams = new URLSearchParams();

      formData.forEach((value, key) => {
        searchParams.append(key, value.toString());
      });

      searchParams.append(
        "fecha",
        new Date().toLocaleString("es-EC", { timeZone: "America/Guayaquil" }),
      );
      searchParams.append("origen", window.location.href);

      await fetch(SHEETS_ENDPOINT, {
        method: "POST",
        mode: "no-cors",
        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
        },
        body: searchParams,
      });

      // no-cors always resolves — assume success
      form.classList.add("hidden");
      successEl.classList.remove("hidden");
      successEl.classList.add("flex");
    } catch (_) {
      errorEl.textContent =
        "Hubo un error al enviar. Escríbenos directamente por WhatsApp.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
      btnText.textContent = "Enviar mensaje";
      iconSend.classList.remove("hidden");
      iconSpin.classList.add("hidden");
    }
  });
</script>
