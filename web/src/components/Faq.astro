---
import { CONSTIVAL_DATA } from '../constants/company';
const { faq } = CONSTIVAL_DATA;
---
<section class="py-14 md:py-16 bg-white dark:bg-constival-navy relative transition-colors duration-300" id="faq">
  <div class="container mx-auto px-6 md:px-12 max-w-[900px] relative z-10">
    <div class="text-center mb-10">
      <span class="inline-block py-1.5 px-3 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-xs sm:text-sm mb-4 border-l-4 border-constival-teal dark:border-constival-mint">
        Preguntas Frecuentes
      </span>
      <h2 class="font-sans text-3xl sm:text-4xl 2xl:text-5xl font-extrabold text-constival-navy dark:text-white tracking-tight mb-2">
        Respuestas sin <span class="text-constival-mint">tecnicismos.</span>
      </h2>
    </div>

    <div class="space-y-3" id="faq-accordion">
      {faq.map((item, i) => (
        <div class="border border-constival-navy/5 dark:border-white/5 group" data-faq-item>
          <button
            class="w-full flex items-center justify-between text-left p-4 md:p-5 font-sans font-bold text-base text-constival-navy dark:text-white hover:text-constival-mint dark:hover:text-constival-mint transition-colors"
            data-faq-trigger
            aria-expanded="false"
          >
            <span class="pr-4">{item.q}</span>
            <svg class="w-5 h-5 shrink-0 text-constival-navy/30 dark:text-white/30 transition-transform duration-300 faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out" data-faq-content>
            <p class="px-4 md:px-5 pb-4 md:pb-5 font-sans text-sm sm:text-base text-constival-navy/60 dark:text-slate-400 leading-relaxed">
              {item.a}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- FAQ Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    })),
    "publisher": {
      "@id": "https://constival.com/#organization"
    }
  })}></script>
</section>

<script>
  document.querySelectorAll('[data-faq-trigger]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = (trigger as HTMLElement).closest('[data-faq-item]')!;
      const content = item.querySelector('[data-faq-content]') as HTMLElement;
      const icon = item.querySelector('.faq-icon') as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      // Close all others
      document.querySelectorAll('[data-faq-item]').forEach(otherItem => {
        if (otherItem !== item) {
          const otherContent = otherItem.querySelector('[data-faq-content]') as HTMLElement;
          const otherIcon = otherItem.querySelector('.faq-icon') as HTMLElement;
          const otherTrigger = otherItem.querySelector('[data-faq-trigger]')!;
          otherContent.style.maxHeight = '0';
          otherIcon?.classList.remove('rotate-180');
          otherTrigger.setAttribute('aria-expanded', 'false');
        }
      });

      if (isOpen) {
        content.style.maxHeight = '0';
        icon?.classList.remove('rotate-180');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        content.style.maxHeight = content.scrollHeight + 'px';
        icon?.classList.add('rotate-180');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
