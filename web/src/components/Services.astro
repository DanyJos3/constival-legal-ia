---
import ServiceCard from './ui/ServiceCard.astro';
---
<section class="py-14 md:py-16 bg-white dark:bg-[#0e131f] transition-colors duration-300" id="servicios">
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl">
    <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-6">
      <div class="max-w-xl">
        <h2 class="font-sans text-section-title font-bold text-constival-navy dark:text-white mb-2 tracking-tighter">PRÁCTICA <br/> ESPECIALIZADA</h2>
      </div>
      <p class="max-w-sm text-constival-navy/80 dark:text-slate-400 font-sans text-fine border-l-4 border-constival-mint pl-4">
        Desplegamos expertise técnico en las áreas críticas del desarrollo corporativo moderno.
      </p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      <ServiceCard number="01" title="Constitución Inteligente (S.A.S.)" description="Diseñamos el esqueleto legal de tu empresa blindado contra conflictos de accionistas y parálisis futura." />
      <ServiceCard number="02" title="Actualización Societaria" description="Reformamos tus estatutos para permitir ingresos de capital o pivotar el objeto social sin rechazos en la Superintendencia de Compañías." />
      <ServiceCard number="03" title="Protección de Directorio" description="Inscribimos cambios de representantes y gerentes para evitar el congelamiento automático de tus cuentas bancarias." />
      <ServiceCard number="04" title="Traspaso Acuerdado (Cesiones)" description="Transferencia accionaria 100% legalizada en libros societarios y notificada en portales gubernamentales." />
      <ServiceCard number="05" title="Blindaje de Identidad (Marcas)" description="Registro a 10 años ante el SENADI con búsquedas fonéticas. Asegura el control del activo más valioso que tienes." />
      
      <!-- CTA Card -->
      <a href="#configurador" class="bg-constival-mint p-6 md:p-8 flex flex-col justify-between items-start cursor-pointer group overflow-hidden relative shadow-lg no-underline">
        <div class="absolute inset-0 bg-[#00e29d] translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
        <h4 class="font-sans text-feature-title font-bold text-[#003824] relative z-10 leading-snug">¿No sabes qué nivel de estructuración requieres?</h4>
        <span class="font-sans text-[#003824] font-bold tracking-widest text-fine relative z-10 group-hover:translate-x-2 transition-transform mt-6 flex items-center gap-2">
          RESERVAR DIAGNÓSTICO GRATIS <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </span>
      </a>
    </div>
  </div>
</section>
