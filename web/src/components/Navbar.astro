---
import Button from "./ui/Button.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isSasEcuadorLp = pathname === "/servicios/crear-sas-ecuador";
const homeHash = (id: string) =>
  isSasEcuadorLp ? `/servicios/crear-sas-ecuador#${id}` : `/#${id}`;
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-white/70 dark:bg-constival-navy/70 backdrop-blur-xl border-b border-constival-navy/5 dark:border-white/5 transition-all duration-300"
  id="main-nav"
>
  <nav
    class="flex justify-between items-center w-full px-6 md:px-12 lg:px-16 py-2 mx-auto max-w-7xl"
  >
    <a
      href="/"
      class="flex items-center gap-2 relative z-50"
      aria-label="CONSTIVAL - Inicio"
    >
      <!-- Logo icon from favicon.svg -->
      <img
        src="/isotipo-1.svg"
        alt=""
        width="32"
        height="32"
        class="h-6 w-6 md:h-8 md:w-8"
        aria-hidden="true"
      />
      <!-- Wordmark -->
      <span
        class="text-xl font-black text-constival-navy dark:text-constival-mint font-sans tracking-widest uppercase"
      >
        CONSTIVAL
      </span>
      <!-- <span
        class="text-xl md:text-2xl font-black text-constival-navy dark:text-white tracking-widest font-sans"
      >
        CONSTIVAL
      </span> -->
      <!-- <span class="text-constival-mint"></span> -->
    </a>

    <div
      class="hidden items-center md:flex gap-8 font-sans tracking-tight uppercase font-bold text-sm"
    >
      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href={homeHash("inicio")}>Inicio</a
      >

      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/#servicios">Servicios</a
      >
      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/#configurador">Simulador</a
      >
      <!-- <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/#precios">Precios</a
      > -->
      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/#faq">Preguntas Frecuentes</a
      >
      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/blog">Blog & Recursos</a
      >
      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/servicios/crear-sas-ecuador"
      >
        <div class="hidden lg:block">
          <Button
            variant="primary"
            href="/servicios/crear-sas-ecuador"
            class="py-2.5 px-6 text-xs">Crea tu SAS</Button
          >
        </div>
      </a>
      <!-- <ThemeToggle /> -->
    </div>

    <!--  <div class="flex items-center gap-4">  -->
    <!-- <ThemeToggle /> -->
    <!-- TRACKING: nav_cta_diagnostico -->
    <!-- <div class="hidden lg:block">
        <Button variant="primary" href="#configurador" class="py-2.5 px-6 text-xs">Iniciar Diagnóstico</Button>
      </div> -->
    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 relative z-50 p-2"
      aria-label="Abrir menú"
    >
      <span
        class="block w-6 h-0.5 bg-constival-navy dark:bg-white transition-all duration-300 origin-center"
        id="bar1"></span>
      <span
        class="block w-6 h-0.5 bg-constival-navy dark:bg-white transition-all duration-300"
        id="bar2"></span>
      <span
        class="block w-4 h-0.5 bg-constival-mint transition-all duration-300 origin-center"
        id="bar3"></span>
    </button>
    <!-- </div>  -->
  </nav>

  <!-- SiteNavigationElement Schema Markup -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: [
        {
          "@type": "SiteNavigationElement",
          position: 1,
          name: "Inicio",
          url: "https://constival.com/#inicio",
        },
        {
          "@type": "SiteNavigationElement",
          position: 2,
          name: "Crear SAS Ecuador",
          url: "https://constival.com/servicios/crear-sas-ecuador",
        },
        {
          "@type": "SiteNavigationElement",
          position: 3,
          name: "Servicios",
          url: "https://constival.com/#servicios",
        },
        {
          "@type": "SiteNavigationElement",
          position: 4,
          name: "Simulador Gratuito",
          url: "https://constival.com/#configurador",
        },
        {
          "@type": "SiteNavigationElement",
          position: 5,
          name: "Preguntas Frecuentes",
          url: "https://constival.com/#faq",
        },
      ],
    })}
  />
</header>

<!-- Mobile Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-40 pointer-events-none opacity-0 transition-opacity duration-300"
>
  <div class="absolute inset-0 bg-constival-navy/95 backdrop-blur-2xl"></div>
  <nav
    class="relative z-10 flex flex-col items-center justify-center h-full gap-8 font-sans"
  >
    <!-- href={homeHash("inicio")} -->
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/">Inicio</a
    >
    <!-- <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/servicios/crear-sas-ecuador">Crear SAS</a
    > -->
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/#servicios">Servicios</a
    >
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/#configurador">Simulador</a
    >
    <!-- <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/#precios">Precios</a
    > -->
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/#faq">FAQ</a
    >
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/blog">Blog & Recursos</a
    >
    <div class="mt-4">
      <!-- TRACKING: mobile_cta_diagnostico -->
      <Button
        variant="primary"
        href="/servicios/crear-sas-ecuador"
        class="text-3xl px-10">INICIA tu SAS</Button
      >
    </div>
  </nav>
</div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const drawer = document.getElementById("mobile-drawer");
  const bar1 = document.getElementById("bar1");
  const bar2 = document.getElementById("bar2");
  const bar3 = document.getElementById("bar3");
  const links = document.querySelectorAll(".mobile-link");
  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      drawer?.classList.remove("pointer-events-none", "opacity-0");
      drawer?.classList.add("pointer-events-auto", "opacity-100");
      bar1?.classList.add("rotate-45", "translate-y-[4px]");
      bar2?.classList.add("opacity-0", "scale-0");
      bar3?.classList.add("-rotate-45", "-translate-y-[4px]", "w-6");
      document.body.style.overflow = "hidden";
    } else {
      drawer?.classList.add("pointer-events-none", "opacity-0");
      drawer?.classList.remove("pointer-events-auto", "opacity-100");
      bar1?.classList.remove("rotate-45", "translate-y-[4px]");
      bar2?.classList.remove("opacity-0", "scale-0");
      bar3?.classList.remove("-rotate-45", "-translate-y-[4px]", "w-6");
      document.body.style.overflow = "";
    }
  }

  btn?.addEventListener("click", toggleMenu);
  links.forEach((link) =>
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    }),
  );

  // Navbar scroll shadow
  const nav = document.getElementById("main-nav");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      nav?.classList.add(
        "shadow-lg",
        "shadow-constival-navy/5",
        "dark:shadow-black/20",
      );
    } else {
      nav?.classList.remove(
        "shadow-lg",
        "shadow-constival-navy/5",
        "dark:shadow-black/20",
      );
    }
  });
</script>
