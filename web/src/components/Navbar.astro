---
import Button from "./ui/Button.astro";
// import ThemeToggle from "./ThemeToggle.astro";

// const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
// const isSasEcuadorLp = pathname === "/servicios/crear-sas-ecuador";
const isSasEcuadorLp = false;
const homeHash = (id: string) =>
  isSasEcuadorLp ? `/servicios/crear-sas-ecuador#${id}` : `/#${id}`;
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-white/70 dark:bg-constival-navy/70 backdrop-blur-xl border-b border-constival-navy/5 dark:border-white/5 transition-all duration-300"
  id="main-nav"
>
  <nav
    class="flex justify-between items-center w-full px-6 md:px-12 lg:px-16 py-2 mx-auto max-w-7xl"
  >
    <a
      href="/"
      class="flex items-center gap-2 relative z-50"
      aria-label="CONSTIVAL - Inicio"
    >
      <!-- Logo icon from favicon.svg -->
      <img
        src="/isotipo-1.svg"
        alt=""
        width="32"
        height="32"
        class="h-6 w-6 md:h-8 md:w-8"
        aria-hidden="true"
      />
      <!-- Wordmark -->
      <span
        class="text-xl font-black text-constival-navy dark:text-white font-sans tracking-widest uppercase"
      >
        CONSTIVAL
      </span>
      <!-- <span
        class="text-xl md:text-2xl font-black text-constival-navy dark:text-white tracking-widest font-sans"
      >
        CONSTIVAL
      </span> -->
      <!-- <span class="text-constival-mint"></span> -->
    </a>

    <div
      class="hidden items-center md:flex gap-8 font-sans tracking-tight uppercase font-bold text-sm"
    >
      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href={homeHash("inicio")}>Inicio</a
      >

      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/#servicios">Servicios</a
      >
      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/blog">Blog</a
      >
      <a
        class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint border-b-2 border-transparent hover:border-constival-mint transition-all"
        href="/contactanos">Contacto</a
      >
      <div class="hidden lg:block ml-2">
        <Button
          variant="outline"
          href="https://wa.me/593969503502?text=Hola%20Constival%2C%20estuve%20revisando%20su%20web%20y%20me%20gustar%C3%ADa%20hacerles%20una%20consulta%20r%C3%A1pida."
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "py-2 px-5 text-xs flex items-center gap-2 transition-colors",
            "hover:!bg-[#00ffb2] hover:!text-[#0a1828] hover:!border-[#00ffb2]",
            "dark:hover:!bg-[#00ffb2] dark:hover:!text-[#0a1828] dark:hover:!border-[#00ffb2]"
          ]}
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
          </svg>
          Hablar con un asesor
        </Button>
      </div>
      <!-- <ThemeToggle /> -->
    </div>

    <!--  <div class="flex items-center gap-4">  -->
    <!-- <ThemeToggle /> -->
    <!-- TRACKING: nav_cta_diagnostico -->
    <!-- <div class="hidden lg:block">
        <Button variant="primary" href="#configurador" class="py-2.5 px-6 text-xs">Iniciar Diagnóstico</Button>
      </div> -->
    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 relative z-50 p-2"
      aria-label="Abrir menú"
    >
      <span
        class="block w-6 h-0.5 bg-constival-navy dark:bg-white transition-all duration-300 origin-center"
        id="bar1"></span>
      <span
        class="block w-6 h-0.5 bg-constival-navy dark:bg-white transition-all duration-300"
        id="bar2"></span>
      <span
        class="block w-4 h-0.5 bg-constival-mint transition-all duration-300 origin-center"
        id="bar3"></span>
    </button>
    <!-- </div>  -->
  </nav>

  <!-- SiteNavigationElement Schema Markup -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: [
        {
          "@type": "SiteNavigationElement",
          position: 1,
          name: "Inicio",
          url: "https://constival.com/#inicio",
        },
        {
          "@type": "SiteNavigationElement",
          position: 2,
          name: "Crear SAS Ecuador",
          url: "https://constival.com/servicios/crear-sas-ecuador",
        },
        {
          "@type": "SiteNavigationElement",
          position: 3,
          name: "Servicios",
          url: "https://constival.com/#servicios",
        },
        {
          "@type": "SiteNavigationElement",
          position: 4,
          name: "Simulador Gratuito",
          url: "https://constival.com/#configurador",
        },
        {
          "@type": "SiteNavigationElement",
          position: 5,
          name: "Preguntas Frecuentes",
          url: "https://constival.com/#faq",
        },
      ],
    })}
  />
</header>

<!-- Mobile Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-40 pointer-events-none opacity-0 transition-opacity duration-300"
>
  <div class="absolute inset-0 bg-constival-navy/95 backdrop-blur-2xl"></div>
  <nav
    class="relative z-10 flex flex-col items-center justify-center h-full gap-8 font-sans"
  >
    <!-- href={homeHash("inicio")} -->
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/">Inicio</a
    >
    <!-- <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/servicios/crear-sas-ecuador">Crear SAS</a
    > -->
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/#servicios">Servicios</a
    >
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/blog">Blog</a
    >
    <a
      class="text-3xl font-bold text-white hover:text-constival-mint transition-colors mobile-link"
      href="/contactanos">Contacto</a
    >
    <div class="mt-4">
      <!-- TRACKING: mobile_cta_diagnostico -->
      <Button
        variant="primary"
        href="https://wa.me/593969503502?text=Hola%20Constival%2C%20estuve%20revisando%20su%20web%20y%20me%20gustar%C3%ADa%20hacerles%20una%20consulta%20r%C3%A1pida."
        target="_blank"
        rel="noopener noreferrer"
        class="text-base w-full py-3 flex justify-center items-center gap-3"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
        </svg>
        Hablar con un asesor
      </Button>
    </div>
  </nav>
</div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const drawer = document.getElementById("mobile-drawer");
  const bar1 = document.getElementById("bar1");
  const bar2 = document.getElementById("bar2");
  const bar3 = document.getElementById("bar3");
  const links = document.querySelectorAll(".mobile-link");
  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      drawer?.classList.remove("pointer-events-none", "opacity-0");
      drawer?.classList.add("pointer-events-auto", "opacity-100");
      bar1?.classList.add("rotate-45", "translate-y-[4px]");
      bar2?.classList.add("opacity-0", "scale-0");
      bar3?.classList.add("-rotate-45", "-translate-y-[4px]", "w-6");
      document.body.style.overflow = "hidden";
    } else {
      drawer?.classList.add("pointer-events-none", "opacity-0");
      drawer?.classList.remove("pointer-events-auto", "opacity-100");
      bar1?.classList.remove("rotate-45", "translate-y-[4px]");
      bar2?.classList.remove("opacity-0", "scale-0");
      bar3?.classList.remove("-rotate-45", "-translate-y-[4px]", "w-6");
      document.body.style.overflow = "";
    }
  }

  btn?.addEventListener("click", toggleMenu);
  links.forEach((link) =>
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    }),
  );

  // Navbar scroll shadow
  const nav = document.getElementById("main-nav");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      nav?.classList.add(
        "shadow-lg",
        "shadow-constival-navy/5",
        "dark:shadow-black/20",
      );
    } else {
      nav?.classList.remove(
        "shadow-lg",
        "shadow-constival-navy/5",
        "dark:shadow-black/20",
      );
    }
  });
</script>
