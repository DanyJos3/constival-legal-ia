---
/**
 * Seccion de Proceso SAS Ecuador
 * Roadmap visual de 4 pasos.
 */
const steps = [
  {
    number: "01",
    title: "Diagnóstico y Reserva",
    desc: "Definimos objeto social, socios y reservamos el nombre legal en Supercias."
  },
  {
    number: "02",
    title: "Estructura Legal",
    desc: "Redactamos estatutos a medida y nombramientos de administradores."
  },
  {
    number: "03",
    title: "Firma y Registro",
    desc: "Gestión de firmas electrónicas e inscripción oficial en el Registro de Sociedades."
  },
  {
    number: "04",
    title: "RUC y Entrega",
    desc: "Trámite automático de RUC en SRI y entrega de tu carpeta digital lista para operar."
  }
];
---

<section id="proceso" class="py-20 bg-gray-50 dark:bg-constival-deep/30 transition-colors duration-300 overflow-hidden">
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-sans text-3xl md:text-4xl font-extrabold text-constival-navy dark:text-white mb-6 tracking-tight">
        Tu empresa constituida en <span class="text-constival-mint">4 simples pasos</span>
      </h2>
      <p class="font-sans text-lg text-constival-navy/70 dark:text-slate-400">
        Nos encargamos de toda la burocracia técnica y legal para que tú te enfoques en lanzar tu idea.
      </p>
    </div>

    <div class="relative">
      <!-- Linea decorativa (escritorio) -->
      <div class="hidden lg:block absolute top-1/2 left-0 w-full h-0.5 bg-constival-mint/20 -translate-y-1/2"></div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative z-10">
        {steps.map((step, index) => (
          <div class="group">
            <div class="bg-white dark:bg-constival-navy p-8 rounded-2xl border border-constival-navy/5 dark:border-white/5 shadow-sm group-hover:border-constival-mint/40 transition-all relative">
              <div class="inline-block text-4xl font-black text-constival-mint/20 dark:text-constival-mint/10 mb-4 group-hover:text-constival-mint/40 transition-colors">
                {step.number}
              </div>
              <h3 class="font-sans font-bold text-xl text-constival-navy dark:text-white mb-3">
                {step.title}
              </h3>
              <p class="font-sans text-sm text-constival-navy/70 dark:text-slate-400 leading-relaxed">
                {step.desc}
              </p>
              
              <!-- Punto de union (escritorio) -->
              <div class="hidden lg:block absolute top-1/2 -right-4 w-8 h-8 bg-gray-50 dark:bg-[#0d1117] rounded-full border-4 border-constival-mint/20 -translate-y-1/2 z-20 group-last:hidden">
                 <div class="w-full h-full rounded-full bg-constival-mint scale-0 group-hover:scale-50 transition-transform duration-500"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <div class="mt-16 text-center">
       <div class="inline-flex items-center gap-3 px-6 py-3 bg-constival-mint/10 border border-constival-mint/20 rounded-full">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-constival-mint opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-constival-mint"></span>
          </span>
          <p class="font-sans text-sm font-bold text-constival-navy dark:text-white">
            Plazo estimado: 2 a 3 días hábiles
          </p>
       </div>
    </div>
  </div>
</section>
