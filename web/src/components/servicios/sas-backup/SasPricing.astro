---
/**
 * Seccion de Precios SAS Ecuador
 * Basado en la tabla de precios del PDF de servicios.
 */
import Button from "../../ui/Button.astro";

const prices = [
  { socios: "1 socio", price: "$149", popular: false },
  { socios: "2-3 socios", price: "$179", popular: true },
  { socios: "4-6 socios", price: "$219", popular: false },
  { socios: "7+ socios", price: "$249", popular: false },
];

const inclusions = [
  "Reserva de denominación",
  "Elaboración de estatutos",
  "Nombramientos legales",
  "Inscripción en Supercias",
  "Obtención de RUC SRI",
  "Carpeta societaria digital",
];

const waHref = (socios: string) =>
  `https://wa.me/593969503502?text=${encodeURIComponent(`Hola CONSTIVAL, quiero constituir una SAS para ${socios}.`)}`;
---

<section
  id="precios"
  class="py-20 bg-white dark:bg-[#0a0c10] transition-colors duration-300"
>
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl">
    <div class="text-center mb-16">
      <h2
        class="font-sans text-3xl md:text-5xl font-extrabold text-constival-navy dark:text-white mb-6 tracking-tight"
      >
        Inversión <span class="text-constival-mint">Transparente</span>
      </h2>
      <p
        class="font-sans text-lg text-constival-navy/70 dark:text-slate-400 max-w-2xl mx-auto"
      >
        Honorarios fijos según el número de accionistas. Sin cargos ocultos ni
        sorpresas de último minuto.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {
        prices.map((pkg) => (
          <div
            class={`relative p-8 rounded-2xl border transition-all duration-300 ${pkg.popular ? "border-constival-mint bg-constival-mint/5 shadow-xl scale-105 z-10" : "border-constival-navy/5 bg-gray-50/50 dark:bg-white/5"}`}
          >
            {pkg.popular && (
              <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-constival-mint text-constival-navy font-sans text-[10px] font-black uppercase px-4 py-1.5 rounded-full tracking-widest leading-none">
                Más Solicitado
              </span>
            )}
            <p class="font-sans font-bold text-constival-navy/60 dark:text-slate-500 uppercase text-xs tracking-widest mb-2">
              {pkg.socios}
            </p>
            <div class="mb-8">
              <span class="text-4xl font-black text-constival-navy dark:text-white">
                {pkg.price}
              </span>
              <span class="text-sm font-bold text-constival-navy/40 dark:text-slate-600 ml-1">
                + IVA
              </span>
            </div>

            <ul class="space-y-4 mb-8">
              {inclusions.map((item) => (
                <li class="flex items-center gap-3 text-sm font-sans text-constival-navy/80 dark:text-slate-300">
                  <svg
                    class="w-4 h-4 text-constival-mint shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>

            <Button
              href={waHref(pkg.socios)}
              variant={pkg.popular ? "primary" : "outline"}
              class="w-full text-xs py-3"
            >
              Constituir Ahora
            </Button>
          </div>
        ))
      }
    </div>

    <div
      class="max-w-4xl mx-auto p-6 bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-900/30 rounded-xl"
    >
      <p
        class="font-sans text-xs sm:text-sm text-amber-800 dark:text-amber-200/80 text-center leading-relaxed"
      >
        <strong>Nota importante:</strong> Los valores corresponden únicamente a honorarios
        profesionales. No incluyen aranceles registrales ni costos de firma electrónica
        si el cliente no dispone de ellos, los cuales se desglosan con total transparencia.
      </p>
    </div>
  </div>
</section>
