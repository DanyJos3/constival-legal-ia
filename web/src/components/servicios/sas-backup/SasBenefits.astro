---
/**
 * Seccion de Beneficios SAS Ecuador
 * Resalta: 0 capital, sin notarias, unipersonal, responsabilidad limitada.
 */
const benefits = [
  {
    title: "Cero Capital Mínimo",
    description: "Puedes constituir tu empresa desde $1 de capital social. A diferencia de las S.A., no necesitas inmovilizar dinero en el banco.",
    icon: "banknotes"
  },
  {
    title: "Sin Gastos Notariales",
    description: "Al ser un documento privado electrónico, ahorras entre $300 y $600 en trámites de notaría y registros mercantiles físicos.",
    icon: "document-check"
  },
  {
    title: "Socio Único (Unipersonal)",
    description: "No necesitas buscar socios de 'relleno'. Puedes ser el único dueño y tener el control total de tu empresa.",
    icon: "user"
  },
  {
    title: "Patrimonio Protegido",
    description: "Tu responsabilidad se limita solo al capital aportado. Tus bienes personales quedan blindados legalmente.",
    icon: "shield-check"
  }
];
---

<section id="beneficios" class="py-20 bg-gray-50 dark:bg-constival-deep/30 transition-colors duration-300">
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl">
    <div class="mb-14 max-w-3xl">
      <h2 class="font-sans text-3xl md:text-4xl font-extrabold text-constival-navy dark:text-white mb-4 tracking-tight">
        ¿Por qué elegir una <span class="text-constival-mint">S.A.S.</span> para tu negocio?
      </h2>
      <p class="font-sans text-lg text-constival-navy/70 dark:text-slate-400">
        La Sociedad por Acciones Simplificada es la estructura más moderna y recomendada en Ecuador por su flexibilidad y bajo costo de entrada.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {benefits.map(benefit => (
        <div class="bg-white dark:bg-constival-navy/40 p-8 rounded-2xl border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all group">
          <div class="w-12 h-12 bg-constival-mint/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            {benefit.icon === 'banknotes' && (
              <svg class="w-6 h-6 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            )}
            {benefit.icon === 'document-check' && (
              <svg class="w-6 h-6 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            )}
            {benefit.icon === 'user' && (
              <svg class="w-6 h-6 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            )}
            {benefit.icon === 'shield-check' && (
              <svg class="w-6 h-6 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            )}
          </div>
          <h3 class="font-sans font-bold text-xl text-constival-navy dark:text-white mb-4">
            {benefit.title}
          </h3>
          <p class="font-sans text-sm text-constival-navy/70 dark:text-slate-400 leading-relaxed text-balance">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
