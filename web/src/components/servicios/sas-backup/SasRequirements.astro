---
/**
 * Seccion de Requisitos SAS Ecuador
 * Listado claro de lo que el cliente necesita tener a la mano.
 */
const requirements = [
  {
    title: "Documentos de Identidad",
    desc: "Cédula de identidad para ecuatorianos o pasaporte vigente para extranjeros.",
    icon: "identification"
  },
  {
    title: "Firma Electrónica (Archivo .p12)",
    desc: "Indispensable para todos los accionistas y el representante legal.",
    icon: "document-text"
  },
  {
    title: "Planilla de Servicio Básico",
    desc: "Para justificar el domicilio principal de la nueva compañía.",
    icon: "home"
  },
  {
    title: "Definición del Negocio",
    desc: "Tener claro el nombre comercial, capital social y el objeto social (actividades).",
    icon: "light-bulb"
  }
];
---

<section id="requisitos" class="py-20 bg-white dark:bg-[#0a0c10] transition-colors duration-300">
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl">
    <div class="flex flex-col lg:flex-row gap-12 items-center">
      <div class="flex-1">
        <span class="text-constival-mint font-sans text-sm font-bold uppercase tracking-widest mb-4 block">Prepárate para el éxito</span>
        <h2 class="font-sans text-3xl md:text-4xl font-extrabold text-constival-navy dark:text-white mb-6 tracking-tight">
          ¿Qué necesitas para empezar <br/> <span class="text-constival-mint">hoy mismo?</span>
        </h2>
        <p class="font-sans text-lg text-constival-navy/70 dark:text-slate-400 mb-8 max-w-xl">
          Para que tu constitución sea rápida (2-3 días), asegúrate de contar con los siguientes elementos. Si te falta alguno, nuestro equipo te ayuda a gestionarlo.
        </p>
        
        <div class="space-y-4">
          {requirements.map(req => (
            <div class="flex items-start gap-4 p-4 rounded-xl border border-constival-navy/5 dark:border-white/5 bg-gray-50/50 dark:bg-white/5">
              <div class="mt-1 flex-shrink-0">
                <svg class="w-5 h-5 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div>
                <h4 class="font-sans font-bold text-constival-navy dark:text-white text-base">{req.title}</h4>
                <p class="font-sans text-sm text-constival-navy/60 dark:text-slate-400">{req.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <div class="flex-1 relative w-full max-w-md lg:max-w-none">
        <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl border border-constival-navy/10 dark:border-white/10 bg-[#f7fafc] dark:bg-[#1a1d23] p-8">
           <div class="flex items-center gap-3 mb-6">
             <div class="w-10 h-10 bg-constival-mint/20 rounded-full flex items-center justify-center">
               <svg class="w-6 h-6 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
             </div>
             <h3 class="font-sans font-bold text-xl text-constival-navy dark:text-white">Tip de Experto</h3>
           </div>
           <p class="font-sans text-constival-navy/80 dark:text-slate-300 leading-relaxed mb-6">
             "La mayoría de retrasos ocurren por firmas electrónicas caducadas o en formatos incompatibles. En **Constival**, verificamos tus archivos antes de subir a Supercias para garantizar aprobación al primer intento."
           </p>
           <div class="flex items-center gap-4 py-4 border-t border-constival-navy/10 dark:border-white/10">
             <div class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
               <img src="/img/empresas/tech_logistics.webp" alt="Asesor" class="w-full h-full object-cover grayscale" />
             </div>
             <div>
               <p class="font-sans font-bold text-sm text-constival-navy dark:text-white">Equipo Jurídico</p>
               <p class="font-sans text-xs text-constival-navy/60 dark:text-slate-500">Especialistas en Derecho Societario</p>
             </div>
           </div>
        </div>
        <!-- Decoracion -->
        <div class="absolute -top-6 -right-6 w-32 h-32 bg-constival-mint/20 blur-3xl rounded-full"></div>
        <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-constival-teal/20 blur-3xl rounded-full"></div>
      </div>
    </div>
  </div>
</section>
