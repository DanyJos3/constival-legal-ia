---
/**
 * Hero premium legal-tech para landing SAS Ecuador (mockup: dos columnas, tema oscuro).
 */
const waHref =
  "https://wa.me/593969503502?text=" +
  encodeURIComponent(
    "Hola CONSTIVAL, quiero información para crear mi SAS en Ecuador.",
  );
---

<section
  id="inicio"
  class="relative min-h-[min(100svh,880px)] flex items-center overflow-hidden bg-white dark:bg-[#0a0c10] pt-24 pb-14 md:pt-28 md:pb-20 transition-colors duration-300"
  aria-labelledby="sas-ecuador-hero-heading"
  <!-- Ambiente -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(0,255,178,0.12),transparent)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-24 top-1/4 h-[420px] w-[420px] rounded-full bg-constival-teal/20 blur-[100px]"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-12 px-6 md:px-12 lg:px-16 lg:flex-row lg:items-center lg:gap-14 xl:gap-20"
  >
    <!-- Columna izquierda -->
    <div class="w-full flex-1 lg:max-w-xl xl:max-w-136">
      <span
        class="mb-6 inline-block rounded-lg bg-constival-mint px-3 py-1.5 font-sans text-[10px] font-extrabold uppercase tracking-[0.2em] text-constival-navy sm:text-xs"
      >
        Legal-tech premium
      </span>

      <h1
        id="sas-ecuador-hero-heading"
        class="font-sans text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter leading-none text-constival-navy dark:text-white"
      >
        <span class="block">Crea tu SAS en</span>
        <span class="mt-1 block text-constival-mint sm:mt-2">
          Ecuador: 100% Digital
        </span>
      </h1>

      <p
        class="mt-6 max-w-xl font-sans text-base sm:text-lg leading-relaxed text-constival-navy dark:text-slate-400"
      >
        Constitución inteligente desde <strong class="font-bold text-constival-navy dark:text-white">$149</strong>. Sin notarías, sin burocracia, sin capital mínimo. La nueva era legal para emprendedores.
      </p>

      <div
        class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center"
      >
        <a
          href="/#auditor-riesgos"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-constival-mint px-6 py-3.5 font-sans text-xs font-bold uppercase tracking-wider text-constival-navy shadow-[4px_4px_0px_rgba(0,0,0,0.08)] transition-all hover:translate-y-0.5 hover:shadow-none"
        >
          Analiza tu riesgo
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href={waHref}
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-constival-navy/10 dark:border-white/10 bg-[#f7fafc] dark:bg-[#1a1d23] px-6 py-3.5 font-sans text-xs font-bold uppercase tracking-wider text-constival-navy dark:text-white transition-colors hover:border-constival-mint/40 hover:text-constival-mint"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path></svg
          >
          WhatsApp
        </a>
      </div>
    </div>

    <!-- Columna derecha -->
    <div class="relative w-full flex-1 lg:max-w-2xl xl:max-w-2xl">
      <div
        class="relative aspect-[4/5] max-h-[min(340px,40svh)] w-full max-w-[340px] sm:max-w-[380px] md:max-w-[420px] lg:max-w-[480px] xl:max-w-[520px] overflow-hidden rounded-xl border border-constival-navy/10 dark:border-white/10 shadow-[0_24px_80px_-12px_rgba(0,0,0,0.15)] bg-white dark:bg-[#181c23] mx-auto"
      >
        <img
          src="/images/sas-ecuador-hero.jpg"
          alt="Ambiente corporativo moderno — constitución SAS digital en Ecuador"
          width="500"
          height="500"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover grayscale contrast-125"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#0a0c10]/80 via-transparent to-transparent dark:from-[#0a0c10]/80 from-white/80"
          aria-hidden="true"
        >
        </div>
      </div>

      <!-- Tarjeta flotante -->
      <div
        class="absolute -bottom-2 left-4 right-4 z-10 flex max-w-sm items-center gap-3 rounded-xl border border-constival-navy/10 dark:border-white/10 bg-[#f7fafc]/95 dark:bg-[#1a1d23]/95 p-4 shadow-xl backdrop-blur-md sm:left-6 sm:bottom-6 sm:right-auto"
      >
        <div
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-constival-mint/20"
          aria-hidden="true"
        >
          <svg
            class="h-6 w-6 text-constival-mint"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            ></path>
          </svg>
        </div>
        <div class="min-w-0">
          <p
            class="font-sans text-[10px] font-bold uppercase tracking-widest text-constival-navy dark:text-slate-400"
          >
            Estado de trámite
          </p>
          <p class="font-sans text-base font-extrabold text-constival-navy dark:text-white">
            100% Completado
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
