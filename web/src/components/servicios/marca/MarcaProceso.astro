---
const fases = [
  {
    num: "01",
    label: "Fase 1",
    title: "Contacto y Cotización",
    desc: "Nos envías los datos de tu marca: nombre/logo, sector y descripción de productos o servicios. Recibes cotización fija en el día.",
  },
  {
    num: "02",
    label: "Fase 2",
    title: "Búsqueda de Anterioridades",
    desc: "Realizamos búsqueda fonética y visual en la base de datos del SENADI para detectar marcas idénticas o confundibles. Este paso previene rechazos y oposiciones. Resultado en 2–5 días.",
  },
  {
    num: "03",
    label: "Fase 3",
    title: "Preparación y Presentación de Solicitud",
    desc: "Elaboramos el formulario con descripción del signo, reproducción de la marca, clase Niza y lista de productos/servicios. Presentamos y pagamos las tasas ante el SENADI vía casillero virtual.",
  },
  {
    num: "04",
    label: "Fase 4",
    title: "Examen de Forma y Publicación en Gaceta",
    desc: "SENADI verifica que la solicitud cumple requisitos formales (15 días hábiles). Si hay observaciones, subsanamos. Una vez aprobada, la marca se publica en la Gaceta de Propiedad Intelectual por 30 días para posibles oposiciones.",
  },
  {
    num: "05",
    label: "Fase 5",
    title: "Examen de Fondo y Resolución",
    desc: "SENADI analiza la registrabilidad: prohibiciones absolutas (marcas genéricas, contrarias al orden público) y relativas (confundibilidad con marcas anteriores). Plazo máximo: 6 meses. Gestionamos cualquier recurso si aplica.",
  },
  {
    num: "06",
    label: "Fase 6",
    title: "Emisión del Título de Registro",
    desc: "SENADI emite el título de registro con firma digital. Tendrás protección exclusiva de tu marca en Ecuador por 10 años, renovable sin prueba de uso. Recibes la carpeta digital completa.",
  },
];
---

<section id="proceso-marca" class="py-14 md:py-20 bg-white dark:bg-constival-navy overflow-hidden relative transition-colors duration-300">
  <div class="absolute inset-0 opacity-[0.02] dark:opacity-[0.04]" style="background-image: linear-gradient(rgba(0,255,178,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,178,0.3) 1px, transparent 1px); background-size: 60px 60px;"></div>
  <div class="absolute right-0 top-1/4 w-[400px] h-[400px] bg-constival-teal/10 dark:bg-constival-teal/20 blur-[150px] rounded-full pointer-events-none"></div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-12 md:mb-16">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint border-l-4 border-constival-teal dark:border-constival-mint mb-4 sm:mb-5 font-sans font-bold tracking-widest uppercase text-badge">
        ¿Cómo funciona?
      </span>
      <h2 class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight leading-[1.1]">
        Proceso completo de registro: <span class="text-constival-mint">6 fases ante el SENADI</span>
      </h2>
      <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 mt-4 max-w-xl mx-auto">
        Nos encargamos de cada etapa. Tú solo apruebas y firmas. Actualizaciones constantes vía WhatsApp.
      </p>
    </div>

    <!-- MOBILE TIMELINE -->
    <div class="md:hidden relative">
      <div class="absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-constival-mint/50 via-constival-teal/30 to-transparent"></div>
      <div class="space-y-10 pl-14">
        {fases.map((fase) => (
          <div class="relative">
            <div class="absolute -left-[3.25rem] top-0 w-10 h-10 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30">
              <span class="font-sans font-black text-sm text-constival-mint">{fase.num}</span>
            </div>
            <span class="inline-block font-sans text-fine font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1">{fase.label}</span>
            <h3 class="font-sans text-feature-title font-bold text-constival-navy dark:text-white mb-1">{fase.title}</h3>
            <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">{fase.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- DESKTOP ZIGZAG -->
    <div class="hidden md:block relative">
      <div class="absolute left-1/2 -translate-x-px top-0 bottom-0 w-px bg-gradient-to-b from-constival-mint/60 via-constival-teal/30 to-transparent"></div>
      <div class="space-y-0">
        {fases.map((fase, index) => {
          const isLeft = index % 2 === 0;
          return (
            <div class="relative flex items-center min-h-[180px]">
              {isLeft ? (
                <>
                  <div class="w-1/2 pr-12 lg:pr-16 text-right">
                    <span class="inline-block font-sans text-fine font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1.5">{fase.label}</span>
                    <h3 class="font-sans text-feature-title font-bold text-constival-navy dark:text-white mb-2">{fase.title}</h3>
                    <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">{fase.desc}</p>
                  </div>
                  <div class="absolute left-1/2 -translate-x-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center z-10 bg-white dark:bg-constival-navy border-2 border-constival-mint shadow-[0_0_20px_rgba(0,255,178,0.15)] transition-all duration-300 hover:scale-110 hover:bg-constival-mint hover:shadow-[0_0_30px_rgba(0,255,178,0.35)] hover:rotate-3 group cursor-pointer">
                    <span class="font-sans font-black text-xl lg:text-2xl text-constival-mint transition-colors duration-300 group-hover:text-constival-navy">{fase.num}</span>
                  </div>
                  <div class="w-1/2 pl-12 lg:pl-16"></div>
                </>
              ) : (
                <>
                  <div class="w-1/2 pr-12 lg:pr-16"></div>
                  <div class="absolute left-1/2 -translate-x-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center z-10 bg-white dark:bg-constival-navy border-2 border-constival-mint/50 shadow-[0_0_20px_rgba(0,255,178,0.1)] transition-all duration-300 hover:scale-110 hover:bg-constival-mint hover:border-constival-mint hover:shadow-[0_0_30px_rgba(0,255,178,0.35)] hover:-rotate-3 group cursor-pointer">
                    <span class="font-sans font-black text-xl lg:text-2xl text-constival-mint transition-colors duration-300 group-hover:text-constival-navy">{fase.num}</span>
                  </div>
                  <div class="w-1/2 pl-12 lg:pl-16">
                    <span class="inline-block font-sans text-fine font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1.5">{fase.label}</span>
                    <h3 class="font-sans text-feature-title font-bold text-constival-navy dark:text-white mb-2">{fase.title}</h3>
                    <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">{fase.desc}</p>
                  </div>
                </>
              )}
            </div>
          );
        })}
      </div>
    </div>

    <div class="mt-10 md:mt-14 flex flex-wrap justify-center gap-4">
      <div class="inline-flex items-center gap-3 px-5 py-3 bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/20">
        <svg class="w-5 h-5 text-constival-mint shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span class="font-sans font-bold text-body text-constival-navy dark:text-white">Tiempo total estimado: <span class="text-constival-mint">6 a 12 meses</span></span>
      </div>
      <div class="inline-flex items-center gap-3 px-5 py-3 bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/20">
        <svg class="w-5 h-5 text-constival-mint shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
        <span class="font-sans font-bold text-body text-constival-navy dark:text-white">Actualizaciones: <span class="text-constival-mint">WhatsApp en cada fase</span></span>
      </div>
    </div>
  </div>
</section>
