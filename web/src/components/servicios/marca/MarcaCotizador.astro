---
---

<section
  id="cotizador-marca"
  class="py-20 md:py-28 bg-gradient-to-br from-constival-navy via-[#061021] to-constival-teal/90 relative overflow-hidden transition-colors duration-300 scroll-mt-20"
>
  <div class="absolute top-1/4 -right-20 w-[500px] h-[500px] bg-constival-mint/20 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-constival-mint/30 to-transparent"></div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-16 md:mb-20">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-mint/10 text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-6 border-l-4 border-constival-mint backdrop-blur-sm">
        Presupuesto Inmediato
      </span>
      <h2 class="font-sans text-section-title font-black text-white tracking-tight drop-shadow-lg leading-tight">
        Cotiza el Registro de tu Marca <br class="hidden sm:block" />
        <span class="text-constival-mint">ante el SENADI</span>
      </h2>
      <p class="font-sans text-body md:text-xl text-slate-300 mt-6 max-w-2xl mx-auto leading-relaxed">
        Honorarios fijos sin sorpresas. Selecciona el servicio que necesitas.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- LEFT: Inclusions -->
      <div class="order-2 lg:order-1">
        <h3 class="font-sans text-card-title font-extrabold text-white mb-6 tracking-tight leading-tight">
          Todo lo que incluye el registro completo.
        </h3>
        <p class="font-sans text-body text-slate-300 mb-10 leading-relaxed border-l-[3px] border-constival-mint pl-5">
          Desde la búsqueda previa hasta la entrega del Título de Registro firmado digitalmente. Seguimiento en cada etapa.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-8">
          {[
            { title: "Búsqueda de anterioridades", desc: "Búsqueda fonética y visual en base SENADI para minimizar rechazos." },
            { title: "Solicitud ante SENADI", desc: "Elaboración y presentación vía casillero virtual oficial." },
            { title: "Clasificación Niza", desc: "Identificamos la clase correcta para tu producto o servicio." },
            { title: "Examen de forma y fondo", desc: "Gestión de observaciones y recursos durante el proceso." },
            { title: "Publicación en Gaceta", desc: "Seguimiento del período de oposiciones (30 días)." },
            { title: "Título de Registro", desc: "Entrega de la carpeta digital completa con el título oficial SENADI." },
          ].map((item) => (
            <div class="flex items-start gap-4">
              <div class="bg-constival-mint/20 p-2 rounded-md shrink-0">
                <svg class="w-5 h-5 text-constival-mint" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <h4 class="font-sans font-bold text-sm sm:text-base text-white">{item.title}</h4>
                <p class="font-sans text-sm text-slate-400 leading-relaxed mt-1">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- RIGHT: Widget -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div id="widget-cotizador-marca" class="relative bg-white text-constival-navy w-full max-w-md shadow-[0_25px_60px_-15px_rgba(0,0,0,0.5)] rounded-2xl overflow-hidden scroll-mt-24">

          <!-- Widget Header -->
          <div class="bg-constival-mint px-6 py-6 text-center border-b-[6px] border-[#1ebd5b]">
            <div class="text-4xl font-black text-constival-navy mb-1">®</div>
            <h3 class="font-sans text-2xl font-black text-constival-navy tracking-tight leading-none mb-1">
              Cotizador de Marca
            </h3>
            <p class="font-sans text-xs font-bold text-constival-navy/70 uppercase tracking-widest">
              SENADI Ecuador · Honorarios fijos
            </p>
          </div>

          <!-- Widget Body -->
          <div class="p-8 sm:p-10">
            <div id="m-step1">
              <span class="font-sans font-bold text-fine uppercase tracking-widest text-slate-400 block mb-6">Selecciona el servicio</span>
              <div class="flex flex-col gap-4">
                {[
                  {
                    id: "registro",
                    label: "Registro de Marca",
                    sub: "Solicitud completa + seguimiento + título",
                    precio: 295,
                    plazo: "6–12 meses",
                    badge: "Más solicitado",
                    highlight: true,
                    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
                  },
                  {
                    id: "renovacion",
                    label: "Renovación de Marca",
                    sub: "Antes del vencimiento a los 10 años",
                    precio: 199,
                    plazo: "3–6 meses",
                    badge: null,
                    highlight: false,
                    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
                  },
                  {
                    id: "busqueda",
                    label: "Solo Búsqueda Fonética",
                    sub: "Verificación de viabilidad sin solicitud",
                    precio: 29,
                    plazo: "2–5 días",
                    badge: null,
                    highlight: false,
                    icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
                  },
                ].map((op) => (
                  <button
                    class="m-servicio-btn group p-4 bg-slate-50 rounded-xl border-2 border-slate-200 hover:border-constival-mint hover:bg-white transition-all duration-300 text-left flex items-center gap-4 shadow-sm"
                    data-id={op.id}
                    data-label={op.label}
                    data-precio={op.precio}
                    data-plazo={op.plazo}
                  >
                    <div class={`w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${op.highlight ? "bg-constival-mint/20" : "bg-slate-200"}`}>
                      <svg class={`w-5 h-5 ${op.highlight ? "text-constival-navy" : "text-slate-600"}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={op.icon} />
                      </svg>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-sans text-base font-black text-constival-navy">{op.label}</span>
                        {op.badge && <span class="text-[10px] font-bold bg-constival-mint text-constival-navy px-2 py-0.5 rounded-sm uppercase tracking-wider">{op.badge}</span>}
                      </div>
                      <div class="font-sans text-sm text-slate-500 mt-0.5">{op.sub}</div>
                    </div>
                    <div class="font-sans text-lg font-black text-constival-navy shrink-0">${op.precio}</div>
                  </button>
                ))}
              </div>
            </div>

            <!-- Result -->
            <div id="m-result" class="hidden">
              <div class="flex items-center justify-between mb-8">
                <span class="font-sans font-black text-fine uppercase tracking-widest text-[#0a1818]">Tu Presupuesto</span>
                <span class="px-3 py-1 bg-constival-mint text-constival-navy rounded-sm font-sans font-bold text-xs uppercase tracking-widest" id="m-badge">Registro</span>
              </div>
              <div class="mb-8 p-6 bg-slate-50 border border-slate-200 rounded-xl text-center shadow-inner">
                <p class="font-sans text-sm font-bold text-slate-500 mb-2 uppercase tracking-wide">Honorarios Profesionales:</p>
                <div class="flex items-baseline justify-center gap-2">
                  <span class="font-sans text-6xl sm:text-7xl font-black text-constival-navy leading-none tracking-tight" id="m-price">$295</span>
                  <span class="font-sans text-base font-bold text-slate-400">+ IVA</span>
                </div>
              </div>
              <div class="grid grid-cols-3 gap-3 mb-8">
                <div class="bg-constival-navy text-white rounded-lg p-3 text-center shadow-md">
                  <div class="font-sans font-black text-lg text-constival-mint leading-none">®</div>
                  <div class="font-sans text-[10px] text-white/70 mt-1 uppercase tracking-wider font-bold">Ecuador</div>
                </div>
                <div class="bg-constival-navy text-white rounded-lg p-3 text-center shadow-md">
                  <div class="font-sans font-black text-base text-constival-mint leading-none" id="m-plazo">6-12 m.</div>
                  <div class="font-sans text-[10px] text-white/70 mt-1 uppercase tracking-wider font-bold">Estimado</div>
                </div>
                <div class="bg-constival-navy text-white rounded-lg p-3 text-center shadow-md">
                  <div class="font-sans font-black text-lg text-constival-mint leading-none">10</div>
                  <div class="font-sans text-[10px] text-white/70 mt-1 uppercase tracking-wider font-bold">Años</div>
                </div>
              </div>
              <div id="m-nota-tasas" class="hidden font-sans text-xs text-amber-600 mb-4 p-3 bg-amber-50 rounded-lg border border-amber-200 leading-relaxed">
                ⚠️ Los honorarios no incluyen las tasas del SENADI. Se detallan en la cotización formal antes de iniciar el trámite.
              </div>
              <div id="m-nota-busqueda" class="hidden font-sans text-xs text-blue-600 mb-4 p-3 bg-blue-50 rounded-lg border border-blue-200 leading-relaxed">
                ℹ️ La búsqueda fonética es el primer paso recomendado antes de solicitar el registro completo. Si decides continuar, el costo se descuenta del total.
              </div>
              <a
                id="m-whatsapp"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-[#25D366] hover:bg-[#1ebd5b] text-white font-sans font-black text-base uppercase tracking-wider transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] shadow-lg shadow-green-900/30 ring-4 ring-[#25D366]/20"
              >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
                INICIAR MI REGISTRO DE MARCA
              </a>
              <button class="mt-6 w-full font-sans text-xs font-bold text-slate-400 hover:text-constival-mint transition-colors underline underline-offset-4" id="m-restart">
                ← Ver otros servicios
              </button>
              <p class="font-sans text-fine text-slate-400 mt-5 text-center leading-relaxed">
                🔒 Honorarios fijos CONSTIVAL. Las tasas SENADI se detallan en cotización formal.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Service Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      serviceType: "Registro de Marca en Ecuador ante el SENADI",
      description: "Servicio integral de registro de marcas denominativas, mixtas y figurativas en Ecuador ante el Servicio Nacional de Derechos Intelectuales (SENADI), con búsqueda de anterioridades, seguimiento completo y obtención del título de registro.",
      provider: { "@type": "LegalService", name: "Constival Legal", url: "https://constival.com/" },
      areaServed: { "@type": "Country", name: "Ecuador" },
      offers: {
        "@type": "AggregateOffer",
        lowPrice: "29",
        highPrice: "295",
        priceCurrency: "USD",
        offerCount: "3",
        url: "https://constival.com/servicios/registro-marca-ecuador",
      },
    })} />
  </div>
</section>

<script>
  const s1 = document.getElementById("m-step1")!;
  const res = document.getElementById("m-result")!;

  document.querySelectorAll(".m-servicio-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const el = btn as HTMLElement;
      const id = el.dataset.id!;
      const label = el.dataset.label!;
      const precio = el.dataset.precio!;
      const plazo = el.dataset.plazo!;

      document.querySelectorAll(".m-servicio-btn").forEach((b) => b.classList.remove("border-constival-mint", "bg-constival-mint/5"));
      el.classList.add("border-constival-mint", "bg-constival-mint/5");

      setTimeout(() => {
        s1.classList.add("hidden");
        res.classList.remove("hidden");

        (document.getElementById("m-price") as HTMLElement).textContent = `$${precio}`;
        (document.getElementById("m-badge") as HTMLElement).textContent = label;
        (document.getElementById("m-plazo") as HTMLElement).textContent = plazo;

        (document.getElementById("m-nota-tasas") as HTMLElement).classList.toggle("hidden", id === "busqueda");
        (document.getElementById("m-nota-busqueda") as HTMLElement).classList.toggle("hidden", id !== "busqueda");

        const msg = `Hola CONSTIVAL, usé el cotizador de marca.\n\n*Servicio seleccionado:* ${label}\n*Honorario estimado:* $${precio} + IVA\n\nQuiero iniciar el proceso de registro de marca en Ecuador.`;
        const wa = document.getElementById("m-whatsapp") as HTMLAnchorElement;
        wa.href = `https://wa.me/593969503502?text=${encodeURIComponent(msg)}`;
      }, 200);
    });
  });

  document.getElementById("m-restart")?.addEventListener("click", () => {
    res.classList.add("hidden");
    s1.classList.remove("hidden");
    document.querySelectorAll(".m-servicio-btn").forEach((b) => b.classList.remove("border-constival-mint", "bg-constival-mint/5"));
  });
</script>
