---
const tipos = [
  {
    label: "Marca Denominativa",
    desc: "Solo texto: nombre comercial, eslogan o palabra(s). Ej: «CONSTIVAL», «EcuaFresh».",
    icon: "M4 6h16M4 12h16M4 18h7",
  },
  {
    label: "Marca Figurativa",
    desc: "Solo imagen o gráfico sin texto. Ej: el logo de Apple, la paloma de Twitter.",
    icon: "M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    label: "Marca Mixta",
    desc: "Combinación de texto + imagen/logo. La más común. Ej: nombre + isotipo con diseño particular.",
    icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
  },
  {
    label: "Marca Tridimensional",
    desc: "Forma o envase del producto (packaging). Ej: la botella de Coca-Cola, la forma de un chocolate.",
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
  },
  {
    label: "Marca Sonora",
    desc: "Melodía, jingle o sonido distintivo. Ej: el rugido de MGM, el sonido de Nokia.",
    icon: "M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3",
  },
  {
    label: "Marca de Certificación",
    desc: "Certifica que los productos/servicios cumplen estándares o normas específicas establecidas por el titular.",
    icon: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
  },
];
---

<section id="tipos-marca" class="py-14 md:py-16 bg-gray-50 dark:bg-[#090e1a] relative overflow-hidden transition-colors duration-300">
  <div class="absolute left-0 top-0 w-1/3 h-full bg-constival-blue/5 dark:bg-constival-blue/10 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10 md:mb-14">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint">
        Tipos de Marca · Clasificación COESCCI
      </span>
      <h2 class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight">
        ¿Qué tipo de marca <span class="text-constival-mint">vas a registrar?</span>
      </h2>
      <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
        El SENADI admite múltiples tipos de signos como marca. Todos se registran bajo el Código Orgánico de la Economía Social de los Conocimientos (COESCCI) y el Reglamento de Gestión de los Conocimientos.
      </p>
    </div>

    <!-- Tipos grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-5 mb-10">
      {tipos.map((tipo, i) => (
        <div class={`group bg-white dark:bg-constival-deep/60 p-5 border hover:border-constival-mint/40 transition-all duration-300 ${i === 2 ? "border-2 border-constival-mint shadow-[0_0_20px_rgba(0,255,178,0.08)]" : "border-constival-navy/10 dark:border-white/10"}`}>
          {i === 2 && (
            <div class="mb-3 inline-block px-2.5 py-1 bg-constival-mint text-constival-navy font-sans font-bold text-fine uppercase tracking-widest">
              La más común
            </div>
          )}
          <div class="w-9 h-9 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tipo.icon} />
            </svg>
          </div>
          <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-1.5">{tipo.label}</h3>
          <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">{tipo.desc}</p>
        </div>
      ))}
    </div>

    <!-- Clases NIZA box -->
    <div class="bg-constival-navy/5 dark:bg-constival-deep/60 border border-constival-navy/10 dark:border-white/10 p-6 md:p-8 max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row items-start gap-6">
        <div class="w-12 h-12 shrink-0 flex items-center justify-center bg-constival-mint text-constival-navy font-sans font-black text-xl">
          45
        </div>
        <div>
          <h3 class="font-sans font-extrabold text-card-title text-constival-navy dark:text-white mb-2 tracking-tight">
            Clasificación de Niza: 45 clases de productos y servicios
          </h3>
          <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed mb-4">
            Cada solicitud de marca protege <strong>una sola clase</strong> de la Clasificación Internacional de Niza. Si tu marca cubre múltiples sectores (ej. ropa y servicios de consultoría), necesitas una solicitud por cada clase que desees proteger.
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {[
              { clase: "Clase 35", desc: "Publicidad y servicios de negocios" },
              { clase: "Clase 36", desc: "Seguros y servicios financieros" },
              { clase: "Clase 41", desc: "Educación y entretenimiento" },
              { clase: "Clase 42", desc: "Servicios científicos y tecnológicos" },
              { clase: "Clase 45", desc: "Servicios jurídicos y de seguridad" },
              { clase: "Clases 1–34", desc: "Productos: alimentos, ropa, software, etc." },
            ].map((c) => (
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 text-constival-mint shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="font-sans text-body text-constival-navy/70 dark:text-slate-400"><strong class="text-constival-navy dark:text-white">{c.clase}:</strong> {c.desc}</span>
              </div>
            ))}
          </div>
          <p class="mt-4 font-sans text-fine text-constival-navy/50 dark:text-slate-500 italic">
            * Si no sabes qué clase te corresponde, en CONSTIVAL te asesoramos sin costo adicional.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
