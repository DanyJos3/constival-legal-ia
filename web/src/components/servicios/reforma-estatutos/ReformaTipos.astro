---

const tipos = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>`,
    num: "01",
    title: "Cambio de Denominación",
    desc: "Modificar el nombre comercial de tu empresa ante la SCVS y actualizar el RUC en el SRI.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>`,
    num: "02",
    title: "Cambio de Objeto Social",
    desc: "Ampliar, reducir o modificar las actividades económicas autorizadas a tu empresa.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
    num: "03",
    title: "Cambio de Domicilio",
    desc: "Trasladar la sede legal de tu empresa a otra ciudad o provincia del Ecuador.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
    num: "04",
    title: "Cambio de Plazos de Duración",
    desc: "Extender o reducir el plazo de vida jurídica establecido en los estatutos originales.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
    num: "05",
    title: "Aumento / Disminución de Capital",
    desc: "Modificar el capital integrado de la empresa. Requiere acta de asamblea y constancia de fondos.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>`,
    num: "06",
    title: "Cambio de Administración",
    desc: "Designar nuevo gerente, representante legal, directorio o comisarios ante la SCVS.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>`,
    num: "07",
    title: "Transformación Societaria",
    desc: "Convertir tu SAS en SA, Cía. Ltda. o viceversa. El proceso más complejo, hasta 9 semanas.",
    highlight: true,
  },
];
---

<section
  id="tipos-reforma"
  class="py-14 md:py-16 bg-gray-50 dark:bg-[#090e1a] relative overflow-hidden transition-colors duration-300"
>
  <div class="absolute left-0 top-0 w-1/3 h-full bg-constival-blue/5 dark:bg-constival-blue/10 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10 md:mb-14">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint">
        ¿Qué necesitas cambiar?
      </span>
      <h2 class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight">
        7 tipos de reforma societaria <span class="text-constival-mint">en Ecuador</span>
      </h2>
      <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
        No todas las reformas son iguales. Cada tipo tiene sus propios requisitos de quórum,
        plazos y documentación. Identificamos exactamente cuál aplica a tu empresa.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-5">
      {tipos.map((tipo) => (
        <div
          class={`group relative bg-white dark:bg-constival-deep/60 p-5 border transition-all duration-300 flex flex-col ${
            tipo.highlight
              ? "border-2 border-constival-mint shadow-[0_0_20px_rgba(0,255,178,0.08)]"
              : "border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/40"
          }`}
        >
          {tipo.highlight && (
            <div class="absolute -top-3.5 left-4 px-3 py-1 bg-constival-mint text-constival-navy font-sans font-bold text-fine uppercase tracking-widest">
              Más complejo
            </div>
          )}
          <div class="flex items-start gap-3 mb-3">
            <span class="font-sans font-black text-2xl text-constival-navy/10 dark:text-white/10 leading-none mt-1 shrink-0">
              {tipo.num}
            </span>
            <div class="w-9 h-9 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint shrink-0 group-hover:bg-constival-mint group-hover:text-constival-navy transition-colors duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={tipo.icon} />
            </div>
          </div>
          <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2 leading-tight">
            {tipo.title}
          </h3>
          <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed flex-1">
            {tipo.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="#precio-reforma"
        class="inline-flex items-center gap-2 font-sans font-bold text-body text-constival-teal dark:text-constival-mint hover:text-constival-blue transition-colors underline underline-offset-4"
      >
        Ver precios por tipo de reforma
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
