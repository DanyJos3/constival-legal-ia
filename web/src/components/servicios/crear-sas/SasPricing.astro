---
import Button from "../../ui/Button.astro";
---

<section
  id="precio-sas"
  class="py-14 md:py-16 bg-white dark:bg-constival-navy relative overflow-hidden transition-colors duration-300"
>
  <div
    class="absolute top-0 right-1/4 w-[300px] h-[300px] bg-constival-mint/5 dark:bg-constival-mint/10 blur-[100px] rounded-full pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10 md:mb-14">
      <span
        class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-xs sm:text-sm mb-4 border-l-4 border-constival-teal dark:border-constival-mint"
      >
        Inversión Transparente
      </span>
      <h2
        class="font-sans text-3xl sm:text-4xl 2xl:text-5xl font-extrabold text-constival-navy dark:text-white tracking-tight"
      >
        Honorarios Fijos. <span class="text-constival-mint">Cero Sorpresas.</span>
      </h2>
      <p
        class="font-sans text-base sm:text-lg text-constival-navy/70 dark:text-slate-400 mt-4 max-w-xl mx-auto leading-relaxed"
      >
        Nuestros precios son públicos y no cambian durante el proceso. Sin
        costos ocultos, sin facturar "por llamada".
      </p>
    </div>

    <!-- Single Premium Card -->
    <div class="max-w-2xl mx-auto">
      <div
        class="relative bg-white dark:bg-constival-deep/60 border-2 border-constival-mint shadow-[0_0_40px_rgba(0,255,178,0.08)] p-6 sm:p-8 md:p-10 overflow-hidden"
      >
        <!-- Popular badge -->
        <div
          class="absolute -top-4 left-8 px-4 py-1.5 bg-constival-mint text-constival-navy font-sans font-bold text-xs uppercase tracking-widest"
        >
          Paquete Fundación S.A.S.
        </div>

        <!-- Decorative -->
        <div
          class="absolute right-0 top-0 text-[10rem] font-sans font-black text-constival-navy/[0.02] dark:text-white/[0.02] leading-none select-none pointer-events-none translate-x-1/4 -translate-y-1/4"
        >
          $
        </div>

        <!-- Price -->
        <div class="mb-8 mt-4 sm:mt-2">
          <div class="flex items-baseline gap-2 mb-1">
            <span
              class="font-sans text-xs font-bold text-constival-navy/50 dark:text-slate-500 uppercase tracking-wider"
              >Desde</span
            >
          </div>
          <div class="flex items-baseline gap-2">
            <span
              class="font-sans text-5xl sm:text-6xl font-black text-constival-navy dark:text-white"
              >$149</span
            >
            <span
              class="font-sans text-sm sm:text-base font-bold text-constival-navy/70 dark:text-slate-500"
              >+ IVA</span
            >
          </div>
          <p
            class="font-sans text-xs sm:text-sm text-constival-navy/50 dark:text-slate-500 mt-2 leading-relaxed"
          >
            Cotizamos en función de la cantidad final de accionistas. No
            incluye aranceles registrales gubernamentales, los cuales
            desglosamos con total transparencia.
          </p>
        </div>

        <!-- Inclusions grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 mb-8">
          <div
            class="flex items-start gap-3 font-sans text-sm text-constival-navy/80 dark:text-slate-300 leading-snug"
          >
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Asesoría legal inicial personalizada
          </div>
          <div
            class="flex items-start gap-3 font-sans text-sm text-constival-navy/80 dark:text-slate-300 leading-snug"
          >
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Reserva de denominación social
          </div>
          <div
            class="flex items-start gap-3 font-sans text-sm text-constival-navy/80 dark:text-slate-300 leading-snug"
          >
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Elaboración de estatutos a medida
          </div>
          <div
            class="flex items-start gap-3 font-sans text-sm text-constival-navy/80 dark:text-slate-300 leading-snug"
          >
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Nombramientos de administración
          </div>
          <div
            class="flex items-start gap-3 font-sans text-sm text-constival-navy/80 dark:text-slate-300 leading-snug"
          >
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Inscripción ante Superintendencia (SCVS)
          </div>
          <div
            class="flex items-start gap-3 font-sans text-sm text-constival-navy/80 dark:text-slate-300 leading-snug"
          >
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Obtención de RUC ante el SRI
          </div>
          <div
            class="flex items-start gap-3 font-sans text-sm text-constival-navy/80 dark:text-slate-300 leading-snug"
          >
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Verificación de cumplimiento normativo
          </div>
          <div
            class="flex items-start gap-3 font-sans text-sm text-constival-navy/80 dark:text-slate-300 leading-snug"
          >
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            Entrega de documentación societaria completa
          </div>
        </div>

        <!-- CTA -->
        <Button variant="primary" href="https://wa.me/593969503502?text=Hola,%20quiero%20constituir%20mi%20SAS%20en%20Ecuador" class="w-full py-3.5 text-sm">
          Configurar mi Empresa
        </Button>
      </div>
    </div>
  </div>

  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Constitución de S.A.S. en Ecuador",
    "description": "Servicio de constitución de Sociedad por Acciones Simplificada 100% electrónica en Ecuador. Incluye asesoría, estatutos, inscripción SCVS y RUC.",
    "brand": {
      "@type": "Brand",
      "@id": "https://constival.com/#organization",
      "name": "Constival Legal"
    },
    "offers": {
      "@type": "Offer",
      "price": "149",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "url": "https://constival.com/servicios/crear-sas-ecuador"
    }
  })} />
</section>
