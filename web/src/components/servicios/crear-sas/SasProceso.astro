---

---

<section
  class="py-14 md:py-20 bg-white dark:bg-constival-navy overflow-hidden relative transition-colors duration-300"
>
  <!-- Ambient background -->
  <div
    class="absolute inset-0 opacity-[0.02] dark:opacity-[0.04]"
    style="background-image: linear-gradient(rgba(0,255,178,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,178,0.3) 1px, transparent 1px); background-size: 60px 60px;"
  >
  </div>
  <div
    class="absolute right-0 top-1/4 w-[400px] h-[400px] bg-constival-teal/10 dark:bg-constival-teal/20 blur-[150px] rounded-full pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <span
        class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint border-l-4 border-constival-teal dark:border-constival-mint mb-4 sm:mb-5 font-sans font-bold tracking-widest uppercase text-xs sm:text-sm"
      >
        ¿Cómo funciona?
      </span>
      <h2
        class="font-sans text-3xl sm:text-4xl 2xl:text-5xl font-extrabold text-constival-navy dark:text-white tracking-tight leading-[1.1]"
      >
        Tu empresa lista en <span class="text-constival-mint">5 pasos</span>
      </h2>
      <p
        class="font-sans text-base sm:text-lg text-constival-navy/60 dark:text-slate-400 mt-4 max-w-xl mx-auto"
      >
        Nosotros nos encargamos del 100% del trámite. Tú solo entregas los
        requisitos y firmas electrónicamente.
      </p>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- MOBILE TIMELINE (visible < md) -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="md:hidden relative">
      <!-- Vertical line -->
      <div
        class="absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-constival-mint/50 via-constival-teal/30 to-transparent"
      >
      </div>

      <div class="space-y-10 pl-14">
        <!-- Step 1 -->
        <div class="relative">
          <div
            class="absolute -left-[3.25rem] top-0 w-10 h-10 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30"
          >
            <span class="font-sans font-black text-sm text-constival-mint"
              >01</span
            >
          </div>
          <span
            class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1"
            >Día 1</span
          >
          <h3
            class="font-sans text-lg font-bold text-constival-navy dark:text-white mb-1"
          >
            Consulta y Asesoría Inicial
          </h3>
          <p
            class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
          >
            Evaluamos la viabilidad de tu proyecto, definimos el objeto social y
            te orientamos en materia fiscal y societaria.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative">
          <div
            class="absolute -left-[3.25rem] top-0 w-10 h-10 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30"
          >
            <span class="font-sans font-black text-sm text-constival-mint"
              >02</span
            >
          </div>
          <span
            class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1"
            >Día 1</span
          >
          <h3
            class="font-sans text-lg font-bold text-constival-navy dark:text-white mb-1"
          >
            Reserva de Denominación
          </h3>
          <p
            class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
          >
            Verificamos que el nombre de tu compañía sea único en el registro de
            la Superintendencia y aseguramos la reserva.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative">
          <div
            class="absolute -left-[3.25rem] top-0 w-10 h-10 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30"
          >
            <span class="font-sans font-black text-sm text-constival-mint"
              >03</span
            >
          </div>
          <span
            class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1"
            >Día 1-2</span
          >
          <h3
            class="font-sans text-lg font-bold text-constival-navy dark:text-white mb-1"
          >
            Preparación de Documentos
          </h3>
          <p
            class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
          >
            Redactamos el acta constitutiva con estatutos blindados, definimos la
            estructura accionaria y los nombramientos.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="relative">
          <div
            class="absolute -left-[3.25rem] top-0 w-10 h-10 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30"
          >
            <span class="font-sans font-black text-sm text-constival-mint"
              >04</span
            >
          </div>
          <span
            class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1"
            >Día 2-3</span
          >
          <h3
            class="font-sans text-lg font-bold text-constival-navy dark:text-white mb-1"
          >
            Inscripción ante SCVS
          </h3>
          <p
            class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
          >
            Enviamos toda la documentación electrónicamente a la Superintendencia
            de Compañías y damos seguimiento hasta la inscripción oficial.
          </p>
        </div>

        <!-- Step 5 -->
        <div class="relative">
          <div
            class="absolute -left-[3.25rem] top-0 w-10 h-10 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30"
          >
            <span class="font-sans font-black text-sm text-constival-mint"
              >05</span
            >
          </div>
          <span
            class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1"
            >Día 3</span
          >
          <h3
            class="font-sans text-lg font-bold text-constival-navy dark:text-white mb-1"
          >
            Obtención de RUC y Entrega
          </h3>
          <p
            class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
          >
            El SRI genera automáticamente el RUC. Te entregamos certificados y
            documentación societaria completa.
          </p>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- DESKTOP ZIGZAG TIMELINE (visible >= md) -->
    <!-- ═══════════════════════════════════════════════ -->
    <div class="hidden md:block relative">
      <!-- Central vertical line -->
      <div
        class="absolute left-1/2 -translate-x-px top-0 bottom-0 w-px bg-gradient-to-b from-constival-mint/60 via-constival-teal/30 to-transparent"
      >
      </div>

      <div class="space-y-0">
        <!-- ── STEP 01: LEFT ── -->
        <div class="relative flex items-center min-h-[180px]">
          <!-- Left content -->
          <div class="w-1/2 pr-12 lg:pr-16 text-right">
            <span
              class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1.5"
              >Día 1</span
            >
            <h3
              class="font-sans text-lg lg:text-xl font-bold text-constival-navy dark:text-white mb-2"
            >
              Consulta y Asesoría Inicial
            </h3>
            <p
              class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
            >
              Evaluamos la viabilidad de tu proyecto, definimos el objeto social
              más conveniente y te orientamos en materia fiscal y societaria.
            </p>
          </div>
          <!-- Center number -->
          <div
            class="absolute left-1/2 -translate-x-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center z-10 bg-white dark:bg-constival-navy border-2 border-constival-mint shadow-[0_0_20px_rgba(0,255,178,0.15)] cursor-pointer transition-all duration-300 hover:scale-110 hover:bg-constival-mint hover:shadow-[0_0_30px_rgba(0,255,178,0.35)] hover:rotate-3"
          >
            <span
              class="font-sans font-black text-xl lg:text-2xl text-constival-mint transition-colors duration-300 group-[]:text-constival-navy step-number"
              >01</span
            >
          </div>
          <!-- Right (empty) -->
          <div class="w-1/2 pl-12 lg:pl-16"></div>
        </div>

        <!-- ── STEP 02: RIGHT ── -->
        <div class="relative flex items-center min-h-[180px]">
          <!-- Left (empty) -->
          <div class="w-1/2 pr-12 lg:pr-16"></div>
          <!-- Center number -->
          <div
            class="absolute left-1/2 -translate-x-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center z-10 bg-white dark:bg-constival-navy border-2 border-constival-mint/50 shadow-[0_0_20px_rgba(0,255,178,0.1)] cursor-pointer transition-all duration-300 hover:scale-110 hover:bg-constival-mint hover:border-constival-mint hover:shadow-[0_0_30px_rgba(0,255,178,0.35)] hover:-rotate-3"
          >
            <span
              class="font-sans font-black text-xl lg:text-2xl text-constival-mint transition-colors duration-300 step-number"
              >02</span
            >
          </div>
          <!-- Right content -->
          <div class="w-1/2 pl-12 lg:pl-16">
            <span
              class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1.5"
              >Día 1</span
            >
            <h3
              class="font-sans text-lg lg:text-xl font-bold text-constival-navy dark:text-white mb-2"
            >
              Reserva de Denominación
            </h3>
            <p
              class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
            >
              Verificamos que el nombre de tu compañía sea único en el registro
              de la Superintendencia y aseguramos la reserva oficial.
            </p>
          </div>
        </div>

        <!-- ── STEP 03: LEFT ── -->
        <div class="relative flex items-center min-h-[180px]">
          <!-- Left content -->
          <div class="w-1/2 pr-12 lg:pr-16 text-right">
            <span
              class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1.5"
              >Día 1-2</span
            >
            <h3
              class="font-sans text-lg lg:text-xl font-bold text-constival-navy dark:text-white mb-2"
            >
              Preparación de Documentos
            </h3>
            <p
              class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
            >
              Redactamos el acta constitutiva con estatutos blindados a medida,
              definimos la estructura accionaria y los nombramientos de
              administración.
            </p>
          </div>
          <!-- Center number -->
          <div
            class="absolute left-1/2 -translate-x-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center z-10 bg-white dark:bg-constival-navy border-2 border-constival-mint/50 shadow-[0_0_20px_rgba(0,255,178,0.1)] cursor-pointer transition-all duration-300 hover:scale-110 hover:bg-constival-mint hover:border-constival-mint hover:shadow-[0_0_30px_rgba(0,255,178,0.35)] hover:rotate-3"
          >
            <span
              class="font-sans font-black text-xl lg:text-2xl text-constival-mint transition-colors duration-300 step-number"
              >03</span
            >
          </div>
          <!-- Right (empty) -->
          <div class="w-1/2 pl-12 lg:pl-16"></div>
        </div>

        <!-- ── STEP 04: RIGHT ── -->
        <div class="relative flex items-center min-h-[180px]">
          <!-- Left (empty) -->
          <div class="w-1/2 pr-12 lg:pr-16"></div>
          <!-- Center number -->
          <div
            class="absolute left-1/2 -translate-x-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center z-10 bg-white dark:bg-constival-navy border-2 border-constival-mint/50 shadow-[0_0_20px_rgba(0,255,178,0.1)] cursor-pointer transition-all duration-300 hover:scale-110 hover:bg-constival-mint hover:border-constival-mint hover:shadow-[0_0_30px_rgba(0,255,178,0.35)] hover:-rotate-3"
          >
            <span
              class="font-sans font-black text-xl lg:text-2xl text-constival-mint transition-colors duration-300 step-number"
              >04</span
            >
          </div>
          <!-- Right content -->
          <div class="w-1/2 pl-12 lg:pl-16">
            <span
              class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1.5"
              >Día 2-3</span
            >
            <h3
              class="font-sans text-lg lg:text-xl font-bold text-constival-navy dark:text-white mb-2"
            >
              Inscripción ante Superintendencia
            </h3>
            <p
              class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
            >
              Enviamos toda la documentación de forma electrónica a la SCVS. El
              equipo legal da seguimiento a la revisión hasta la inscripción
              oficial.
            </p>
          </div>
        </div>

        <!-- ── STEP 05: LEFT ── -->
        <div class="relative flex items-center min-h-[180px]">
          <!-- Left content -->
          <div class="w-1/2 pr-12 lg:pr-16 text-right">
            <span
              class="inline-block font-sans text-[10px] font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1.5"
              >Día 3</span
            >
            <h3
              class="font-sans text-lg lg:text-xl font-bold text-constival-navy dark:text-white mb-2"
            >
              Obtención de RUC y Entrega Final
            </h3>
            <p
              class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
            >
              El SRI genera automáticamente el RUC de tu empresa. Te entregamos
              todos los certificados y documentación societaria completa. ¡Lista
              para facturar!
            </p>
          </div>
          <!-- Center number -->
          <div
            class="absolute left-1/2 -translate-x-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center z-10 bg-white dark:bg-constival-navy border-2 border-constival-mint shadow-[0_0_20px_rgba(0,255,178,0.15)] cursor-pointer transition-all duration-300 hover:scale-110 hover:bg-constival-mint hover:shadow-[0_0_30px_rgba(0,255,178,0.35)] hover:rotate-3"
          >
            <span
              class="font-sans font-black text-xl lg:text-2xl text-constival-mint transition-colors duration-300 step-number"
              >05</span
            >
          </div>
          <!-- Right (empty) -->
          <div class="w-1/2 pl-12 lg:pl-16"></div>
        </div>
      </div>
    </div>

    <!-- Bottom badge -->
    <div class="mt-10 md:mt-14 flex justify-center">
      <div
        class="inline-flex items-center gap-3 px-5 py-3 bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/20"
      >
        <svg
          class="w-5 h-5 text-constival-mint shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
        >
        <span class="font-sans font-bold text-sm text-constival-navy dark:text-white"
          >Plazo total estimado:
          <span class="text-constival-mint">2 a 3 días hábiles</span></span
        >
      </div>
    </div>
  </div>
</section>

<style>
  /* Swap number text to navy when box fills with mint */
  div:hover > .step-number {
    color: #111622 !important;
  }
</style>
