---
const faqItems = [
  {
    q: "¿Qué es exactamente una S.A.S.?",
    a: "La Sociedad por Acciones Simplificada es la figura moderna ideal para emprendedores que buscan flexibilidad. Permite constituir la empresa incluso con un solo accionista, con objeto social amplio y eliminando trabas burocráticas de la compañía limitada."
  },
  {
    q: "¿Se exige un capital mínimo para constituir la empresa?",
    a: "No. A diferencia de las compañías tradicionales que obligan a depositar capitales de integración obligatorios antes de empezar, la SAS se puede constituir desde $1 en acciones, ajustando su nacimiento solo a las necesidades reales de tu negocio."
  },
  {
    q: "¿Puedo constituir una SAS si soy extranjero?",
    a: "Sí. Las S.A.S. en Ecuador permiten accionistas extranjeros sin restricciones. Diseñamos la estructura para que tu inversión opere legalmente bajo la normativa local, solo presentando la documentación de existencia legal o pasaporte pertinente."
  },
  {
    q: "¿Cuánto tiempo tarda el proceso completo?",
    a: "Entre 2 a 3 hábiles desde que tenemos la documentación completa y las firmas. Este es el tiempo real de elaboración, revisión y aprobación en la Superintendencia de Compañías para que tu empresa nazca formalmente."
  },
  {
    q: "¿El RUC se genera automáticamente?",
    a: "Sí. Al momento en que tu compañía quede inscrita formalmente en la Superintendencia de Compañías, el SRI detecta el trámite y genera automáticamente el Registro Único de Contribuyentes (RUC). Tu empresa sale lista para facturar."
  },
  {
    q: "¿Qué pasa si rechazan mis estatutos?",
    a: "Evitamos rechazos y requerimientos mediante diseño y diagnóstico previo. Si excepcionalmente existiese una observación de forma por el ente de control, nosotros reingresamos el trámite de inmediato sin cobrarte ningún honorario adicional. Exigimos confianza bidireccional."
  },
  {
    q: "¿Cuáles son los requisitos exactos para constituir mi empresa S.A.S.?",
    a: "Solo requerimos definir el objeto social corporativo, el capital inicial a integrar (desde $1), las cédulas o pasaportes de los accionistas, planilla de servicios básicos del domicilio y el certificado de firma electrónica (Archivo P12 o equivalente) del gerente para efectuar el registro online."
  },
  {
    q: "¿Qué obligaciones tributarias adquiero al crear la empresa?",
    a: "Una vez conste inscrita y tengas el RUC de la persona jurídica, deberás realizar las declaraciones mensuales y obligaciones contables dictaminadas por el SRI y responder anualmente con balances y nóminas a la Superintendencia de Compañías (SCVS)."
  },
];
---

<section
  class="py-14 md:py-16 bg-gray-50 dark:bg-[#090e1a] relative transition-colors duration-300"
  id="faq-sas"
>
  <div class="container mx-auto px-6 md:px-12 max-w-[900px] relative z-10">
    <div class="text-center mb-10">
      <span
        class="inline-block py-1.5 px-3 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint"
      >
        Preguntas Frecuentes
      </span>
      <h2
        class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight mb-2"
      >
        Respuestas sin <span class="text-constival-mint">tecnicismos.</span>
      </h2>
    </div>

    <div class="space-y-3" id="sas-faq-accordion">
      {
        faqItems.map((item) => (
          <div
            class="border border-constival-navy/5 dark:border-white/5 group"
            data-sas-faq-item
          >
            <button
              class="w-full flex items-center justify-between text-left p-4 md:p-5 font-sans font-bold text-body text-constival-navy dark:text-white hover:text-constival-mint dark:hover:text-constival-mint transition-colors"
              data-sas-faq-trigger
              aria-expanded="false"
            >
              <span class="pr-4">{item.q}</span>
              <svg
                class="w-5 h-5 shrink-0 text-constival-navy/30 dark:text-white/30 transition-transform duration-300 sas-faq-icon"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </button>
            <div
              class="overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out"
              data-sas-faq-content
            >
              <p class="px-4 md:px-5 pb-4 md:pb-5 font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">
                {item.a}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- FAQ Schema Markup -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
      publisher: {
        "@id": "https://constival.com/#organization",
      },
    })}
  />
</section>

<script>
  document.querySelectorAll("[data-sas-faq-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const item = (trigger as HTMLElement).closest("[data-sas-faq-item]")!;
      const content = item.querySelector(
        "[data-sas-faq-content]"
      ) as HTMLElement;
      const icon = item.querySelector(".sas-faq-icon") as HTMLElement;
      const isOpen = trigger.getAttribute("aria-expanded") === "true";

      // Close all others
      document.querySelectorAll("[data-sas-faq-item]").forEach((otherItem) => {
        if (otherItem !== item) {
          const otherContent = otherItem.querySelector(
            "[data-sas-faq-content]"
          ) as HTMLElement;
          const otherIcon = otherItem.querySelector(
            ".sas-faq-icon"
          ) as HTMLElement;
          const otherTrigger = otherItem.querySelector(
            "[data-sas-faq-trigger]"
          )!;
          otherContent.style.maxHeight = "0";
          otherIcon?.classList.remove("rotate-180");
          otherTrigger.setAttribute("aria-expanded", "false");
        }
      });

      if (isOpen) {
        content.style.maxHeight = "0";
        icon?.classList.remove("rotate-180");
        trigger.setAttribute("aria-expanded", "false");
      } else {
        content.style.maxHeight = content.scrollHeight + "px";
        icon?.classList.add("rotate-180");
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
