---

---

<section
  class="py-14 md:py-16 bg-gray-50 dark:bg-[#0a0f1a] relative overflow-hidden transition-colors duration-300"
>
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10 md:mb-14">
      <span
        class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint"
      >
        Documentación Necesaria
      </span>
      <h2
        class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight"
      >
        Requisitos para <span class="text-constival-mint">crear tu empresa (S.A.S.) en Ecuador.</span>
      </h2>
      <p
        class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed"
      >
        Todo lo demás lo hacemos nosotros. Sin papeleo innecesario, sin filas ni
        trámites presenciales.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5">
      <!-- Req 1 -->
      <div
        class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300"
      >
        <div
          class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"
            ></path></svg
          >
        </div>
        <h3
          class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2"
        >
          Cédula de Accionistas
        </h3>
        <p
          class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed"
        >
          Cédula de identidad o pasaporte de cada socio fundador.
        </p>
      </div>

      <!-- Req 2 -->
      <div
        class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300"
      >
        <div
          class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
            ></path></svg
          >
        </div>
        <h3
          class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2"
        >
          Denominación Social
        </h3>
        <p
          class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed"
        >
          El nombre elegido para tu compañía (verificaremos su disponibilidad).
        </p>
      </div>

      <!-- Req 3 -->
      <div
        class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300"
      >
        <div
          class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
          >
        </div>
        <h3
          class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2"
        >
          Domicilio Principal
        </h3>
        <p
          class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed"
        >
          Planilla de servicios básicos (agua o luz) del domicilio de la empresa.
        </p>
      </div>

      <!-- Req 4 -->
      <div
        class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300"
      >
        <div
          class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path></svg
          >
        </div>
        <h3
          class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2"
        >
          Capital Social
        </h3>
        <p
          class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed"
        >
          Monto del capital inicial en acciones (desde $1 en adelante).
        </p>
      </div>

      <!-- Req 5 -->
      <div
        class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300"
      >
        <div
          class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path></svg
          >
        </div>
        <h3
          class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2"
        >
          Objeto Social
        </h3>
        <p
          class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed"
        >
          Descripción de la actividad comercial de la empresa.
        </p>
      </div>

      <!-- Req 6 -->
      <div
        class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300"
      >
        <div
          class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path></svg
          >
        </div>
        <h3
          class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2"
        >
          Representante Legal
        </h3>
        <p
          class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed"
        >
          Cédula o pasaporte de quien será designado representante legal.
        </p>
      </div>

      <!-- Req 7 -->
      <div
        class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300 sm:col-span-2 lg:col-span-2"
      >
        <div
          class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
            ></path></svg
          >
        </div>
        <h3
          class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2"
        >
          Firma Electrónica (archivo .p12)
        </h3>
        <p
          class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed"
        >
          Certificado de firma electrónica de cada accionista. Si no tienes uno,
          te orientamos para obtenerlo de forma rápida.
        </p>
      </div>
    </div>
  </div>
</section>
