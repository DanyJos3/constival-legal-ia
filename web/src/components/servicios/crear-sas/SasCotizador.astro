---
import Button from "../../ui/Button.astro";
---

<section
  id="precio-sas"
  class="py-14 md:py-16 bg-gray-50 dark:bg-[#0a0f1a] relative overflow-hidden transition-colors duration-300"
>
  <div
    class="absolute top-0 right-1/4 w-[300px] h-[300px] bg-constival-mint/5 dark:bg-constival-mint/10 blur-[100px] rounded-full pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10 md:mb-14">
      <span
        class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-xs sm:text-sm mb-4 border-l-4 border-constival-teal dark:border-constival-mint"
      >
        Inversión Transparente
      </span>
      <h2
        class="font-sans text-3xl sm:text-4xl 2xl:text-5xl font-extrabold text-constival-navy dark:text-white tracking-tight"
      >
        Configura tu inversión. <span class="text-constival-mint">Sin sorpresas.</span>
      </h2>
      <p class="font-sans text-base md:text-lg text-constival-navy/60 dark:text-slate-400 mt-3 max-w-2xl mx-auto">
        Selecciona la cantidad de socios y obtén tu cotización al instante.
      </p>
    </div>

    <!-- Split Layout -->
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-start"
    >
      <!-- LEFT: Value proposition + Inclusions -->
      <div>
        <h3
          class="font-sans text-2xl sm:text-3xl font-extrabold text-constival-navy dark:text-white mb-4 tracking-tight leading-tight"
        >
          Nuestra Solución Integral
        </h3>
        <p
          class="font-sans text-base sm:text-lg text-constival-navy/70 dark:text-slate-400 mb-8 leading-relaxed border-l-[3px] border-constival-mint pl-4 sm:pl-5"
        >
          Olvídese de la burocracia. Nos encargamos de todo el ecosistema legal
          para que usted se enfoque en su negocio.
        </p>

        <!-- Inclusions Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
          <div class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            <div>
              <h4
                class="font-sans font-bold text-sm sm:text-base text-constival-navy dark:text-white"
              >
                Asesoría legal.
              </h4>
              <p
                class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
              >
                Consulta con expertos societarios.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            <div>
              <h4
                class="font-sans font-bold text-sm sm:text-base text-constival-navy dark:text-white"
              >
                Reserva de nombre.
              </h4>
              <p
                class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
              >
                Verificación en la SCVS.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            <div>
              <h4
                class="font-sans font-bold text-sm sm:text-base text-constival-navy dark:text-white"
              >
                Estatutos a medida.
              </h4>
              <p
                class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
              >
                Sin formatos genéricos de internet.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            <div>
              <h4
                class="font-sans font-bold text-sm sm:text-base text-constival-navy dark:text-white"
              >
                Nombramientos.
              </h4>
              <p
                class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
              >
                Registro de Representantes Legales.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            <div>
              <h4
                class="font-sans font-bold text-sm sm:text-base text-constival-navy dark:text-white"
              >
                Registro SCVS.
              </h4>
              <p
                class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
              >
                Inscripción electrónica completa.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-constival-mint mt-0.5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path></svg
            >
            <div>
              <h4
                class="font-sans font-bold text-sm sm:text-base text-constival-navy dark:text-white"
              >
                Obtención de RUC.
              </h4>
              <p
                class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 leading-relaxed"
              >
                Listo para facturar de inmediato.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Interactive Cotizador -->
      <div id="cotizador-interactivo" class="flex justify-center lg:justify-end scroll-mt-28 md:scroll-mt-32">
        <div
          class="relative bg-white dark:bg-constival-deep/60 border border-constival-navy/5 dark:border-white/5 p-6 sm:p-8 w-full max-w-sm shadow-xl transition-shadow duration-500 overflow-hidden"
        >
          <!-- Step 1: Select partners -->
          <div id="cotiz-step1">
            <div class="flex items-center justify-between mb-5">
              <span
                class="font-sans font-bold text-xs uppercase tracking-widest text-constival-navy/50 dark:text-slate-400"
                >Paso 1 de 2</span
              >
              <span
                class="px-3 py-1 bg-constival-mint text-constival-navy font-sans font-bold text-xs uppercase tracking-widest"
                >Cotizador</span
              >
            </div>

            <h4 class="font-sans text-base font-bold text-constival-navy dark:text-white mb-2">
              ¿Cuántos accionistas tendrá tu SAS?
            </h4>
            <p class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 mb-5">
              El precio varía según la cantidad de socios fundadores.
            </p>

            <div class="grid grid-cols-2 gap-3">
              <button
                class="cotiz-partner-btn group relative p-4 border border-constival-navy/10 dark:border-white/10 hover:border-constival-mint dark:hover:border-constival-mint transition-all duration-300 text-center"
                data-partners="1"
                data-price="149"
                data-label="1 Socio"
              >
                <div class="font-sans text-2xl font-black text-constival-navy dark:text-white group-hover:text-constival-mint transition-colors">1</div>
                <div class="font-sans text-xs text-constival-navy/50 dark:text-slate-400 mt-1">Unipersonal</div>
              </button>

              <button
                class="cotiz-partner-btn group relative p-4 border border-constival-navy/10 dark:border-white/10 hover:border-constival-mint dark:hover:border-constival-mint transition-all duration-300 text-center"
                data-partners="2-3"
                data-price="179"
                data-label="2-3 Socios"
              >
                <div class="font-sans text-2xl font-black text-constival-navy dark:text-white group-hover:text-constival-mint transition-colors">2-3</div>
                <div class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 mt-1">Socios</div>
              </button>

              <button
                class="cotiz-partner-btn group relative p-4 border border-constival-navy/10 dark:border-white/10 hover:border-constival-mint dark:hover:border-constival-mint transition-all duration-300 text-center"
                data-partners="4-6"
                data-price="219"
                data-label="4-6 Socios"
              >
                <div class="font-sans text-2xl font-black text-constival-navy dark:text-white group-hover:text-constival-mint transition-colors">4-6</div>
                <div class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 mt-1">Socios</div>
              </button>

              <button
                class="cotiz-partner-btn group relative p-4 border border-constival-navy/10 dark:border-white/10 hover:border-constival-mint dark:hover:border-constival-mint transition-all duration-300 text-center"
                data-partners="7+"
                data-price="249"
                data-label="7+ Socios"
              >
                <div class="font-sans text-2xl font-black text-constival-navy dark:text-white group-hover:text-constival-mint transition-colors">7+</div>
                <div class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 mt-1">Socios</div>
              </button>
            </div>
          </div>

          <!-- Step 2: Name reserved? -->
          <div id="cotiz-step2" class="hidden">
            <div class="flex items-center justify-between mb-5">
              <span
                class="font-sans font-bold text-xs uppercase tracking-widest text-constival-navy/50 dark:text-slate-400"
                >Paso 2 de 2</span
              >
              <button id="cotiz-back" class="font-sans text-xs text-constival-mint hover:underline">← Atrás</button>
            </div>

            <h4 class="font-sans text-base font-bold text-constival-navy dark:text-white mb-2">
              ¿Ya tienes nombre de empresa reservado?
            </h4>
            <p class="font-sans text-sm text-constival-navy/60 dark:text-slate-400 mb-5">
              Si no lo tienes, nosotros lo gestionamos sin costo adicional.
            </p>

            <div class="flex flex-col gap-3">
              <button
                class="cotiz-name-btn group p-4 border border-constival-navy/10 dark:border-white/10 hover:border-constival-mint dark:hover:border-constival-mint transition-all duration-300 text-left flex items-center gap-3"
                data-has-name="yes"
              >
                <div class="w-8 h-8 rounded-full bg-constival-mint/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <div>
                  <div class="font-sans text-sm font-bold text-constival-navy dark:text-white">Sí, ya lo tengo</div>
                  <div class="font-sans text-sm text-constival-navy/60 dark:text-slate-400">Tengo mi denominación aprobada</div>
                </div>
              </button>

              <button
                class="cotiz-name-btn group p-4 border border-constival-navy/10 dark:border-white/10 hover:border-constival-mint dark:hover:border-constival-mint transition-all duration-300 text-left flex items-center gap-3"
                data-has-name="no"
              >
                <div class="w-8 h-8 rounded-full bg-constival-mint/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                </div>
                <div>
                  <div class="font-sans text-sm font-bold text-constival-navy dark:text-white">No, necesito reservar</div>
                  <div class="font-sans text-sm text-constival-navy/60 dark:text-slate-400">Incluido en el servicio</div>
                </div>
              </button>
            </div>
          </div>

          <!-- Result Panel -->
          <div id="cotiz-result" class="hidden">
            <div class="flex items-center justify-between mb-5">
              <span
                class="font-sans font-bold text-xs uppercase tracking-widest text-constival-mint"
                >Tu Cotización</span
              >
              <span
                class="px-3 py-1 bg-constival-mint text-constival-navy font-sans font-bold text-xs uppercase tracking-widest"
                id="cotiz-badge">1 Socio</span
              >
            </div>

            <!-- Price display -->
            <div class="mb-5">
              <p class="font-sans text-sm text-constival-navy/50 dark:text-slate-400 mb-1">Tu inversión:</p>
              <div class="flex items-baseline gap-1.5">
                <span
                  class="font-sans text-5xl sm:text-6xl font-black text-constival-navy dark:text-white leading-none"
                  id="cotiz-price">$149</span
                >
                <span
                  class="font-sans text-sm font-bold text-constival-navy/50 dark:text-slate-400"
                  >+ IVA</span
                >
              </div>
            </div>

            <!-- Impact metrics -->
            <div class="grid grid-cols-3 gap-2 mb-5">
              <div class="bg-gray-50 dark:bg-[#0a1818] p-2.5 text-center">
                <div class="font-sans font-black text-lg text-constival-mint leading-none">3 días</div>
                <div class="font-sans text-xs text-constival-navy/50 dark:text-slate-400 mt-1 uppercase tracking-wider">Plazo</div>
              </div>
              <div class="bg-gray-50 dark:bg-[#0a1818] p-2.5 text-center">
                <div class="font-sans font-black text-lg text-constival-mint leading-none">$0</div>
                <div class="font-sans text-xs text-constival-navy/50 dark:text-slate-400 mt-1 uppercase tracking-wider">Sorpresas</div>
              </div>
              <div class="bg-gray-50 dark:bg-[#0a1818] p-2.5 text-center">
                <div class="font-sans font-black text-lg text-constival-mint leading-none">100%</div>
                <div class="font-sans text-xs text-constival-navy/50 dark:text-slate-400 mt-1 uppercase tracking-wider">Digital</div>
              </div>
            </div>

            <!-- WhatsApp CTA -->
            <a
              id="cotiz-whatsapp"
              href="#"
              target="_blank"
              class="w-full flex items-center justify-center gap-2.5 px-5 py-3.5 bg-[#25D366] hover:bg-[#1ebd5b] text-white font-sans font-bold text-sm uppercase tracking-wider transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-green-900/20"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Iniciar Constitución
            </a>

            <!-- Restart -->
            <button class="mt-4 w-full font-sans text-xs text-constival-navy/40 dark:text-slate-400 hover:text-constival-mint transition-colors underline underline-offset-4" id="cotiz-restart">
              ← Recalcular con otros datos
            </button>

            <!-- Fine print -->
            <p
              class="font-sans text-xs text-constival-navy/40 dark:text-slate-400 mt-4 text-center leading-relaxed"
            >
              Honorarios fijos. No incluye aranceles gubernamentales (SCVS, Registro Mercantil), los cuales desglosamos con transparencia antes de iniciar.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Service Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      serviceType: "Constitución de Empresas S.A.S. en Ecuador",
      description: "Servicio de constitución de Sociedad por Acciones Simplificada 100% electrónica en Ecuador. Incluye asesoría, estatutos, inscripción SCVS y RUC.",
      provider: {
        "@type": "LegalService",
        name: "Constival Legal",
        url: "https://constival.com/"
      },
      areaServed: {
        "@type": "Country",
        name: "Ecuador"
      },
      offers: {
        "@type": "AggregateOffer",
        lowPrice: "149",
        highPrice: "249",
        priceCurrency: "USD",
        offerCount: "4",
        url: "https://constival.com/servicios/crear-sas-ecuador"
      }
    })}
  />
</section>

<script>
  let selectedPartners = '';
  let selectedPrice = '';
  let selectedLabel = '';
  let hasName = '';

  const step1 = document.getElementById('cotiz-step1');
  const step2 = document.getElementById('cotiz-step2');
  const result = document.getElementById('cotiz-result');

  // Step 1: Partner selection
  document.querySelectorAll('.cotiz-partner-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedPartners = (btn as HTMLElement).dataset.partners!;
      selectedPrice = (btn as HTMLElement).dataset.price!;
      selectedLabel = (btn as HTMLElement).dataset.label!;

      // Highlight selected
      document.querySelectorAll('.cotiz-partner-btn').forEach(b => {
        b.classList.remove('border-constival-mint', 'dark:border-constival-mint', 'bg-constival-mint/5');
      });
      btn.classList.add('border-constival-mint', 'dark:border-constival-mint', 'bg-constival-mint/5');

      // Transition to step 2
      setTimeout(() => {
        step1?.classList.add('hidden');
        step2?.classList.remove('hidden');
        (step2 as HTMLElement).style.animation = 'cotiz-slide 0.3s ease-out';
      }, 300);
    });
  });

  // Step 2: Name reservation
  document.querySelectorAll('.cotiz-name-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      hasName = (btn as HTMLElement).dataset.hasName!;

      // Highlight selected
      document.querySelectorAll('.cotiz-name-btn').forEach(b => {
        b.classList.remove('border-constival-mint', 'dark:border-constival-mint', 'bg-constival-mint/5');
      });
      btn.classList.add('border-constival-mint', 'dark:border-constival-mint', 'bg-constival-mint/5');

      // Show results
      setTimeout(() => {
        step2?.classList.add('hidden');
        result?.classList.remove('hidden');
        (result as HTMLElement).style.animation = 'cotiz-slide 0.3s ease-out';
        updateResult();
      }, 300);
    });
  });

  // Back button
  document.getElementById('cotiz-back')?.addEventListener('click', () => {
    step2?.classList.add('hidden');
    step1?.classList.remove('hidden');
  });

  // Restart
  document.getElementById('cotiz-restart')?.addEventListener('click', () => {
    selectedPartners = '';
    selectedPrice = '';
    selectedLabel = '';
    hasName = '';
    result?.classList.add('hidden');
    step1?.classList.remove('hidden');
    document.querySelectorAll('.cotiz-partner-btn, .cotiz-name-btn').forEach(b => {
      b.classList.remove('border-constival-mint', 'dark:border-constival-mint', 'bg-constival-mint/5');
    });
  });

  function updateResult() {
    // Update price
    const priceEl = document.getElementById('cotiz-price');
    if (priceEl) priceEl.textContent = `$${selectedPrice}`;

    // Update badge
    const badgeEl = document.getElementById('cotiz-badge');
    if (badgeEl) badgeEl.textContent = selectedLabel;

    // Build WhatsApp message
    const nameStatus = hasName === 'yes' ? 'Sí, ya tengo nombre reservado' : 'No, necesito reservar nombre';
    const waMessage = `Hola Constival, utilicé el cotizador de su web para Constitución de SAS.\n\n*Mi configuración:*\n- Accionistas: ${selectedLabel}\n- Nombre reservado: ${nameStatus}\n- Inversión estimada: $${selectedPrice} + IVA\n\nQuiero iniciar el proceso de constitución.`;

    const waBtn = document.getElementById('cotiz-whatsapp') as HTMLAnchorElement;
    if (waBtn) {
      waBtn.href = `https://wa.me/593969503502?text=${encodeURIComponent(waMessage)}`;
    }
  }
</script>

<style>
  @keyframes cotiz-slide {
    from { opacity: 0; transform: translateX(12px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>
