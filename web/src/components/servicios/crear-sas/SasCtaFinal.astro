---
import Button from "../../ui/Button.astro";
---

<section
  class="py-14 md:py-16 bg-constival-navy dark:bg-constival-navy relative overflow-hidden transition-colors duration-300"
>
  <!-- Ambient glow -->
  <div
    class="absolute top-0 left-1/3 w-[300px] h-[300px] bg-constival-mint/10 blur-[100px] rounded-full pointer-events-none"
  >
  </div>

  <div
    class="container mx-auto px-6 md:px-12 text-center max-w-3xl relative z-10"
  >
    <div
      class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-constival-mint/10 border border-constival-mint/20 mb-6"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-constival-mint opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-constival-mint"
        ></span>
      </span>
      <span
        class="text-fine font-bold font-sans text-constival-mint uppercase tracking-widest"
        >Asesoría inicial sin costo</span
      >
    </div>

    <h2
      class="font-sans text-section-title font-extrabold text-white mb-6 tracking-tight leading-tight"
    >
      Da el primer paso hoy. <br class="hidden sm:block" />
      <span class="text-constival-mint">Nosotros hacemos el resto.</span>
    </h2>
    <p
      class="font-sans text-body text-slate-400 mb-10 max-w-2xl mx-auto leading-relaxed"
    >
      Olvídate de la burocracia. Agenda una consulta gratuita y deja que nuestros expertos estructuren tu S.A.S. para que esté lista para facturar en solo 3 días hábiles.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <Button
        variant="primary"
        href="#cotizador-interactivo"
        class="px-8 py-3.5 text-sm w-full sm:w-auto"
        >Cotizar y ver precio exacto</Button
      >
      <Button
        variant="outline"
        href="https://wa.me/593969503502?text=Hola,%20tengo%20una%20duda%20sobre%20la%20constitución%20de%20SAS"
        class="px-8 py-3.5 text-sm w-full sm:w-auto border-white/20 text-white hover:border-constival-mint hover:text-constival-mint"
      >
        <svg class="w-5 h-5 mr-1 inline-block" fill="currentColor" viewBox="0 0 24 24"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path></svg
        >
        Tengo una duda específica
      </Button>
    </div>
  </div>
</section>
