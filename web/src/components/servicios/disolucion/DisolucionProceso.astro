---
---

<section id="proceso-disolucion" class="py-16 md:py-24 bg-white dark:bg-[#0a0f1a] transition-colors duration-300 relative">
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl">
    <div class="text-center mb-16 md:mb-20">
      <h2 class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight">
        El proceso de <span class="text-constival-blue dark:text-constival-mint">Disolución y Cancelación.</span>
      </h2>
      <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
        Un proceso ordenado y riguroso diseñado para protegerte legalmente y cerrar el ciclo corporativo sin dejar cabos sueltos.
      </p>
    </div>

    <div class="relative">
      <!-- Desktop vertical line -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-800 -translate-x-1/2"></div>
      
      <div class="space-y-12 md:space-y-0 relative">
        {[
          {
            step: "01",
            title: "Evaluación Inicial",
            desc: "Revisamos los estatutos y la situación contable de la empresa para definir si califica para un proceso Abreviado u Ordinario."
          },
          {
            step: "02",
            title: "Decisión Societaria",
            desc: "Redactamos y hacemos firmar el Acta de Junta Unánime aprobando la disolución, designando al liquidador y confirmando el estado de deudas."
          },
          {
            step: "03",
            title: "Documentación y Solicitud",
            desc: "Instrumentamos legalmente (documento privado o escritura pública) y enviamos la solicitud con habilitantes a la SUPERCIAS."
          },
          {
            step: "04",
            title: "Aprobación y Publicación",
            desc: "La Superintendencia emite la resolución. Si es proceso Ordinario, gestionamos los avisos para llamar a posibles acreedores."
          },
          {
            step: "05",
            title: "Liquidación",
            desc: "Pago secuencial de pasivos y distribución del haber social remanente entre los socios (Aplica principalmente para Ordinario)."
          },
          {
            step: "06",
            title: "Cancelación Registral",
            desc: "Inscripción en el Registro Mercantil/Sociedades, obteniendo la resolución final de cancelación para que puedas cerrar tu RUC."
          }
        ].map((item, index) => (
          <div class="relative md:h-48">
            <div class={`md:absolute md:top-1/2 md:-translate-y-1/2 w-full flex flex-col md:flex-row items-start md:items-center ${index % 2 === 0 ? 'md:justify-start' : 'md:justify-end'}`}>
              
              <!-- Content box -->
              <div class={`w-full md:w-[45%] bg-gray-50 dark:bg-[#121826] p-6 sm:p-8 rounded-2xl border border-constival-navy/5 dark:border-white/5 relative z-10 hover:border-constival-mint/30 transition-colors ${index % 2 === 0 ? 'md:pr-12' : 'md:pl-12'}`}>
                <div class="flex items-baseline gap-3 mb-3">
                  <span class="font-sans text-3xl font-black text-constival-teal/20 dark:text-constival-mint/20">{item.step}</span>
                  <h3 class="font-sans text-xl font-bold text-constival-navy dark:text-white">{item.title}</h3>
                </div>
                <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed">{item.desc}</p>
              </div>

              <!-- Node -->
              <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white dark:bg-[#0a0f1a] border-4 border-slate-200 dark:border-slate-800 items-center justify-center z-20 shadow-[0_0_0_4px_rgba(255,255,255,1)] dark:shadow-[0_0_0_4px_#0a0f1a]">
                <div class="w-3 h-3 rounded-full bg-constival-teal dark:bg-constival-mint"></div>
              </div>
              
              <!-- Connector line (mobile) -->
              <div class="md:hidden absolute left-6 top-[100%] bottom-[-3rem] w-0.5 bg-slate-200 dark:bg-slate-800 last:hidden z-0"></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
