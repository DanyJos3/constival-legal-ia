---
---

<section class="py-16 md:py-24 bg-gray-50 dark:bg-[#0a0f1a] relative border-t border-constival-navy/5 dark:border-white/5 transition-colors duration-300">
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-12 md:mb-16">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint">
        Cobertura 360°
      </span>
      <h2 class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight">
        ¿Qué incluye el <span class="text-constival-mint">servicio?</span>
      </h2>
      <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
        Nos encargamos de todo el proceso de principio a fin, para que no tengas que preocuparte por trámites burocráticos ni idas a la Superintendencia.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {[
        {
          title: "Evaluación Preliminar",
          desc: "Consulta inicial gratuita para evaluar la causal de disolución y determinar la vía (Abreviada u Ordinaria).",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>`
        },
        {
          title: "Redacción de Actas",
          desc: "Elaboración profesional del acta de junta general unánime, fundamental para el inicio legal del cierre.",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>`
        },
        {
          title: "Instrumentación Legal",
          desc: "Preparación de la documentación notarial requerida (escritura pública o documento privado según aplique).",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>`
        },
        {
          title: "Gestión en SUPERCIAS",
          desc: "Solicitud, seguimiento, obtención de resolución y publicación (si aplica) directamente en la plataforma.",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>`
        },
        {
          title: "Registro Registral",
          desc: "Inscripción en el Registro Mercantil o Registro de Sociedades correspondientes y obtención de la razón de inscripción.",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>`
        },
        {
          title: "Asesoría Post-Cancelación",
          desc: "Guía paso a paso para la actualización y cierre definitivo del RUC ante el SRI.",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>`
        }
      ].map((feature) => (
        <div class="bg-white dark:bg-constival-deep/50 p-8 border border-constival-navy/5 dark:border-white/5 hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] dark:hover:shadow-[0_20px_40px_-15px_rgba(0,255,178,0.05)] transition-all duration-300">
          <div class="w-12 h-12 mb-6 bg-constival-mint/10 dark:bg-constival-mint/20 rounded-xl flex items-center justify-center text-constival-mint">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={feature.icon} />
          </div>
          <h3 class="font-sans text-card-title font-bold text-constival-navy dark:text-white mb-3">{feature.title}</h3>
          <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
