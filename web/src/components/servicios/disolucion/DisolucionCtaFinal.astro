---
import Button from "../../ui/Button.astro";
---

<section class="py-20 md:py-32 bg-constival-navy relative overflow-hidden transition-colors duration-300">
  <!-- Background Elements -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-constival-teal/20 blur-[120px] rounded-full mix-blend-screen"></div>
  </div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-4xl relative z-10 text-center">
    <span class="inline-block py-1.5 px-3 bg-white/10 text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-6 rounded-full border border-white/20 backdrop-blur-sm">
      Consulta Inicial Gratuita
    </span>
    
    <h2 class="font-sans text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6 leading-tight">
      Evite responsabilidades y deudas innecesarias.
    </h2>
    
    <p class="font-sans text-xl md:text-2xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed">
      Inicie la disolución de su compañía hoy mismo con expertos societarios.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button 
        variant="primary" 
        href="https://wa.me/593969503502?text=Hola%20Constival%2C%20deseo%20una%20consulta%20gratuita%20sobre%20c%C3%B3mo%20disolver%20y%20cerrar%20mi%20empresa." 
        class="w-full sm:w-auto text-lg px-8 py-4 shadow-[0_0_40px_rgba(0,255,178,0.3)] hover:shadow-[0_0_60px_rgba(0,255,178,0.5)]"
      >
        <svg class="w-6 h-6 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
        Hablar con un asesor
      </Button>
    </div>
  </div>
</section>
