---
const faqItems = [
  {
    q: "¿Puedo disolver mi empresa si tiene deudas pendientes?",
    a: "No en proceso abreviado. Si existen deudas con terceros, aplicamos el proceso ordinario que incluye nombramiento de liquidador, aviso a acreedores y pago secuencial de obligaciones antes de la cancelación registral."
  },
  {
    q: "¿Cuál es la diferencia entre disolver una SAS y una S.A. o Cía. Ltda.?",
    a: "La S.A.S. permite realizar la disolución mediante documento privado (sin notaría), lo que abarata y agiliza el proceso. Las Sociedades Anónimas y Compañías de Responsabilidad Limitada requieren escritura pública notarial, lo que implica costos adicionales de protocolización."
  },
  {
    q: "¿Qué pasa si aparece una deuda después de la cancelación?",
    a: "Esta es la razón más importante para trabajar con especialistas. Si post-cancelación aparece una deuda no declarada, socios y representante legal responden ilimitada y solidariamente con su patrimonio personal. En CONSTIVAL verificamos exhaustivamente antes de suscribir cualquier declaración."
  },
  {
    q: "¿Es posible reactivar la empresa una vez iniciado el proceso?",
    a: "Sí, mientras la empresa no haya sido formalmente cancelada en el Registro Mercantil, existe la posibilidad de reactivación mediante trámite ante SUPERCIAS. Una vez inscrita la cancelación, el proceso es irreversible."
  },
  {
    q: "¿Necesito que todos los socios estén presentes en la junta?",
    a: "Para el proceso abreviado se requiere unanimidad de todos los socios. Pueden participar personalmente o mediante apoderado con poder notarial debidamente conferido. En proceso ordinario las mayorías varían según el tipo de empresa."
  },
  {
    q: "¿Cuánto tiempo tarda el proceso completo?",
    a: "El proceso abreviado toma entre 3 y 8 semanas hábiles desde que tenemos toda la documentación completa. El proceso ordinario puede extenderse entre 2 y 6 meses dependiendo de la complejidad de la liquidación y los tiempos de SUPERCIAS."
  },
  {
    q: "¿Qué incluye el servicio de CONSTIVAL exactamente?",
    a: "Incluye consulta inicial gratuita, evaluación del caso, redacción del acta de junta, preparación de toda la documentación, presentación y seguimiento ante SUPERCIAS, inscripción en el Registro Mercantil y asesoría post-cancelación para la actualización del RUC ante el SRI."
  },
];
---

<section
  class="py-14 md:py-16 bg-gray-50 dark:bg-[#090e1a] relative transition-colors duration-300"
  id="faq-disolucion"
>
  <div class="container mx-auto px-6 md:px-12 max-w-[900px] relative z-10">
    <div class="text-center mb-10">
      <span
        class="inline-block py-1.5 px-3 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint"
      >
        Preguntas Frecuentes
      </span>
      <h2
        class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight mb-2"
      >
        Respuestas sin <span class="text-constival-mint">tecnicismos.</span>
      </h2>
    </div>

    <div class="space-y-3" id="disol-faq-accordion">
      {
        faqItems.map((item) => (
          <div
            class="border border-constival-navy/5 dark:border-white/5 group"
            data-disol-faq-item
          >
            <button
              class="w-full flex items-center justify-between text-left p-4 md:p-5 font-sans font-bold text-body text-constival-navy dark:text-white hover:text-constival-mint dark:hover:text-constival-mint transition-colors"
              data-disol-faq-trigger
              aria-expanded="false"
            >
              <span class="pr-4">{item.q}</span>
              <svg
                class="w-5 h-5 shrink-0 text-constival-navy/30 dark:text-white/30 transition-transform duration-300 disol-faq-icon"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              class="overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out"
              data-disol-faq-content
            >
              <p class="px-4 md:px-5 pb-4 md:pb-5 font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">
                {item.a}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- FAQ Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
      publisher: {
        "@id": "https://constival.com/#organization",
      },
    })}
  />
</section>

<script>
  document.querySelectorAll("[data-disol-faq-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const item = (trigger as HTMLElement).closest("[data-disol-faq-item]")!;
      const content = item.querySelector("[data-disol-faq-content]") as HTMLElement;
      const icon = item.querySelector(".disol-faq-icon") as HTMLElement;
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      document.querySelectorAll("[data-disol-faq-item]").forEach((other) => {
        if (other !== item) {
          const oc = other.querySelector("[data-disol-faq-content]") as HTMLElement;
          const oi = other.querySelector(".disol-faq-icon") as HTMLElement;
          const ot = other.querySelector("[data-disol-faq-trigger]")!;
          oc.style.maxHeight = "0";
          oi?.classList.remove("rotate-180");
          ot.setAttribute("aria-expanded", "false");
        }
      });
      if (isOpen) {
        content.style.maxHeight = "0";
        icon?.classList.remove("rotate-180");
        trigger.setAttribute("aria-expanded", "false");
      } else {
        content.style.maxHeight = content.scrollHeight + "px";
        icon?.classList.add("rotate-180");
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
