---
---

<section id="cotizador-interactivo" class="py-16 md:py-24 bg-[#0a0f1a] relative overflow-hidden transition-colors duration-300">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-constival-mint/10 blur-[100px] rounded-full mix-blend-screen translate-x-1/3 -translate-y-1/3"></div>
  </div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-12 md:mb-16">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-mint/10 text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-mint">
        Cotización Transparente
      </span>
      <h2 class="font-sans text-section-title font-extrabold text-white tracking-tight">
        Calcula tu <span class="text-constival-mint">inversión exacta.</span>
      </h2>
      <p class="font-sans text-body text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
        Honorarios fijos según el tipo de empresa y proceso. Sin costos ocultos.
      </p>
    </div>

    <div class="max-w-3xl mx-auto">
      <div class="bg-white rounded-2xl p-6 sm:p-8 md:p-10 shadow-2xl shadow-constival-navy/50 relative overflow-hidden min-h-[500px] flex flex-col">
        <div class="absolute top-0 left-0 w-full h-1.5 bg-slate-100">
          <div id="disol-progress-bar" class="h-full bg-constival-mint w-1/4 transition-all duration-500 ease-out"></div>
        </div>

        <div class="flex-1 flex flex-col relative">
          <!-- Step 1: Empresa -->
          <div id="disol-step-1" class="absolute inset-0 flex flex-col transition-all duration-500 ease-in-out">
            <div class="mb-8">
              <span class="font-sans font-bold text-constival-mint text-sm tracking-widest uppercase mb-2 block">Paso 1 de 3</span>
              <h3 class="font-sans text-2xl md:text-3xl font-extrabold text-constival-navy tracking-tight">
                ¿Qué tipo de empresa vas a disolver?
              </h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-auto">
              <button class="disol-btn group relative p-6 text-left border-2 border-slate-200 rounded-xl hover:border-constival-mint transition-all focus:outline-none" data-value="sas">
                <div class="w-10 h-10 rounded-full bg-slate-100 group-hover:bg-constival-mint/10 flex items-center justify-center mb-4 transition-colors">
                  <svg class="w-5 h-5 text-slate-400 group-hover:text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                </div>
                <h4 class="font-sans font-bold text-lg text-constival-navy mb-1">S.A.S.</h4>
                <p class="font-sans text-sm text-slate-500">Sociedad por Acciones Simplificada</p>
              </button>
              <button class="disol-btn group relative p-6 text-left border-2 border-slate-200 rounded-xl hover:border-constival-mint transition-all focus:outline-none" data-value="sa-crl">
                <div class="w-10 h-10 rounded-full bg-slate-100 group-hover:bg-constival-mint/10 flex items-center justify-center mb-4 transition-colors">
                  <svg class="w-5 h-5 text-slate-400 group-hover:text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                </div>
                <h4 class="font-sans font-bold text-lg text-constival-navy mb-1">S.A. / Cía. Ltda.</h4>
                <p class="font-sans text-sm text-slate-500">Sociedad Anónima o Limitada</p>
              </button>
            </div>
          </div>

          <!-- Step 2: Proceso -->
          <div id="disol-step-2" class="absolute inset-0 flex flex-col transition-all duration-500 ease-in-out translate-x-12 opacity-0 pointer-events-none">
            <div class="mb-8">
              <span class="font-sans font-bold text-constival-mint text-sm tracking-widest uppercase mb-2 block">Paso 2 de 3</span>
              <h3 class="font-sans text-2xl md:text-3xl font-extrabold text-constival-navy tracking-tight mb-2">
                ¿Qué proceso aplica?
              </h3>
              <button class="font-sans text-sm font-bold text-slate-400 hover:text-constival-navy flex items-center gap-1 transition-colors outline-none disol-back">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Volver
              </button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-auto">
              <button class="disol-btn group relative p-6 text-left border-2 border-slate-200 rounded-xl hover:border-constival-mint transition-all focus:outline-none" data-value="abreviado">
                <h4 class="font-sans font-bold text-lg text-constival-navy mb-1 group-hover:text-constival-teal transition-colors">Abreviado</h4>
                <p class="font-sans text-sm text-slate-500">Sin deudas con terceros. Unanimidad de socios.</p>
              </button>
              <button class="disol-btn group relative p-6 text-left border-2 border-slate-200 rounded-xl hover:border-constival-mint transition-all focus:outline-none" data-value="ordinario">
                <h4 class="font-sans font-bold text-lg text-constival-navy mb-1 group-hover:text-constival-teal transition-colors">Ordinario</h4>
                <p class="font-sans text-sm text-slate-500">Aún hay activos que liquidar o deudas pendientes.</p>
              </button>
            </div>
          </div>

          <!-- Step 3: Socios -->
          <div id="disol-step-3" class="absolute inset-0 flex flex-col transition-all duration-500 ease-in-out translate-x-12 opacity-0 pointer-events-none">
            <div class="mb-6">
              <span class="font-sans font-bold text-constival-mint text-sm tracking-widest uppercase mb-2 block">Paso 3 de 3</span>
              <h3 class="font-sans text-2xl md:text-3xl font-extrabold text-constival-navy tracking-tight mb-2">
                ¿Cuántos socios o accionistas tiene?
              </h3>
              <button class="font-sans text-sm font-bold text-slate-400 hover:text-constival-navy flex items-center gap-1 transition-colors outline-none disol-back">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Volver
              </button>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-auto">
              <button class="disol-btn group relative py-6 px-2 text-center border-2 border-slate-200 rounded-xl hover:border-constival-mint hover:bg-slate-50 transition-all focus:outline-none" data-value="1">
                <span class="font-sans font-black text-2xl text-constival-navy group-hover:text-constival-teal transition-colors">1</span>
                <span class="block font-sans text-xs text-slate-500 uppercase font-bold mt-1">Socio</span>
              </button>
              <button class="disol-btn group relative py-6 px-2 text-center border-2 border-slate-200 rounded-xl hover:border-constival-mint hover:bg-slate-50 transition-all focus:outline-none" data-value="2-3">
                <span class="font-sans font-black text-2xl text-constival-navy group-hover:text-constival-teal transition-colors">2-3</span>
                <span class="block font-sans text-xs text-slate-500 uppercase font-bold mt-1">Socios</span>
              </button>
              <button class="disol-btn group relative py-6 px-2 text-center border-2 border-slate-200 rounded-xl hover:border-constival-mint hover:bg-slate-50 transition-all focus:outline-none" data-value="4-6">
                <span class="font-sans font-black text-2xl text-constival-navy group-hover:text-constival-teal transition-colors">4-6</span>
                <span class="block font-sans text-xs text-slate-500 uppercase font-bold mt-1">Socios</span>
              </button>
              <button class="disol-btn group relative py-6 px-2 text-center border-2 border-slate-200 rounded-xl hover:border-constival-mint hover:bg-slate-50 transition-all focus:outline-none" data-value="7+">
                <span class="font-sans font-black text-2xl text-constival-navy group-hover:text-constival-teal transition-colors">7+</span>
                <span class="block font-sans text-xs text-slate-500 uppercase font-bold mt-1">Socios</span>
              </button>
            </div>
          </div>

          <!-- Step 4: Result -->
          <div id="disol-step-4" class="absolute inset-0 flex flex-col transition-all duration-500 ease-in-out translate-x-12 opacity-0 pointer-events-none">
            <div class="flex flex-col h-full items-center justify-center w-full">
              
              <div class="w-full flex items-center justify-between mb-8 border-b border-slate-100 pb-4">
                <span class="font-sans font-black text-fine uppercase tracking-widest text-[#0a1818]">Presupuesto</span>
                <button class="font-sans text-xs font-bold text-constival-teal hover:text-constival-mint hover:underline transition-colors shrink-0 outline-none" id="disol-restart">← Reiniciar</button>
              </div>

              <div id="disol-result-price-view" class="w-full">
                <div class="mb-6 p-5 bg-slate-50 border border-slate-200 rounded-xl text-center shadow-inner relative overflow-hidden">
                    <div class="absolute right-0 bottom-0 text-[8rem] font-black text-slate-900/[0.03] leading-none select-none pointer-events-none translate-x-1/4 translate-y-1/4">$</div>
                  <p class="font-sans text-sm font-bold text-slate-500 mb-2 uppercase tracking-wide">
                    Honorarios Profesionales:
                  </p>
                  <div class="flex items-baseline justify-center gap-2">
                    <span class="font-sans text-5xl font-black text-constival-navy leading-none font-display tracking-tight" id="disol-price-final">$157</span>
                    <span class="font-sans text-sm font-bold text-slate-400">+ IVA</span>
                  </div>
                  <p id="disol-nota-gastos" class="font-sans text-xs text-slate-500 mt-4 px-2 leading-relaxed hidden">
                    *Las Sociedades Anónimas y Cía. Ltda. requieren protocolización notarial, lo que implica gastos notariales y registrales adicionales.
                  </p>
                </div>

                <a
                  id="disol-whatsapp-cta"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-[#25D366] hover:bg-[#1ebd5b] text-white font-sans font-black text-base uppercase tracking-wider transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] shadow-lg shadow-green-900/30 ring-4 ring-[#25D366]/20"
                >
                  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
                  INICIAR TRÁMITE AHORA
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Service Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      serviceType: "Disolución y Liquidación de Empresas en Ecuador",
      description:
        "Servicio legal integral para la disolución voluntaria, abreviada u ordinaria de empresas SAS, S.A. y Cía. Ltda. ante la Superintendencia de Compañías en Ecuador.",
      provider: {
        "@type": "LegalService",
        name: "CONSTIVAL",
        url: "https://constival.com",
      },
      offers: {
        "@type": "Offer",
        price: "157.00",
        priceCurrency: "USD",
        url: "https://constival.com/servicios/disolucion-sociedades-ecuador",
        availability: "https://schema.org/InStock"
      },
      areaServed: {
        "@type": "Country",
        name: "Ecuador"
      }
    })}
  />

  <script>
    // Price table: [empresa][proceso][socios] = price
    const disolPrecios: Record<string, Record<string, Record<string, string>>> = {
      "sas": {
        "abreviado": { "1": "$157", "2-3": "$197", "4-6": "$237", "7+": "$277" },
        "ordinario": { "1": "$187", "2-3": "$217", "4-6": "$257", "7+": "$297" }
      },
      "sa-crl": {
        "abreviado": { "1": "$177", "2-3": "$217", "4-6": "$257", "7+": "$297" },
        "ordinario": { "1": "$197", "2-3": "$237", "4-6": "$277", "7+": "$317" }
      }
    };

    let disolState = {
      step: 1,
      empresa: "",
      proceso: "",
      socios: "",
    };

    const disolElements = {
      steps: [
        document.getElementById("disol-step-1"),
        document.getElementById("disol-step-2"),
        document.getElementById("disol-step-3"),
        document.getElementById("disol-step-4"),
      ],
      progress: document.getElementById("disol-progress-bar"),
      priceFinal: document.getElementById("disol-price-final"),
      notaGastos: document.getElementById("disol-nota-gastos"),
      cta: document.getElementById("disol-whatsapp-cta"),
      restartBtn: document.getElementById("disol-restart"),
      backBtns: document.querySelectorAll(".disol-back"),
      optionBtns: document.querySelectorAll(".disol-btn")
    };

    function updateDisolUI() {
      // Update progress bar
      if (disolElements.progress) {
        disolElements.progress.style.width = `${(disolState.step / 4) * 100}%`;
      }

      // Handle step visibility
      disolElements.steps.forEach((el, index) => {
        if (!el) return;
        const stepNum = index + 1;
        
        if (stepNum === disolState.step) {
          el.classList.remove("opacity-0", "pointer-events-none", "translate-x-12", "-translate-x-12");
          el.classList.add("opacity-100", "translate-x-0");
        } else if (stepNum < disolState.step) {
          el.classList.remove("opacity-100", "translate-x-0", "translate-x-12");
          el.classList.add("opacity-0", "pointer-events-none", "-translate-x-12");
        } else {
          el.classList.remove("opacity-100", "translate-x-0", "-translate-x-12");
          el.classList.add("opacity-0", "pointer-events-none", "translate-x-12");
        }
      });

      // Update active states on buttons
      disolElements.optionBtns.forEach(btn => {
        const val = btn.getAttribute("data-value");
        if (val === disolState.empresa || val === disolState.proceso || val === disolState.socios) {
          btn.classList.add("border-constival-mint", "ring-1", "ring-constival-mint");
          btn.classList.remove("border-slate-200");
        } else {
          btn.classList.remove("border-constival-mint", "ring-1", "ring-constival-mint");
          btn.classList.add("border-slate-200");
        }
      });

      // Show result
      if (disolState.step === 4) {
        const price = disolPrecios[disolState.empresa][disolState.proceso][disolState.socios];
        
        if (disolElements.priceFinal) disolElements.priceFinal.textContent = price;

        if (disolElements.notaGastos) {
          if (disolState.empresa === "sa-crl") {
            disolElements.notaGastos.classList.remove("hidden");
          } else {
            disolElements.notaGastos.classList.add("hidden");
          }
        }

        // Setup WhatsApp link
        if (disolElements.cta) {
          const empresaText = disolState.empresa === "sas" ? "una S.A.S." : "una S.A./Cía.Ltda.";
          const msg = `Hola Constival, necesito cotizar la disolución de ${empresaText} mediante proceso ${disolState.proceso} (${disolState.socios} socios). Vi que el precio base es ${price}.`;
          disolElements.cta.setAttribute("href", `https://wa.me/593969503502?text=${encodeURIComponent(msg)}`);
        }
      }
    }

    // Event Listeners
    disolElements.optionBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const value = btn.getAttribute("data-value");
        if (!value) return;

        if (disolState.step === 1) {
          disolState.empresa = value;
          disolState.step = 2;
        } else if (disolState.step === 2) {
          disolState.proceso = value;
          disolState.step = 3;
        } else if (disolState.step === 3) {
          disolState.socios = value;
          disolState.step = 4;
        }

        updateDisolUI();
      });
    });

    disolElements.backBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        if (disolState.step > 1) {
          disolState.step--;
          updateDisolUI();
        }
      });
    });

    if (disolElements.restartBtn) {
      disolElements.restartBtn.addEventListener("click", () => {
        disolState = { step: 1, empresa: "", proceso: "", socios: "" };
        updateDisolUI();
      });
    }

    // Init UI
    updateDisolUI();
  </script>
</section>
