---
---

<section
  id="comparativa-disolucion"
  class="py-14 md:py-16 bg-gray-50 dark:bg-[#090e1a] relative overflow-hidden transition-colors duration-300"
>
  <div
    class="absolute left-0 top-0 w-1/3 h-full bg-constival-blue/5 dark:bg-constival-blue/10 blur-[120px] rounded-full pointer-events-none"
  ></div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10 md:mb-14">
      <span
        class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint"
      >
        Abreviado vs. Ordinario
      </span>
      <h2
        class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight"
      >
        ¿Qué proceso <span class="text-constival-mint">se aplica a su empresa?</span>
      </h2>
      <p
        class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed"
      >
        Adaptamos la disolución a su situación específica. Evaluar correctamente el proceso inicial es clave para ahorrar tiempo, dinero y eliminar riesgos legales.
      </p>
    </div>

    <!-- Comparison Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 max-w-5xl mx-auto">
      <!-- Abreviado (Highlighted) -->
      <div
        class="relative bg-white dark:bg-constival-deep/60 border-2 border-constival-mint shadow-[0_0_30px_rgba(0,255,178,0.1)] p-5 md:p-6 flex flex-col"
      >
        <div
          class="absolute -top-4 left-6 px-4 py-1.5 bg-constival-mint text-constival-navy font-sans font-bold text-fine uppercase tracking-widest"
        >
          Más Frecuente
        </div>
        <h3
          class="font-sans text-feature-title font-extrabold text-constival-navy dark:text-white mb-1 mt-2 tracking-tight"
        >
          Proceso Abreviado
        </h3>
        <p class="font-sans text-fine text-constival-navy/50 dark:text-slate-500 mb-5 uppercase tracking-wider">
          Disolución Simplificada — Sin liquidador
        </p>

        <ul class="space-y-3 flex-1">
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-mint shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
            >
            <span>Aplica cuando <strong>no hay deudas con terceros</strong> ni obligaciones pendientes</span>
          </li>
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-mint shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
            >
            <span>Requiere acuerdo <strong>unánime de todos los socios</strong></span>
          </li>
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-mint shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
            >
            <span>En S.A.S.: trámite mediante <strong>documento privado</strong> (sin notaría)</span>
          </li>
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-mint shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
            >
            <span>Proceso más rápido: <strong>semanas en lugar de meses</strong></span>
          </li>
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-mint shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
            >
            <span>Honorarios más accesibles: <strong>desde $157 + IVA</strong></span>
          </li>
        </ul>

        <div class="mt-5 pt-5 border-t border-constival-mint/20">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
            <span class="font-sans text-fine font-bold text-constival-navy/60 dark:text-slate-400 uppercase tracking-wider">
              Tiempo estimado: 3–8 semanas
            </span>
          </div>
        </div>
      </div>

      <!-- Ordinario -->
      <div
        class="relative bg-white dark:bg-constival-deep/60 border border-constival-navy/10 dark:border-white/10 p-5 md:p-6 flex flex-col"
      >
        <h3
          class="font-sans text-feature-title font-extrabold text-constival-navy dark:text-white mb-1 mt-2 tracking-tight"
        >
          Proceso Ordinario
        </h3>
        <p class="font-sans text-fine text-constival-navy/50 dark:text-slate-500 mb-5 uppercase tracking-wider">
          Disolución con Liquidación — Con liquidador nombrado
        </p>

        <ul class="space-y-3 flex-1">
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-navy/30 dark:text-slate-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg
            >
            <span>Aplica cuando <strong>existen activos por distribuir o pasivos</strong> que liquidar</span>
          </li>
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-navy/30 dark:text-slate-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg
            >
            <span>Requiere nombramiento de <strong>liquidador</strong> y publicación a acreedores</span>
          </li>
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-navy/30 dark:text-slate-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg
            >
            <span>Escritura pública notarial obligatoria en <strong>S.A. y Cía. Ltda.</strong></span>
          </li>
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-navy/30 dark:text-slate-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg
            >
            <span>Balance final y distribución del haber social entre socios</span>
          </li>
          <li class="flex items-start gap-3 font-sans text-body text-constival-navy/80 dark:text-slate-300 leading-snug">
            <svg class="w-5 h-5 text-constival-navy/30 dark:text-slate-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg
            >
            <span>Honorarios desde <strong>$187 + IVA</strong> (según tipo y número de socios)</span>
          </li>
        </ul>

        <div class="mt-5 pt-5 border-t border-constival-navy/10 dark:border-white/10">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-constival-navy/40 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
            <span class="font-sans text-fine font-bold text-constival-navy/60 dark:text-slate-400 uppercase tracking-wider">
              Tiempo estimado: 2–6 meses
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom note -->
    <div class="mt-8 max-w-3xl mx-auto text-center">
      <div class="inline-flex items-start gap-3 px-5 py-4 bg-constival-mint/5 dark:bg-constival-mint/10 border border-constival-mint/20 text-left">
        <svg class="w-5 h-5 text-constival-mint shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
        >
        <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed">
          <strong class="text-constival-navy dark:text-white">¿No sabe cuál le aplica?</strong> En la consulta inicial gratuita evaluamos su caso específico y determinamos el proceso correcto, los costos exactos y el plazo estimado.
        </p>
      </div>
    </div>
  </div>
</section>
