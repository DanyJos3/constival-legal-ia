---

const fases = [
  {
    num: "01",
    label: "1–2 días",
    title: "Consulta Inicial",
    desc: "Nos contactas indicando el tipo de cambio que necesitas, envías los datos del nuevo administrador y confirmamos factibilidad y requisitos específicos de tu caso.",
  },
  {
    num: "02",
    label: "1–2 días",
    title: "Preparación Documental",
    desc: "Redactamos el acta de asamblea y nombramiento con requisitos legales exactos. Te enviamos para revisión y firma (electrónica o manuscrita según tu preferencia).",
  },
  {
    num: "03",
    label: "1–2 días",
    title: "Presentación Registral",
    desc: "Presentamos la documentación ante Registro Mercantil o SCVS según el tipo de sociedad. Para SAS se inscribe en SCVS; para SA y Cía. Ltda., en Registro Mercantil.",
  },
  {
    num: "04",
    label: "5–15 días hábiles",
    title: "Resolución e Inscripción",
    desc: "El organismo aprueba e inscribe el nombramiento. En caso de observaciones, te notificamos y gestionamos la subsanación sin costo adicional.",
  },
  {
    num: "05",
    label: "1 día",
    title: "Entrega de Resultados",
    desc: "Te enviamos copia de inscripción registral, documentación completa tramitada y asesoramiento sobre próximos pasos. Incluye actualización de RUC.",
  },
];
---

<section class="py-14 md:py-20 bg-white dark:bg-constival-navy overflow-hidden relative transition-colors duration-300">
  <div class="absolute inset-0 opacity-[0.02] dark:opacity-[0.04]" style="background-image: linear-gradient(rgba(0,255,178,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,178,0.3) 1px, transparent 1px); background-size: 60px 60px;"></div>
  <div class="absolute right-0 top-1/4 w-[400px] h-[400px] bg-constival-teal/10 dark:bg-constival-teal/20 blur-[150px] rounded-full pointer-events-none"></div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-12 md:mb-16">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint border-l-4 border-constival-teal dark:border-constival-mint mb-4 sm:mb-5 font-sans font-bold tracking-widest uppercase text-badge">
        ¿Cómo funciona?
      </span>
      <h2 class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight leading-[1.1]">
        Tu nombramiento listo en <span class="text-constival-mint">5 pasos</span>
      </h2>
      <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 mt-4 max-w-xl mx-auto">
        Nos encargamos de toda la gestión ante Registro Mercantil y SCVS. Tú solo apruebas y firmas.
      </p>
      <div class="inline-flex items-center gap-2 mt-4 px-4 py-2 bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30">
        <svg class="w-4 h-4 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="font-sans font-bold text-badge text-constival-teal dark:text-constival-mint">Plazo estimado: 9 a 22 días hábiles</span>
      </div>
    </div>

    <!-- Mobile timeline -->
    <div class="md:hidden relative">
      <div class="absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-constival-mint/50 via-constival-teal/30 to-transparent"></div>
      <div class="space-y-10 pl-14">
        {fases.map((fase) => (
          <div class="relative">
            <div class="absolute -left-[3.25rem] top-0 w-10 h-10 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30">
              <span class="font-sans font-black text-sm text-constival-mint">{fase.num}</span>
            </div>
            <span class="inline-block font-sans text-fine font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-1">{fase.label}</span>
            <h3 class="font-sans text-feature-title font-bold text-constival-navy dark:text-white mb-1">{fase.title}</h3>
            <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">{fase.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Desktop timeline grid -->
    <div class="hidden md:grid grid-cols-5 gap-0 relative">
      <div class="absolute top-5 left-[10%] right-[10%] h-px bg-gradient-to-r from-constival-mint/30 via-constival-teal/40 to-constival-mint/30"></div>
      {fases.map((fase) => (
        <div class="relative flex flex-col items-center text-center px-3">
          <div class="w-10 h-10 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 border border-constival-mint/30 relative z-10 mb-4">
            <span class="font-sans font-black text-sm text-constival-mint">{fase.num}</span>
          </div>
          <span class="font-sans text-fine font-bold text-constival-navy/40 dark:text-slate-500 uppercase tracking-widest mb-2">{fase.label}</span>
          <h3 class="font-sans text-feature-title font-bold text-constival-navy dark:text-white mb-2 leading-tight">{fase.title}</h3>
          <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">{fase.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
