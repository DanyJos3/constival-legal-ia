---
import Button from "../../ui/Button.astro";
---

<section
  id="inicio-nombramientos"
  class="relative min-h-[100svh] flex items-center py-16 pt-20 sm:pt-24 md:pt-28 pb-10 sm:pb-12 bg-white dark:bg-constival-navy transition-colors duration-300"
>
  <!-- Background layers -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div
      class="absolute top-0 right-0 w-[250px] h-[250px] sm:w-[400px] sm:h-[400px] md:w-[500px] md:h-[500px] bg-constival-teal/70 blur-[80px] md:blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
    ></div>
    <div
      class="absolute bottom-0 left-0 w-[200px] h-[200px] sm:w-[350px] sm:h-[350px] md:w-[400px] md:h-[400px] bg-constival-blue/20 blur-[80px] md:blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
    ></div>
    <!-- Subtle grid pattern -->
    <div
      class="absolute inset-0 opacity-[0.02] dark:opacity-[0.03]"
      style="background-image: linear-gradient(rgba(0,255,178,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,178,0.3) 1px, transparent 1px); background-size: 60px 60px;"
    ></div>
  </div>

  <!-- Content container -->
  <div
    class="w-full mx-auto px-6 sm:px-8 md:px-12 lg:px-16 relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-center lg:justify-between max-w-7xl gap-8 sm:gap-12 lg:gap-16 flex-1 my-auto"
  >
    <!-- Left Column: Copy -->
    <div class="w-full lg:w-7/12 lg:max-w-2xl flex-shrink-0 relative z-10">
      <span
        class="inline-block py-2 px-3 sm:py-2.5 sm:px-5 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint border-l-4 border-constival-teal dark:border-constival-mint mb-5 sm:mb-6 font-sans font-bold tracking-widest uppercase text-badge"
      >
        Gestión Administrativa Societaria
      </span>

      <h1
        class="font-sans text-hero font-extrabold tracking-tighter leading-[0.95] text-constival-navy dark:text-white mb-5 sm:mb-7 lg:mb-8 uppercase"
      >
        Nombramientos y Cambios
        <span class="block text-constival-blue dark:text-constival-mint mt-1 sm:mt-2">
          Administrativos en Ecuador.</span
        >
      </h1>

      <p
        class="font-serif italic text-body-lead text-constival-teal dark:text-slate-400 mb-8 sm:mb-9 lg:mb-10 max-w-xl border-l-[4px] sm:border-l-[5px] border-constival-mint pl-5 sm:pl-6 leading-relaxed"
      >
        Cambio de representante legal, renovación de nombramientos, renuncias de administradores.
        Gestionamos cada detalle normativo para que tu empresa siga operando sin interrupciones.
      </p>

      <div class="flex flex-wrap gap-3 items-center">
        <Button variant="primary" href="#precio-nombramientos">
          <svg class="w-4 h-4 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Cotizar mi trámite
        </Button>
        <a
          href="#contexto-nombramientos"
          class="font-sans text-body font-bold text-constival-navy/60 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint transition-colors underline underline-offset-4 decoration-constival-mint/30 hover:decoration-constival-mint ml-2"
        >
          ¿Cuándo debo actuar? &darr;
        </a>
      </div>

      <!-- Trust badges -->
      <div
        class="flex flex-wrap items-center gap-4 sm:gap-6 mt-8 sm:mt-10 pt-6 border-t border-constival-navy/10 dark:border-white/10"
      >
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <span class="font-sans text-badge font-bold text-constival-navy/70 dark:text-slate-400">Inscripción SCVS & R. Mercantil</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span class="font-sans text-badge font-bold text-constival-navy/70 dark:text-slate-400">Gestión 100% Integral</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-constival-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-sans text-badge font-bold text-constival-navy/70 dark:text-slate-400">Plazo: 9–22 días hábiles</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Feature highlights -->
    <div class="w-full lg:w-5/12 relative mt-6 lg:mt-0">
      <div
        class="bg-gray-50 dark:bg-[#121826] border border-constival-navy/5 dark:border-white/5 p-6 sm:p-8 relative overflow-hidden"
      >
        <div
          class="absolute right-0 top-0 text-[10rem] font-sans font-black text-constival-navy/[0.03] dark:text-white/[0.02] leading-none select-none pointer-events-none translate-x-1/4 -translate-y-1/4"
        >
          N
        </div>
        <h2
          class="font-sans text-card-title font-extrabold text-constival-navy dark:text-white mb-6 tracking-tight"
        >
          ¿Por qué gestionar con Constival?
        </h2>
        <div class="space-y-4">
          <!-- Feature 1 -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white">Gestión 100% ante organismos públicos</h3>
              <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">Presentamos ante Registro Mercantil y/o SCVS según corresponda. Cero burocracia para ti.</p>
            </div>
          </div>
          <!-- Feature 2 -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white">Cumplimiento normativo garantizado</h3>
              <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">Cada nombramiento cumple exactamente con los requisitos legales. Evitas multas y rechazos.</p>
            </div>
          </div>
          <!-- Feature 3 -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white">Claridad total en procesos y plazos</h3>
              <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">Sabes desde el inicio qué documentos necesitamos, cuánto toma y cuándo recibes resultados.</p>
            </div>
          </div>
          <!-- Feature 4 -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white">Para todos los tipos societarios</h3>
              <p class="font-sans text-body text-constival-navy/60 dark:text-slate-400 leading-relaxed">Trabajamos con SAS, Sociedades Anónimas y Compañías Limitadas. Un solo contacto.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
