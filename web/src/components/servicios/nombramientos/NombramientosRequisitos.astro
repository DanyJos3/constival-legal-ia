---

const requisitos = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/>`,
    title: "Cédula del Nuevo Administrador",
    desc: "Cédula de identidad o pasaporte vigente. Si es persona jurídica: razón social, RUC y datos del representante legal autorizado.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>`,
    title: "Certificado de Votación",
    desc: "Certificado de votación vigente del nuevo administrador designado.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
    title: "Datos de Contacto",
    desc: "Teléfono, correo electrónico, dirección domiciliaria y profesión del nuevo administrador.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`,
    title: "Contacto del Representante Actual",
    desc: "Teléfono y correo del representante legal vigente o contacto autorizado de la compañía.",
  },
];
---

<section
  class="py-14 md:py-16 bg-gray-50 dark:bg-[#0a0f1a] relative overflow-hidden transition-colors duration-300"
>
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10 md:mb-14">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint">
        Documentación Necesaria
      </span>
      <h2 class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight">
        Requisitos para <span class="text-constival-mint">tu cambio administrativo.</span>
      </h2>
      <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
        Solo necesitas estos documentos base. Nosotros nos encargamos de la redacción del acta, el nombramiento y toda la gestión registral.
      </p>
    </div>

    <!-- Base requirements grid -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 mb-10">
      {requisitos.map((req) => (
        <div class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300">
          <div class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={req.icon} />
          </div>
          <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2">{req.title}</h3>
          <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed">{req.desc}</p>
        </div>
      ))}
    </div>

    <!-- What's included -->
    <div class="bg-white dark:bg-constival-deep/30 border border-constival-navy/5 dark:border-white/5 p-6 md:p-8">
      <h3 class="font-sans text-card-title font-bold text-constival-navy dark:text-white mb-6 flex items-center gap-3">
        <span class="w-1 h-6 bg-constival-mint inline-block shrink-0"></span>
        Qué incluye el servicio
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          "Revisión de estatutos sociales y estructura administrativa vigente",
          "Redacción de acta de asamblea general de accionistas",
          "Generación del documento de nombramiento con requisitos legales",
          "Gestión de inscripción ante Registro Mercantil o SCVS",
          "Confirmación de inscripción exitosa y envío de documentación",
          "Actualización de RUC ante el SRI",
        ].map((item) => (
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-constival-mint mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="font-sans text-body text-constival-navy/70 dark:text-slate-400">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
