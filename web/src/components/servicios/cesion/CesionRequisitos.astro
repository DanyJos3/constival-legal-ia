---
---

<section class="py-14 md:py-16 bg-gray-50 dark:bg-[#0a0f1a] relative overflow-hidden transition-colors duration-300">
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10 md:mb-14">
      <span class="inline-block py-1.5 px-3 sm:py-2 sm:px-4 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint font-sans font-bold tracking-widest uppercase text-badge mb-4 border-l-4 border-constival-teal dark:border-constival-mint">
        Documentación Necesaria
      </span>
      <h2 class="font-sans text-section-title font-extrabold text-constival-navy dark:text-white tracking-tight">
        Requisitos para <span class="text-constival-mint">ceder acciones o participaciones.</span>
      </h2>
      <div class="mt-4 flex justify-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-sans text-xs font-bold rounded-full">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Actualizado a Mayo 2026
        </span>
      </div>
      <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
        Solo nos envías estos documentos. Nosotros gestionamos todo lo demás ante SUPERCIAS y el Registro Mercantil.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {[
        { title: "Cédulas / Pasaportes", desc: "Documentos de identidad vigentes tanto del cedente (quien transfiere) como del cesionario (quien recibe).", icon: "M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" },
        { title: "Detalles de la Cesión", desc: "Cantidad de acciones o participaciones a transferir, valor unitario y total, y si es onerosa (con pago) o gratuita (donación).", icon: "M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" },
        { title: "Datos SCVS", desc: "RUC de la empresa, usuario y contraseña del portal de SUPERCÍAS para la notificación obligatoria en línea.", icon: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" },
        { title: "Correos Electrónicos", desc: "Email vigente de cedente y cesionario para notificaciones legales y entrega de la carpeta digital con todos los documentos.", icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" },
      ].map((req) => (
        <div class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300">
          <div class="w-10 h-10 mb-3 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={req.icon} /></svg>
          </div>
          <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-2">{req.title}</h3>
          <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed">{req.desc}</p>
        </div>
      ))}
    </div>

    <!-- Nota adicional -->
    <div class="mt-8 max-w-4xl mx-auto">
      <div class="group bg-white dark:bg-constival-deep/50 p-5 border border-constival-navy/5 dark:border-white/5 hover:border-constival-mint/30 transition-all duration-300 flex items-start gap-4">
        <div class="w-10 h-10 shrink-0 flex items-center justify-center bg-constival-mint/10 dark:bg-constival-mint/20 text-constival-mint">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <div>
          <h3 class="font-sans font-bold text-feature-title text-constival-navy dark:text-white mb-1">Nota: Poder notarial si actúas como apoderado</h3>
          <p class="font-sans text-body text-constival-navy/70 dark:text-slate-400 leading-relaxed">
            Si el cedente o cesionario no puede actuar directamente, se requiere poder notarial debidamente otorgado. Para personas jurídicas, se adjunta el nombramiento vigente del representante legal. En cesiones donde el adquirente es extranjero, puede requerirse declaración de origen lícito de fondos.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
