---
export interface Props {
  number: string;
  title: string;
  description: string;
}
const { number, title, description } = Astro.props;
---
<div class="bg-gray-50 dark:bg-[#1a1f2c] p-6 md:p-7 hover:bg-white dark:hover:bg-[#252a37] transition-all group relative cursor-pointer border-t-2 border-transparent hover:border-constival-mint shadow-sm hover:shadow-lg">
  <div class="flex justify-between items-start mb-6">
    <span class="font-sans text-constival-navy/10 dark:text-white/10 text-3xl font-black">{number}</span>
    <svg class="w-5 h-5 text-constival-mint opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
  </div>
  <h4 class="font-sans text-base font-bold text-constival-navy dark:text-white mb-2">{title}</h4>
  <p class="text-constival-navy/70 dark:text-slate-400 text-xs leading-relaxed font-sans">{description}</p>
</div>
