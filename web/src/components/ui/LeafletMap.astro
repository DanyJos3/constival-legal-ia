---
export interface Props {
  lat: number;
  lng: number;
  zoom?: number;
  title?: string;
  address?: string;
}

const { 
  lat, 
  lng, 
  zoom = 16, 
  title = "CONSTIVAL",
  address = "Quito, Ecuador"
} = Astro.props;
---

<div 
  id="map" 
  class="absolute inset-0 z-0"
  data-lat={lat}
  data-lng={lng}
  data-zoom={zoom}
  data-title={title}
  data-address={address}
></div>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<script>
  // Cargar Leaflet dinámicamente solo en el cliente para no bloquear el hilo principal
  const loadLeaflet = async () => {
    // Si ya existe L (leaflet), no lo volvemos a cargar
    if (window.L) return window.L;

    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
      script.crossOrigin = '';
      script.onload = () => resolve(window.L);
      script.onerror = reject;
      document.head.appendChild(script);
    });
  };

  const initMap = async () => {
    const mapElement = document.getElementById('map');
    if (!mapElement) return;

    // Solo inicializar si el mapa entra en la vista (IntersectionObserver = +Rendimiento)
    const observer = new IntersectionObserver(async (entries) => {
      if (entries[0].isIntersecting) {
        observer.disconnect(); // Ya no necesitamos observar
        
        const L = await loadLeaflet();
        
        const lat = parseFloat(mapElement.dataset.lat || "0");
        const lng = parseFloat(mapElement.dataset.lng || "0");
        const zoom = parseInt(mapElement.dataset.zoom || "16");
        const title = mapElement.dataset.title || "";
        const address = mapElement.dataset.address || "";

        // Inicializar el mapa
        const map = L.map('map', {
          scrollWheelZoom: false // Evitar que el usuario haga zoom al hacer scroll en la página
        }).setView([lat, lng], zoom);

        // Capa oscura elegante (Estilo CartoDB Dark Matter o Positron)
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
          subdomains: 'abcd',
          maxZoom: 20
        }).addTo(map);

        // Icono personalizado (El Isotipo de Constival)
        const constivalIcon = L.icon({
          iconUrl: '/isotipo-1.svg', // Tu logo
          iconSize: [40, 40], // Tamaño del logo
          iconAnchor: [20, 20], // Punto de anclaje (centro)
          popupAnchor: [0, -20] // Donde sale el popup
        });

        // Crear el marcador
        const marker = L.marker([lat, lng], {icon: constivalIcon}).addTo(map);
        
        // Popup con la info
        marker.bindPopup(`
          <div style="text-align: center; font-family: sans-serif;">
            <strong style="color: #0f172a; font-size: 14px;">${title}</strong><br/>
            <span style="color: #64748b; font-size: 12px;">${address}</span>
          </div>
        `).openPopup();

        // ------------------
        // PUNTOS DE REFERENCIA
        // ------------------



        // 2. Parque La Carolina (Zona Verde Amplia)
        L.circleMarker([-0.182464, -78.484210], {
          radius: 35,
          color: '#22c55e',
          fillColor: '#22c55e',
          fillOpacity: 0.25,
          weight: 2
        }).addTo(map).bindTooltip('Parque La Carolina', { permanent: true, direction: 'center', className: 'poi-tooltip' });

        // 3. Quicentro Shopping (Zona Azul/Comercial)
        L.circleMarker([-0.175783, -78.479631], {
          radius: 14,
          color: '#3b82f6',
          fillColor: '#3b82f6',
          fillOpacity: 0.4,
          weight: 2
        }).addTo(map).bindTooltip('Quicentro Shopping', { permanent: true, direction: 'right', className: 'poi-tooltip' });

        // 4. Estadio Olímpico Atahualpa (Zona Naranja/Deportiva)
        L.circleMarker([-0.177722, -78.476483], {
          radius: 18,
          color: '#f97316', // Orange
          fillColor: '#f97316',
          fillOpacity: 0.35,
          weight: 2
        }).addTo(map).bindTooltip('Estadio Olímpico Atahualpa', { permanent: true, direction: 'bottom', className: 'poi-tooltip' });

      }
    });

    observer.observe(mapElement);
  };

  // Ejecutar al cargar la página
  initMap();

  // Compatibilidad con Astro View Transitions
  document.addEventListener('astro:page-load', initMap);
</script>

<style is:global>
  /* Modificaciones de estilo para Leaflet */
  .leaflet-popup-content-wrapper {
    border-radius: 4px;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  }
  .leaflet-container {
    font-family: inherit;
  }
  
  /* Estilo para los nombres de los lugares de referencia */
  .poi-tooltip {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    color: #334155;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: -0.2px;
    text-shadow: 2px 2px 4px rgba(255,255,255,0.9), -2px -2px 4px rgba(255,255,255,0.9), 2px -2px 4px rgba(255,255,255,0.9), -2px 2px 4px rgba(255,255,255,0.9);
  }
</style>
