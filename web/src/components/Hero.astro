---
import Button from "./ui/Button.astro";
import { CONSTIVAL_DATA } from "../constants/company";

// Preparar los servicios para el carrusel (los duplicamos para el efecto infinito)
const heroServices = Object.values(CONSTIVAL_DATA.services);
const carouselItems = [...heroServices, ...heroServices];
---

<section
  id="inicio"
  class="relative min-h-[100svh] flex items-center py-16 pt-20 sm:pt-24 md:pt-28 pb-8 sm:pb-10 md:pb-12 bg-white dark:bg-constival-navy transition-colors duration-300"
>
  <!-- Background layers -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <img
      src="/images/hero-bg.webp"
      alt="Derecho societario ecuador"
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover grayscale opacity-15 dark:opacity-20 mix-blend-multiply dark:mix-blend-lighten"
    />
    <div
      class="absolute top-0 right-0 w-[250px] h-[250px] sm:w-[400px] sm:h-[400px] md:w-[500px] md:h-[500px] bg-constival-teal/90 blur-[80px] md:blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[250px] h-[250px] sm:w-[400px] sm:h-[400px] md:w-[500px] md:h-[500px] bg-constival-blue/90 blur-[80px] md:blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
    >
    </div>
  </div>

  <!-- Content container -->
  <div
    class="w-full mx-auto px-6 sm:px-8 md:px-12 lg:px-16 relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-center lg:justify-between max-w-7xl gap-8 sm:gap-12 lg:gap-10 flex-1 my-auto"
  >
    <!-- Left Column: Copy -->
    <div class="w-full lg:w-6/12 lg:max-w-xl flex-shrink-0 relative z-10">
      <span
        class="inline-block py-2 px-3 sm:py-2.5 sm:px-5 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint border-l-4 border-constival-teal dark:border-constival-mint mb-5 sm:mb-6 font-sans font-bold tracking-widest uppercase text-xs sm:text-sm"
      >
        Arquitectura Empresarial Contemporánea
      </span>

      <h1
        class="font-sans text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-extrabold tracking-tighter leading-[0.95] text-constival-navy dark:text-white mb-5 sm:mb-7 lg:mb-8"
      >
        TU SOCIO LEGAL ESTRATÉGICO PARA
        <span class="text-constival-blue dark:text-white">
          BLINDAR Y ESCALAR EMPRESAS EN ECUADOR.</span
        >
      </h1>

      <p
        class="font-serif italic text-base sm:text-lg lg:text-xl text-constival-teal dark:text-slate-400 mb-8 sm:mb-9 lg:mb-10 max-w-xl border-l-[4px] sm:border-l-[5px] border-constival-mint pl-5 sm:pl-6 leading-relaxed"
      >
        Desde la arquitectura societaria hasta el blindaje de marcas y reformas
        corporativas. Protegemos tu patrimonio con procesos 100% digitales,
        honorarios fijos y cero burocracia.
      </p>

      <div class="flex flex-wrap gap-3 items-center">
        <!-- TRACKING: hero_cta_diagnostico -->
        <Button variant="primary" href="#configurador">
          <svg
            class="w-4 h-4 hidden sm:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Iniciar Diagnóstico Gratuito
        </Button>
        <!-- TRACKING: hero_cta_secondary -->
        <a
          href="#servicios"
          class="font-sans text-sm sm:text-base font-bold text-constival-navy/60 dark:text-slate-400 hover:text-constival-mint dark:hover:text-constival-mint transition-colors underline underline-offset-4 decoration-constival-mint/30 hover:decoration-constival-mint ml-2"
        >
          Ver servicios &darr;
        </a>
      </div>

      <!-- Social proof (desktop only — stays under CTA) -->
      <div
        class="hidden lg:flex mt-6 items-center gap-3 pt-5 border-t border-constival-navy/10 dark:border-white/10 w-fit"
      >
        <div class="flex -space-x-2">
          <div
            class="w-7 h-7 rounded-full bg-constival-mint/20 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[10px] font-bold text-constival-mint"
          >
            E
          </div>
          <div
            class="w-7 h-7 rounded-full bg-constival-blue/30 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[10px] font-bold text-constival-blue dark:text-white"
          >
            S
          </div>
          <div
            class="w-7 h-7 rounded-full bg-constival-teal/30 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[10px] font-bold text-constival-teal dark:text-constival-mint"
          >
            P
          </div>
        </div>
        <p
          class="font-sans text-[11px] text-constival-navy/70 dark:text-slate-500"
        >
          <strong class="text-constival-navy dark:text-white"
            >100+ empresas</strong
          > protegidas
        </p>
      </div>
    </div>

    <!-- Carousel — relative on mobile (stacks below text), absolute on lg+ (overlaps behind text) -->
    <div
      class="w-full h-[290px] sm:h-[260px] md:h-[280px] relative overflow-hidden mt-8 sm:mt-10 lg:mt-0 lg:absolute lg:top-0 lg:right-0 lg:h-full lg:w-auto lg:left-[45%]"
      style="-webkit-mask-image: linear-gradient(to right, transparent, rgba(0,0,0,1) 6%, rgba(0,0,0,1) 94%, transparent); mask-image: linear-gradient(to right, transparent, rgba(0,0,0,1) 6%, rgba(0,0,0,1) 94%, transparent);"
    >
      <div class="absolute h-full flex items-center animate-marquee w-max">
        {
          carouselItems.map((service) => (
            <div class="carousel-card shrink-0 w-[220px] h-[210px] sm:w-[260px] sm:h-[210px] md:w-[280px] md:h-[220px] lg:w-[300px] lg:h-[240px] mr-5 sm:mr-6 md:mr-8 bg-gray-50 dark:bg-[#121826] border border-constival-navy/5 dark:border-white/5 rounded-2xl p-5 sm:p-6 flex flex-col justify-between hover:-translate-y-2 transition-transform duration-300 shadow-xl cursor-grab active:cursor-grabbing group">
              <div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-white dark:bg-constival-navy rounded-xl flex items-center justify-center mb-3 sm:mb-4 text-constival-teal dark:text-constival-mint group-hover:scale-110 transition-transform shadow-sm">
                  <svg
                    class="w-5 h-5 sm:w-6 sm:h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                </div>
                <p class="font-sans font-bold text-base md:text-sm lg:text-base text-constival-navy dark:text-white mb-1.5 leading-tight line-clamp-2">
                  {service.title}
                </p>
                <p class="font-sans text-sm md:text-xs lg:text-sm text-constival-navy/60 dark:text-slate-400 line-clamp-3 leading-snug pr-2">
                  {service.shortDescription}
                </p>
              </div>
              {/* <div class="mt-3 md:mt-4">
                <span class="font-sans font-bold text-[10px] md:text-xs lg:text-xs uppercase tracking-wider flex items-center gap-1.5 text-constival-teal dark:text-constival-mint">
                  Más info{" "}
                  <span class="group-hover:translate-x-1.5 transition-transform">
                    &rarr;
                  </span>
                </span>
              </div> */}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Social proof (mobile only — after carousel) -->
    <div
      class="flex lg:hidden items-center gap-2 sm:gap-3 pt-2 sm:pt-3 border-t border-constival-navy/10 dark:border-white/10 w-fit"
    >
      <div class="flex -space-x-2">
        <div
          class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-constival-mint/20 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[9px] sm:text-[10px] font-bold text-constival-mint"
        >
          E
        </div>
        <div
          class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-constival-blue/30 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[9px] sm:text-[10px] font-bold text-constival-blue dark:text-white"
        >
          S
        </div>
        <div
          class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-constival-teal/30 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[9px] sm:text-[10px] font-bold text-constival-teal dark:text-constival-mint"
        >
          P
        </div>
      </div>
      <p
        class="font-sans text-[11px] sm:text-xs text-constival-navy/70 dark:text-slate-500"
      >
        <strong class="text-constival-navy dark:text-white"
          >100+ empresas</strong
        > protegidas
      </p>
    </div>
  </div>

  <!-- Scroll indicator -->
  <!-- <div
    class="absolute bottom-2 sm:bottom-4 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-1 animate-bounce z-20"
  >
    <span
      class="font-sans text-[9px] text-constival-navy/30 dark:text-white/20 uppercase tracking-widest"
      >Scroll</span
    >
    <svg
      class="w-3.5 h-3.5 text-constival-navy/30 dark:text-white/20"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div> -->
</section>
