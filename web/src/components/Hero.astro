---
import Button from "./ui/Button.astro";
import { CONSTIVAL_DATA } from "../constants/company";

// Preparar los servicios para el carrusel (los duplicamos para el efecto infinito)
const heroServices = Object.values(CONSTIVAL_DATA.services);
const carouselItems = [...heroServices, ...heroServices];
---

<section
  class="relative min-h-[100svh] max-h-screen flex items-center py-16 pt-20 sm:pt-24 md:pt-28 pb-8 sm:pb-10 md:pb-12 overflow-hidden bg-white dark:bg-constival-navy transition-colors duration-300"
  id="inicio"
>
  <!-- Background layers -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <img
      src="/images/hero-bg.webp"
      alt="Corporate architecture"
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover grayscale opacity-15 dark:opacity-20 mix-blend-multiply dark:mix-blend-lighten"
    />
    <div
      class="absolute top-0 right-0 w-[250px] h-[250px] sm:w-[400px] sm:h-[400px] md:w-[500px] md:h-[500px] bg-constival-teal/30 blur-[80px] md:blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[200px] h-[200px] sm:w-[300px] sm:h-[300px] md:w-[400px] md:h-[400px] bg-constival-blue/20 blur-[60px] md:blur-[100px] rounded-full mix-blend-multiply dark:mix-blend-screen"
    >
    </div>
  </div>

  <!-- Content container -->
  <div
    class="w-full mx-auto px-4 sm:px-6 md:px-12 lg:px-16 relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between max-w-7xl gap-4 sm:gap-6 lg:gap-10"
  >
    <!-- Left Column: Copy -->
    <div class="w-full lg:w-6/12 lg:max-w-xl flex-shrink-0 relative z-10">
      <span
        class="inline-block py-1 px-2 sm:py-1.5 sm:px-3 bg-constival-teal/10 dark:bg-constival-teal/30 text-constival-teal dark:text-constival-mint border-l-4 border-constival-teal dark:border-constival-mint mb-2 sm:mb-4 md:mb-5 font-sans font-bold tracking-widest uppercase text-[8px] sm:text-[9px] md:text-[10px]"
      >
        <!-- Arquitectura Empresarial Contemporánea -->
        Tu socio legal empresarial
      </span>

      <h1
        class="font-sans text-2xl sm:text-3xl md:text-5xl xl:text-6xl font-extrabold tracking-tighter leading-[0.95] text-constival-navy dark:text-white mb-2 sm:mb-4 md:mb-5"
      >
        ESTRUCTURAS SOCIETARIAS BLINDADAS PARA
        <span class="text-constival-blue dark:text-white">
          ESCALAR TU EMPRESA.</span
        >
      </h1>

      <p
        class="font-serif italic text-xs sm:text-sm md:text-base lg:text-lg text-constival-teal dark:text-slate-400 mb-3 sm:mb-5 md:mb-8 max-w-xl border-l-4 border-constival-mint pl-3 sm:pl-4 md:pl-6 leading-snug"
      >
        Transforma la vulnerabilidad de tu negocio en una base corporativa
        impenetrable. Diseñamos, automatizamos y protegemos tu ecosistema
        societario en Ecuador.
      </p>

      <div class="flex flex-wrap gap-3 items-center">
        <!-- TRACKING: hero_cta_diagnostico -->
        <Button variant="primary" href="#configurador">
          <svg
            class="w-4 h-4 hidden sm:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Iniciar Diagnóstico Gratuito
        </Button>
      </div>

      <!-- Social proof (desktop only — stays under CTA) -->
      <div
        class="hidden lg:flex mt-6 items-center gap-3 pt-5 border-t border-constival-navy/10 dark:border-white/10 w-fit"
      >
        <div class="flex -space-x-2">
          <div
            class="w-7 h-7 rounded-full bg-constival-mint/20 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[10px] font-bold text-constival-mint"
          >
            E
          </div>
          <div
            class="w-7 h-7 rounded-full bg-constival-blue/30 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[10px] font-bold text-constival-blue dark:text-white"
          >
            S
          </div>
          <div
            class="w-7 h-7 rounded-full bg-constival-teal/30 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[10px] font-bold text-constival-teal dark:text-constival-mint"
          >
            P
          </div>
        </div>
        <p
          class="font-sans text-[11px] text-constival-navy/50 dark:text-slate-500"
        >
          <strong class="text-constival-navy dark:text-white"
            >100+ empresas</strong
          > protegidas
        </p>
      </div>
    </div>

    <!-- Carousel — relative on mobile (stacks below text), absolute on lg+ (overlaps behind text) -->
    <div
      class="w-full h-[140px] sm:h-[200px] md:h-[220px] relative overflow-hidden mt-1 sm:mt-2 lg:mt-0 lg:absolute lg:top-0 lg:right-0 lg:h-full lg:w-auto lg:left-[45%]"
      style="-webkit-mask-image: linear-gradient(to right, transparent, rgba(0,0,0,1) 6%, rgba(0,0,0,1) 94%, transparent); mask-image: linear-gradient(to right, transparent, rgba(0,0,0,1) 6%, rgba(0,0,0,1) 94%, transparent);"
    >
      <div class="absolute h-full flex items-center animate-marquee w-max">
        {
          carouselItems.map((service) => (
            <div class="carousel-card shrink-0 w-[140px] h-[110px] sm:w-[180px] sm:h-[160px] md:w-[220px] md:h-[190px] lg:w-[240px] lg:h-[210px] mr-3 sm:mr-4 md:mr-6 bg-gray-50 dark:bg-[#121826] border border-constival-navy/5 dark:border-white/5 rounded-lg sm:rounded-xl p-2.5 sm:p-3 md:p-4 flex flex-col justify-between hover:-translate-y-1.5 transition-transform duration-300 shadow-md cursor-grab active:cursor-grabbing group">
              <div>
                <div class="w-6 h-6 sm:w-7 sm:h-7 md:w-9 md:h-9 bg-white dark:bg-constival-navy rounded-md sm:rounded-lg flex items-center justify-center mb-1.5 sm:mb-2 md:mb-3 text-constival-teal dark:text-constival-mint group-hover:scale-110 transition-transform shadow-sm">
                  <svg
                    class="w-3 h-3 sm:w-3.5 sm:h-3.5 md:w-4.5 md:h-4.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                </div>
                <h3 class="font-sans font-bold text-[10px] sm:text-xs md:text-sm text-constival-navy dark:text-white mb-0.5 sm:mb-1 md:mb-1.5 leading-tight line-clamp-2">
                  {service.title}
                </h3>
                <p class="font-sans text-[8px] sm:text-[10px] md:text-[11px] text-constival-navy/60 dark:text-slate-400 line-clamp-2 sm:line-clamp-3 leading-snug">
                  {service.subtitle}
                </p>
              </div>
              <div class="mt-1 sm:mt-2 md:mt-3">
                <span class="font-sans font-bold text-[7px] sm:text-[8px] md:text-[9px] text-constival-teal dark:text-constival-mint uppercase tracking-wider flex items-center gap-1">
                  Más info{" "}
                  <span class="group-hover:translate-x-1 transition-transform">
                    &rarr;
                  </span>
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Social proof (mobile only — after carousel) -->
    <div
      class="flex lg:hidden items-center gap-2 sm:gap-3 pt-2 sm:pt-3 border-t border-constival-navy/10 dark:border-white/10 w-fit"
    >
      <div class="flex -space-x-2">
        <div
          class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-constival-mint/20 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[8px] sm:text-[9px] font-bold text-constival-mint"
        >
          E
        </div>
        <div
          class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-constival-blue/30 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[8px] sm:text-[9px] font-bold text-constival-blue dark:text-white"
        >
          S
        </div>
        <div
          class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-constival-teal/30 border-2 border-white dark:border-constival-navy flex items-center justify-center text-[8px] sm:text-[9px] font-bold text-constival-teal dark:text-constival-mint"
        >
          P
        </div>
      </div>
      <p
        class="font-sans text-[9px] sm:text-[10px] text-constival-navy/50 dark:text-slate-500"
      >
        <strong class="text-constival-navy dark:text-white"
          >100+ empresas</strong
        > protegidas
      </p>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-2 sm:bottom-4 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-1 animate-bounce z-20"
  >
    <span
      class="font-sans text-[9px] text-constival-navy/30 dark:text-white/20 uppercase tracking-widest"
      >Scroll</span
    >
    <svg
      class="w-3.5 h-3.5 text-constival-navy/30 dark:text-white/20"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
