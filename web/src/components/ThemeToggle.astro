---
// ThemeToggle.astro
---
<button id="theme-toggle" class="p-2 rounded hover:bg-black/5 dark:hover:bg-white/10 transition-colors focus:outline-none" aria-label="Cambiar tema osculo/claro">
	<!-- Sun Icon (visible in Dark Mode) -->
	<svg id="theme-toggle-light-icon" class="hidden w-5 h-5 text-constival-mint" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
		<path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 3.22a1 1 0 011.415 0l.708.707a1 1 0 01-1.414 1.414l-.708-.707a1 1 0 010-1.414zM17 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zm-3.22 4.22a1 1 0 010 1.415l-.707.708a1 1 0 01-1.414-1.414l.707-.708a1 1 0 011.414 0zM10 16a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zm-4.22-3.22a1 1 0 01-1.415 0l-.708-.707a1 1 0 011.414-1.414l.708.707a1 1 0 010 1.414zM4 10a1 1 0 01-1 1H2a1 1 0 110-2h1a1 1 0 011 1zm3.22-4.22a1 1 0 010-1.415l.707-.708a1 1 0 011.414 1.414l-.707.708a1 1 0 01-1.414 0zM10 5a5 5 0 100 10 5 5 0 000-10z"></path>
	</svg>
	<!-- Moon Icon (visible in Light Mode) -->
	<svg id="theme-toggle-dark-icon" class="hidden w-5 h-5 text-constival-blue" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
		<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
	</svg>
</button>

<script>
	// Run logic after DOM is fully loaded or replaced by ViewTransitions
	document.addEventListener('DOMContentLoaded', () => {
		const themeToggleBtn = document.getElementById('theme-toggle');
		const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
		const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

		// Sync icon with current theme
		const syncThemeIcon = () => {
			if (document.documentElement.classList.contains('dark')) {
				themeToggleLightIcon?.classList.remove('hidden');
				themeToggleDarkIcon?.classList.add('hidden');
			} else {
				themeToggleLightIcon?.classList.add('hidden');
				themeToggleDarkIcon?.classList.remove('hidden');
			}
		};

		// Initialize
		syncThemeIcon();

		// Toggle action
		themeToggleBtn?.addEventListener('click', function() {
			document.documentElement.classList.toggle('dark');
			const isDark = document.documentElement.classList.contains('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
			syncThemeIcon();
		});
	});
</script>
