---
import { CONSTIVAL_DATA } from "../constants/company";
const { info } = CONSTIVAL_DATA;
// Footer Component
---

<footer
  class="bg-gray-50 dark:bg-[#161b28] border-t border-constival-navy/10 dark:border-constival-mint/10 py-4 transition-colors duration-300"
>
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 py-10">
      <!-- <div class="lg:col-span-2 text-center justify-center items-center"> -->
      <div class="col-span-2">
        <div class="flex items-center gap-2">
          <img
            src="/isotipo-2.svg"
            alt=""
            class="w-8 md:w-10 mb-5"
            aria-hidden="true"
          />
          <div
            class="text-xl font-black text-constival-navy dark:text-constival-mint mb-5 font-sans tracking-widest uppercase"
          >
            CONSTI<span class="text-constival-mint dark:text-white">VAL</span>
          </div>
        </div>
        <p
          class="text-constival-navy/70 dark:text-slate-400 max-w-sm font-sans leading-relaxed text-xs mb-5"
        >
          Liderando la transformación jurídica empresarial con agilidad,
          tecnología y un compromiso inquebrantable con la excelencia.
        </p>
      </div>
      <div>
        <h6
          class="font-sans text-constival-navy dark:text-white font-bold uppercase tracking-widest text-[10px] mb-5"
        >
          Navegación
        </h6>
        <ul class="space-y-3 font-sans text-xs">
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="#">Servicios Jurídicos</a
            >
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="#">Nuestros Casos</a
            >
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="#">Sobre la Firma</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h6
          class="font-sans text-constival-navy dark:text-white font-bold uppercase tracking-widest text-[10px] mb-5"
        >
          Contacto
        </h6>
        <ul class="space-y-3 font-sans text-xs">
          <li
            class="text-constival-navy/70 dark:text-slate-400 flex items-center gap-3"
          >
            {info.contact.address}
          </li>
          <li
            class="text-constival-navy/70 dark:text-slate-400 flex items-center gap-3"
          >
            {info.contact.phone}
          </li>
          <li
            class="text-constival-navy/70 dark:text-slate-400 flex items-center gap-3"
          >
            {info.contact.email}
          </li>
        </ul>
      </div>
    </div>
    <div
      class="flex flex-col md:flex-row justify-between items-center pt-4 border-t border-constival-navy/10 dark:border-white/5 font-sans text-[10px] tracking-widest uppercase font-bold text-constival-navy/50 dark:text-slate-500"
    >
      <p>© 2025 CONSTIVAL. Tu socio legal empresarial.</p>
    </div>
  </div>
</footer>
