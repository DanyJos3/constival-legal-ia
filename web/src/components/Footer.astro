---
import { CONSTIVAL_DATA } from "../constants/company";
const { info } = CONSTIVAL_DATA;
// Footer Component
---

<footer
  class="bg-gray-50 dark:bg-[#161b28] border-t border-constival-navy/10 dark:border-constival-mint/10 py-4 transition-colors duration-300"
>
  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 py-10">
      <div class="sm:col-span-2">
        <div class="flex items-center gap-2">
          <img
            src="/isotipo-2.svg"
            alt=""
            width="40"
            height="40"
            class="w-8 md:w-10 mb-5"
            aria-hidden="true"
          />
          <div
            class="text-base font-black text-constival-navy dark:text-constival-mint mb-5 font-sans tracking-widest uppercase"
          >
            CONSTI<span class="text-constival-mint dark:text-white">VAL</span>
          </div>
        </div>
        <p
          class="text-constival-navy/70 dark:text-slate-400 max-w-sm font-sans leading-relaxed text-xs mb-5"
        >
          Liderando la transformación jurídica empresarial con agilidad,
          tecnología y un compromiso inquebrantable con la excelencia.
        </p>
      </div>
      <div>
        <p
          class="font-sans text-constival-navy dark:text-white font-bold uppercase tracking-widest text-xs mb-5"
        >
          Servicios
        </p>
        <ul class="space-y-3 font-sans text-xs">
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/servicios/crear-sas-ecuador">Constitución SAS</a>
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/servicios/registro-marca-ecuador">Registro de Marca</a>
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/servicios/nombramientos-ecuador">Nombramientos</a>
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/servicios/reforma-estatutos-ecuador">Reforma de Estatutos</a>
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/servicios/cesion-acciones-participaciones-ecuador">Cesión de Acciones</a>
          </li>
        </ul>
      </div>
      <div>
        <p
          class="font-sans text-constival-navy dark:text-white font-bold uppercase tracking-widest text-xs mb-5"
        >
          Compañía
        </p>
        <ul class="space-y-3 font-sans text-xs">
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/">Inicio</a>
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/blog">Blog & Recursos</a>
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/contactanos">Contáctanos</a>
          </li>
          <li>
            <a
              class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors"
              href="/#faq">Preguntas Frecuentes</a>
          </li>
        </ul>
      </div>
      <div>
        <p
          class="font-sans text-constival-navy dark:text-white font-bold uppercase tracking-widest text-xs mb-5"
        >
          Contacto
        </p>
        <ul class="space-y-3 font-sans text-xs">
          <li>
            <a href="/contactanos" class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors flex items-center gap-3">
              {info.contact.address}
            </a>
          </li>
          <li>
            <a href={`https://wa.me/593${info.contact.phone.substring(1)}?text=Hola%20Constival,%20necesito%20asesoría`} target="_blank" rel="noopener noreferrer" class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors flex items-center gap-3">
              {info.contact.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${info.contact.email}`} class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors flex items-center gap-3">
              {info.contact.email}
            </a>
          </li>
          <li class="flex items-center gap-4 pt-2">
            <a href={info.contact.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors" aria-label="Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href={info.contact.socials.facebook} target="_blank" rel="noopener noreferrer" class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors" aria-label="Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
            </a>
            <a href={`https://wa.me/593${info.contact.phone.substring(1)}?text=Hola%20Constival,%20necesito%20asesoría`} target="_blank" rel="noopener noreferrer" class="text-constival-navy/70 dark:text-slate-400 hover:text-constival-mint transition-colors" aria-label="WhatsApp">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div
      class="flex flex-col md:flex-row justify-between items-center pt-6 border-t border-constival-navy/10 dark:border-white/5 font-sans text-[10px] text-xs tracking-widest uppercase font-bold text-constival-navy/70 dark:text-slate-500"
    >
      <div
        class="flex flex-col md:flex-row md:justify-between w-full items-center gap-2"
      >
        <p>© 2026 CONSTIVAL. Tu socio legal empresarial.</p>
        <p
          class="text-[9px] sm:text-[10px] text-constival-navy/50 dark:text-slate-600"
        >
          Tarifas y normativas actualizadas y vigentes a Marzo 2026
        </p>
      </div>
    </div>
    </div>
  </div>

  <!-- LocalBusiness Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LegalService",
    "@id": "https://constival.com/#organization",
    "name": CONSTIVAL_DATA.info.name,
    "image": "https://constival.com/isotipo-2.svg",
    "url": "https://constival.com",
    "telephone": CONSTIVAL_DATA.info.contact.phone,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": CONSTIVAL_DATA.info.contact.address,
      "addressLocality": CONSTIVAL_DATA.info.contact.city,
      "addressCountry": CONSTIVAL_DATA.info.contact.country
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -0.180653,
      "longitude": -78.482084
    },
    "sameAs": [
      CONSTIVAL_DATA.info.contact.socials.instagram,
      CONSTIVAL_DATA.info.contact.socials.facebook
    ],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ],
      "opens": "09:00",
      "closes": "18:00"
    }
  })}></script>
</footer>
