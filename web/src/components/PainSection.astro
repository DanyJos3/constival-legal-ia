---

---

<!-- <section class="py-14 md:py-16 bg-white dark:bg-[#0a0f1a] relative overflow-hidden transition-colors duration-300"> -->
<section
  class="py-14 md:py-16 bg-white dark:bg-[#0a0f1a] relative overflow-hidden transition-colors duration-300"
>
  <!-- Subtle grid pattern -->
  <div
    class="absolute inset-0 opacity-[0.02] dark:opacity-[0.04]"
    style="background-image: linear-gradient(rgba(0,255,178,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,178,0.3) 1px, transparent 1px); background-size: 60px 60px;"
  >
  </div>

  <div class="container mx-auto px-6 md:px-12 lg:px-16 max-w-7xl relative z-10">
    <div class="text-center mb-10">
      <span
        class="inline-block py-1 px-3 bg-red-500/10 dark:bg-red-500/20 text-red-600 dark:text-red-400 font-sans font-bold tracking-widest uppercase text-[10px] mb-4 border-l-4 border-red-500"
      >
        Alerta de Riesgo Empresarial
      </span>
      <h2
        class="font-sans text-3xl md:text-4xl lg:text-5xl font-bold text-constival-navy dark:text-white tracking-tight"
      >
        El costo invisible de <span class="text-red-500 dark:text-red-400"
          >la informalidad.</span
        >
      </h2>
      <p
        class="font-sans text-base md:text-lg text-constival-navy/60 dark:text-slate-400 mt-3 max-w-xl mx-auto"
      >
        Operar sin estructura societaria o con estatutos genéricos es construir
        un rascacielos sin cimientos. Estos son los riesgos reales:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
      <!-- Risk 1 -->
      <div
        class="group relative bg-gray-50 dark:bg-constival-deep/50 p-6 border border-constival-navy/5 dark:border-white/5 hover:border-red-500/30 dark:hover:border-red-400/30 transition-all duration-500 overflow-hidden"
      >
        <div
          class="absolute top-0 left-0 h-0.5 w-0 bg-red-500 group-hover:w-full transition-all duration-700"
        >
        </div>
        <div
          class="text-red-500/10 dark:text-red-400/5 font-sans font-black text-6xl absolute -right-1 -top-2 select-none pointer-events-none"
        >
          !
        </div>
        <div class="relative z-10">
          <div class="w-8 h-8 mb-4 text-red-500 dark:text-red-400">
            <svg
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
              ></path></svg
            >
          </div>
          <h3 class="font-sans text-lg md:text-xl font-bold text-constival-navy dark:text-white mb-2">Cuentas Congeladas en <span class="text-red-500">24 horas</span></h3>
          <p class="text-constival-navy/60 dark:text-slate-400 font-sans leading-relaxed text-sm md:text-base">Un nombramiento vencido puede congelar automáticamente todas tus cuentas bancarias corporativas. Sin previo aviso, sin marcha atrás inmediata.</p>
        </div>
      </div>

      <!-- Risk 2 -->
      <div
        class="group relative bg-gray-50 dark:bg-constival-deep/50 p-6 border border-constival-navy/5 dark:border-white/5 hover:border-red-500/30 dark:hover:border-red-400/30 transition-all duration-500 overflow-hidden"
      >
        <div
          class="absolute top-0 left-0 h-0.5 w-0 bg-red-500 group-hover:w-full transition-all duration-700"
        >
        </div>
        <div
          class="text-red-500/10 dark:text-red-400/5 font-sans font-black text-6xl absolute -right-1 -top-2 select-none pointer-events-none"
        >
          !
        </div>
        <div class="relative z-10">
          <div class="w-8 h-8 mb-4 text-red-500 dark:text-red-400">
            <svg
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"
              ></path></svg
            >
          </div>
          <h3 class="font-sans text-lg md:text-xl font-bold text-constival-navy dark:text-white mb-2">Hasta <span class="text-red-500">18 meses</span> de Parálisis</h3>
          <p class="text-constival-navy/60 dark:text-slate-400 font-sans leading-relaxed text-sm md:text-base">Estatutos de plantilla no incluyen cláusulas de resolución de conflictos. Cuando un socio quiere salir, el negocio entero se paraliza por meses o años.</p>
        </div>
      </div>

      <!-- Risk 3 -->
      <div
        class="group relative bg-gray-50 dark:bg-constival-deep/50 p-6 border border-constival-navy/5 dark:border-white/5 hover:border-red-500/30 dark:hover:border-red-400/30 transition-all duration-500 overflow-hidden"
      >
        <div
          class="absolute top-0 left-0 h-0.5 w-0 bg-red-500 group-hover:w-full transition-all duration-700"
        >
        </div>
        <div
          class="text-red-500/10 dark:text-red-400/5 font-sans font-black text-6xl absolute -right-1 -top-2 select-none pointer-events-none"
        >
          !
        </div>
        <div class="relative z-10">
          <div class="w-8 h-8 mb-4 text-red-500 dark:text-red-400">
            <svg
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path></svg
            >
          </div>
          <h3 class="font-sans text-lg md:text-xl font-bold text-constival-navy dark:text-white mb-2">Multas desde <span class="text-red-500">$5,000+</span></h3>
          <p class="text-constival-navy/60 dark:text-slate-400 font-sans leading-relaxed text-sm md:text-base">Incumplir con la Superintendencia genera multas abismales y hasta la disolución forzosa de tu empresa. Sin importar el tamaño.</p>
        </div>
      </div>
    </div>

    <div class="mt-8 text-center">
      <p class="font-serif italic text-base md:text-lg text-constival-teal dark:text-constival-mint/70 mb-5">
        "Prevenir una crisis mediante el diseño legal es exponencialmente más eficiente que reaccionar ante ella."
      </p>
      <!-- TRACKING: pain_cta_riesgo -->
      <a
        href="#auditor-riesgos"
        class="inline-flex items-center gap-2 font-sans font-bold text-sm md:text-base uppercase tracking-wider text-red-600 dark:text-red-400 bg-red-500/10 hover:bg-red-500/20 px-6 py-3 md:py-3.5 rounded-full transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
      >
        ¿Tu empresa está en riesgo? Verificar gratis
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
  </div>
</section>
