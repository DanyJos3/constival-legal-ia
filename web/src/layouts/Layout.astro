---
import { CONSTIVAL_DATA } from "../constants/company";
import PopupManager from "../components/popups/PopupManager.astro";
import "../styles/global.css";
const {
  title = "Constival Legal",
  description = "Arquitectura societaria blindada para escalar tu empresa en Ecuador. Constitución S.A.S., reformas y registro de marcas 100% digital.",
  canonicalUrl,
  ogImage = "https://constival.com/images/og-image.png",
  contact = {},
} = Astro.props;

const canonicalURLStr = canonicalUrl || "https://constival.com/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-TN464R4X");
    </script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:url" content={canonicalURLStr} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Constival Legal" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalURLStr} />

    <!-- JSON-LD: LegalService (Organización global) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LegalService",
        "@id": "https://constival.com/#organization",
        name: "Constival Legal",
        image: "https://constival.com/isotipo-2.svg",
        url: "https://constival.com/",
        telephone: "+593969503502",
        address: {
          "@type": "PostalAddress",
          streetAddress: CONSTIVAL_DATA.info.contact.address,
          addressLocality: CONSTIVAL_DATA.info.contact.city,
          addressCountry: CONSTIVAL_DATA.info.contact.country,
        },
        sameAs: [
          "https://www.instagram.com/constival.ecu",
          "https://constival.com/",
        ],
        description:
          "Firma legal en Ecuador especializada en derecho societario: constitución de S.A.S., disolución de empresas, nombramientos y trámites ante la Superintendencia de Compañías, Valores y Seguros (SUPERCIAS).",
        priceRange: "$$",
        areaServed: { "@type": "Country", name: "Ecuador" },
        knowsAbout: [
          "Constitución de SAS en Ecuador",
          "Disolución de Sociedades en Ecuador",
          "Derecho Societario Ecuatoriano",
          "SUPERCIAS Ecuador",
          "Ley de Compañías Ecuador",
        ],
      })}
    />

    <!-- JSON-LD: WebSite (para SearchAction y reconocimiento de entidad por IA) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://constival.com/#website",
        url: "https://constival.com/",
        name: "Constival Legal",
        description:
          "Especialistas en derecho societario ecuatoriano: constitución de empresas, disoluciones y trámites ante SUPERCIAS.",
        inLanguage: "es-EC",
        publisher: { "@id": "https://constival.com/#organization" },
        potentialAction: {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: "https://constival.com/?q={search_term_string}",
          },
          "query-input": "required name=search_term_string",
        },
      })}
    />

    <!-- Slot para schemas específicos de página -->
    <slot name="head" />

    <!-- Self-hosted font preloads (critical fonts only — reduces LCP) -->
    <link
      rel="preload"
      href="/fonts/outfit/outfit-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/outfit/outfit-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Preload hero background (LCP element) -->
    <link
      rel="preload"
      href="/images/hero-bg.webp"
      as="image"
      type="image/webp"
    />

    <!-- Prevenir flashazo blanco y checkear tema -->
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        // Si no hay preferencia guardada, sugerimos 'dark' por defecto
        // ya que resalta mejor la paleta corporativa y los CTAs.
        // Opcional: descomentar la siguiente línea para seguir el sistema operativo.
        // return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        return "dark";
      };
      const isDark = getThemePreference() === "dark";
      document.documentElement.classList[isDark ? "add" : "remove"]("dark");
    </script>
  </head>
  <body
    class="bg-white text-constival-navy dark:bg-constival-navy dark:text-white transition-colors duration-300 min-h-screen font-sans antialiased"
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TN464R4X"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <slot />
    <PopupManager />

    <script is:inline>
      // Global tracking helper
      window.dataLayer = window.dataLayer || [];
      window.trackEvent = function (eventName, params) {
        window.dataLayer.push({
          event: eventName,
          ...params,
        });
      };

      // Global click tracker for conversions (WhatsApp, Email, Phone)
      document.addEventListener("click", function (e) {
        const target = e.target.closest("a");
        if (target && target.href) {
          if (target.href.includes("wa.me")) {
            window.trackEvent("whatsapp_clicked", {
              link_url: target.href,
              page_path: window.location.pathname,
            });
          } else if (target.href.startsWith("mailto:")) {
            window.trackEvent("email_clicked", {
              link_url: target.href,
              page_path: window.location.pathname,
            });
          } else if (target.href.startsWith("tel:")) {
            window.trackEvent("phone_clicked", {
              link_url: target.href,
              page_path: window.location.pathname,
            });
          }
        }
      });
    </script>
  </body>
</html>
