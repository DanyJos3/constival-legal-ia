---
import { CONSTIVAL_DATA } from "../constants/company";
import "../styles/global.css";
const {
  title = "Constival Legal",
  description = "Arquitectura societaria blindada para escalar tu empresa en Ecuador. Constitución S.A.S., reformas y registro de marcas 100% digital.",
  contact = {},
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:url" content="https://constival.com/" />
    <meta
      property="og:image"
      content="https://constival.com/images/og-image.png"
    />
    <meta property="og:site_name" content="Constival Legal" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://constival.com/images/og-image.png"
    />

    <link rel="canonical" href="https://constival.com/" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LegalService",
      "name": "Constival Legal",
      "image": "https://constival.com/isotipo-2.svg",
      "@id": "https://constival.com/",
      "url": "https://constival.com/",
      "telephone": "+593969503502",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": CONSTIVAL_DATA.info.contact.address,
        "addressLocality": CONSTIVAL_DATA.info.contact.city,
        "addressCountry": CONSTIVAL_DATA.info.contact.country
      },
      "description": "Estructuras societarias blindadas para escalar tu empresa en Ecuador.",
      "priceRange": "$$$"
    })} />

    <!-- Self-hosted font preloads (critical fonts only — reduces LCP) -->
    <link
      rel="preload"
      href="/fonts/outfit/outfit-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/outfit/outfit-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Preload hero background (LCP element) -->
    <link
      rel="preload"
      href="/images/hero-bg.webp"
      as="image"
      type="image/webp"
    />

    <!-- Prevenir flashazo blanco y checkear tema -->
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };
      const isDark = getThemePreference() === "dark";
      document.documentElement.classList[isDark ? "add" : "remove"]("dark");
    </script>
  </head>
  <body
    class="bg-white text-constival-navy dark:bg-constival-navy dark:text-white transition-colors duration-300 min-h-screen font-sans antialiased"
  >
    <slot />
  </body>
</html>
